---
import PlatformIcon from '../PlatformIcon.astro';
import Sparkline from '../ui/Sparkline.astro';
import { TOP_GROWERS } from '../../lib/showcase';
import { fmtCompact } from '../../lib/i18n';
import type { PlatformKey } from '../../lib/platforms';
const lang = Astro.locals.lang; const t = Astro.locals.t; const s = t.home.success;
const signup = `/app/login?source=${lang}-success`;
const growers = TOP_GROWERS.slice(0, 6);
const compact = (n: number) => { if (n >= 1e9) return (n / 1e6).toFixed(1) + 'M'; return fmtCompact(n, lang); };
---
<section id="success-stories" class="lp-section-white">
  <div class="container-x">
    <div class="text-center reveal"><h2 class="section-title">{s.title}</h2><p class="section-subtitle">{s.subtitle}</p></div>
    <div class="mt-10 grid md:grid-cols-2 lg:grid-cols-3 gap-5">
      {growers.map((g, i) => (
        <article class="card p-5 reveal" style={`transition-delay:${i * 60}ms`}>
          <div class="flex items-center justify-between">
            <span class="text-[11px] font-semibold uppercase tracking-wider text-slate-500">{g.anonymous_name}</span>
            <span class="flex items-center gap-1.5 text-slate-400">{g.platforms.slice(0, 5).map((pk) => <PlatformIcon platform={pk as PlatformKey} colored={false} size="text-[11px]" />)}</span>
          </div>
          <div class="mt-3 flex items-baseline gap-2"><span class="text-3xl font-extrabold text-brand-500 dark:text-brand-400">+{compact(g.followers_gained)}</span><span class="text-sm text-slate-500">{s.followers}</span></div>
          <div class="text-xs text-emerald-500 font-medium"><i class="fa-solid fa-arrow-trend-up mr-1"></i>{g.growth_pct.toLocaleString(lang)}% {s.inDays.replace('{n}', String(g.days))}</div>
          <div class="mt-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900 p-2"><Sparkline values={g.sparkline.map((x) => x.followers)} /></div>
          <div class="mt-4 grid grid-cols-3 gap-2 text-center">
            {[{ v: g.total_likes, l: s.likes }, { v: g.total_shares, l: s.shares }, { v: g.total_reach, l: s.reach }].map((m) => <div class="rounded-lg bg-slate-100 dark:bg-slate-800 py-2"><div class="text-sm font-bold text-slate-900 dark:text-white">{compact(m.v)}</div><div class="text-[10px] text-slate-500">{m.l}</div></div>)}
          </div>
        </article>))}
    </div>
    <div class="mt-10 text-center"><a href={signup} class="btn-primary">{s.cta}</a><p class="mt-4 text-[11px] italic text-slate-400"><i class="fa-solid fa-lock mr-1"></i>{s.note}</p></div>
  </div>
</section>
