---
const lang = Astro.locals.lang; const t = Astro.locals.t; const s = t.home.oldWay;
const signup = `/app/login?source=${lang}-old-way`;
const colors = ['bg-rose-500/10 text-rose-500', 'bg-amber-500/10 text-amber-500', 'bg-sky-500/10 text-sky-500', 'bg-fuchsia-500/10 text-fuchsia-500'];
---
<section class="lp-section-gray">
  <div class="container-x grid lg:grid-cols-[0.9fr_1.1fr] gap-12 items-start">
    <div class="reveal">
      <span class="eyebrow"><i class="fa-solid fa-clock-rotate-left"></i>{s.eyebrow}</span>
      <h2 class="section-title mt-4">{s.title}</h2>
      <p class="mt-4 text-lg text-slate-500 dark:text-slate-400">{s.subtitle}</p>
      <p class="mt-10 text-xl font-semibold text-slate-900 dark:text-white">{s.punch}</p>
      <a href={signup} class="btn-primary mt-5">{s.cta}<i class="fa-solid fa-arrow-right text-xs"></i></a>
      <p class="mt-3 text-xs text-slate-500">{s.note}</p>
    </div>
    <div class="grid sm:grid-cols-2 gap-5">
      {s.pains.map((p, i) => (
        <div class="card p-6 reveal" style={`transition-delay:${i * 80}ms`}>
          <span class={`inline-flex h-10 w-10 items-center justify-center rounded-xl ${colors[i]}`}><i class={`fa-solid ${p.icon}`}></i></span>
          <h3 class="mt-4 font-semibold text-slate-900 dark:text-white">{p.t}</h3>
          <p class="mt-2 text-sm text-slate-500 dark:text-slate-400 leading-relaxed">{p.d}</p>
        </div>))}
    </div>
  </div>
</section>
