---
import PlatformIcon from '../PlatformIcon.astro';
import { HOME_PLATFORMS, PLATFORM_MAP } from '../../lib/platforms';
import { localePath } from '../../lib/i18n';
const lang = Astro.locals.lang; const t = Astro.locals.t; const s = t.home.platforms;
const L = (p: string) => localePath(lang, p);
const txt = (lang === 'fr' ? 'fr' : 'en') as 'fr' | 'en';
---
<section id="platforms" class="lp-section-white">
  <div class="container-x">
    <div class="text-center reveal"><h2 class="section-title">{s.title}</h2><p class="section-subtitle">{s.subtitle}</p></div>
    <div class="mt-10 grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {HOME_PLATFORMS.map((k, i) => { const p = PLATFORM_MAP[k]; return (
        <article class="card card-hover p-6 flex flex-col reveal" style={`transition-delay:${(i % 3) * 60}ms`}>
          <div class="flex items-center gap-3"><span class="inline-flex h-10 w-10 items-center justify-center rounded-xl bg-slate-100 dark:bg-slate-800"><PlatformIcon platform={k} size="text-lg" /></span><h3 class="font-semibold text-slate-900 dark:text-white">{p.name}</h3></div>
          <p class="mt-3 text-sm text-slate-500 dark:text-slate-400 leading-relaxed flex-1">{p.home.desc[txt]}</p>
          <div class="mt-4 flex flex-wrap gap-1.5">{p.home.tags[txt].map((tag) => <span class="chip">{tag}</span>)}</div>
          <a href={L(`/platforms/${p.slug}/`)} class="mt-4 text-sm font-semibold text-brand-600 dark:text-brand-400 hover:underline">{s.explore.replace('{name}', p.name)} <i class="fa-solid fa-arrow-right text-xs"></i></a>
        </article>); })}
    </div>
    <div class="mt-8 card p-8 text-center bg-gradient-to-r from-brand-50 to-violet-50 dark:from-brand-500/10 dark:to-violet-500/10 reveal">
      <h3 class="text-xl font-bold text-slate-900 dark:text-white"><span class="icon-box !h-8 !w-8 text-sm mr-2 align-middle"><i class="fa-solid fa-question"></i></span>{s.otherTitle}</h3>
      <p class="mt-3 text-slate-500 dark:text-slate-400">{s.otherBody} <a href="mailto:info@upload-post.com" class="font-semibold text-brand-600 dark:text-brand-400 hover:underline">info@upload-post.com</a>.</p>
    </div>
  </div>
</section>
