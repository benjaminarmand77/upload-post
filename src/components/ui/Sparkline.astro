---
interface Props { values: number[]; class?: string; height?: number; stroke?: string }
const { values, class: cls = 'w-full h-14', height = 56, stroke = '#6366f1' } = Astro.props;
const w = 200, h = height, pad = 4;
const min = Math.min(...values), max = Math.max(...values);
const range = max - min || 1;
const pts = values.map((v, i) => [pad + (i / Math.max(1, values.length - 1)) * (w - pad * 2), h - pad - ((v - min) / range) * (h - pad * 2)] as const);
const d = pts.map(([x, y], i) => `${i ? 'L' : 'M'}${x.toFixed(1)},${y.toFixed(1)}`).join(' ');
const area = `${d} L${pts[pts.length - 1][0].toFixed(1)},${h} L${pts[0][0].toFixed(1)},${h} Z`;
const id = 'sg' + Math.random().toString(36).slice(2, 8);
---
<svg viewBox={`0 0 ${w} ${h}`} class={cls} preserveAspectRatio="none" aria-hidden="true">
  <defs><linearGradient id={id} x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color={stroke} stop-opacity=".35"/><stop offset="1" stop-color={stroke} stop-opacity="0"/></linearGradient></defs>
  <path d={area} fill={`url(#${id})`} />
  <path d={d} fill="none" stroke={stroke} stroke-width="2" stroke-linejoin="round" stroke-linecap="round" vector-effect="non-scaling-stroke" />
</svg>
