---
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import { TAGS } from '../lib/content/api-registry';
interface Props { title: string; description?: string; active?: string }
const { title, description = 'Upload-Post API documentation', active = '' } = Astro.props;
const theme = Astro.locals.theme;
const nav = [
  { label: 'Getting started', items: [['Introduction', '/docs/'], ['Quickstart', '/docs/quickstart'], ['SDK examples', '/docs/sdk-examples'], ['API reference', '/docs/api/reference']] },
  { label: 'Reference', items: TAGS.map((t) => [t, `/docs/api/reference#${t.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`] as [string, string]) },
  { label: 'Guides', items: [['Authentication & profiles', '/docs/guides/authentication'], ['Scheduling & queue', '/docs/guides/scheduling'], ['Async uploads & status', '/docs/guides/async-uploads'], ['Whitelabel connect page', '/docs/guides/whitelabel'], ['Webhooks', '/docs/guides/webhooks'], ['Errors & limits', '/docs/guides/errors'], ['MCP server', '/docs/guides/mcp'], ['Self-hosting & platform apps', '/docs/guides/self-hosting']] },
  { label: 'Machine-readable', items: [['openapi.json', '/openapi.json'], ['llm.txt', '/llm.txt']] },
];
---
<!doctype html>
<html lang="en" class={theme === 'dark' ? 'dark' : ''}>
<head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>{title} | Upload Post Docs</title><meta name="description" content={description} /><link rel="icon" href="/favicon.svg" type="image/svg+xml" /><link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Fira+Code:wght@400;500&display=swap" rel="stylesheet" /><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" /><script is:inline>(function(){try{var s=localStorage.getItem('theme');var c=(document.cookie.match(/(?:^|; )theme=(light|dark)/)||[])[1];var t=s||c||'dark';document.documentElement.classList.toggle('dark',t==='dark');}catch(e){}})();</script></head>
<body class="bg-white dark:bg-slate-950">
  <header class="sticky top-0 z-40 h-16 border-b border-slate-200 dark:border-slate-800 bg-white/80 dark:bg-slate-950/80 backdrop-blur"><div class="mx-auto max-w-7xl h-full px-4 sm:px-6 flex items-center gap-4"><a href="/docs/" class="flex items-center gap-2 font-bold text-slate-900 dark:text-white"><Logo size={30} />Upload-Post <span class="text-slate-400 font-normal">Docs</span></a><nav class="hidden md:flex items-center gap-1 ml-6 text-sm">{[['Documentation', '/docs/'], ['API Reference', '/docs/api/reference'], ['App', '/app/'], ['OpenAPI', '/openapi.json'], ['llm.txt', '/llm.txt'], ['GitHub', 'https://github.com/upload-post']].map(([l, h]) => <a href={h} class="rounded-lg px-3 py-2 text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800">{l}</a>)}</nav><div class="ml-auto flex items-center gap-2"><button type="button" id="theme-toggle" class="h-9 w-9 inline-flex items-center justify-center rounded-lg border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300"><span class="dark:hidden"><i class="fa-solid fa-moon"></i></span><span class="hidden dark:inline"><i class="fa-solid fa-sun"></i></span></button><a href="/app/login?source=docs" class="btn-primary btn-sm">Start for free</a></div></div></header>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 grid lg:grid-cols-[240px_1fr] gap-8">
    <aside class="hidden lg:block py-8 sticky top-16 self-start max-h-[calc(100vh-4rem)] overflow-y-auto text-sm">{nav.map((g) => <div class="mb-6"><div class="px-2 mb-1.5 text-[11px] font-semibold uppercase tracking-wider text-slate-400">{g.label}</div>{g.items.map(([l, h]) => <a href={h} class={`block rounded-lg px-2 py-1.5 ${active === h ? 'bg-brand-50 dark:bg-brand-500/15 text-brand-700 dark:text-brand-300 font-medium' : 'text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white'}`}>{l}</a>)}</div>)}</aside>
    <main class="py-8 min-w-0"><slot /></main>
  </div>
  <footer class="border-t border-slate-200 dark:border-slate-800 py-8 text-center text-xs text-slate-500">© 2026 Upload-Post · <a href="/data-and-privacy-policy/" class="hover:text-brand-500">Privacy</a> · <a href="/terms-of-use/" class="hover:text-brand-500">Terms</a> · <a href="/status/" class="hover:text-brand-500">Status</a></footer>
  <script>
    document.getElementById('theme-toggle')?.addEventListener('click', () => { const d = !document.documentElement.classList.contains('dark'); document.documentElement.classList.toggle('dark', d); try { localStorage.setItem('theme', d ? 'dark' : 'light'); } catch {} document.cookie = `theme=${d ? 'dark' : 'light'}; path=/; max-age=31536000; SameSite=Lax`; });
    document.addEventListener('click', async (ev) => { const btn = (ev.target as HTMLElement).closest<HTMLElement>('[data-copy]'); if (!btn) return; const sel = btn.getAttribute('data-copy')!; const src = sel.startsWith('#') ? document.querySelector(sel)?.textContent ?? '' : sel; try { await navigator.clipboard.writeText(src.trim()); } catch {} const prev = btn.innerHTML; btn.innerHTML = '<i class="fa-solid fa-check"></i>'; setTimeout(() => (btn.innerHTML = prev), 1200); });
  </script>
</body></html>
