---
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import { getAppDict } from '../i18n/app';
import { localePath } from '../lib/i18n';
import { limitsOf, usageOf } from '../server/plans';

interface Props { title: string; subtitle?: string; active: string; wide?: boolean }
const { title, subtitle, active, wide = false } = Astro.props;
const user = Astro.locals.user;
if (!user) return Astro.redirect('/app/login?redirect=' + encodeURIComponent(Astro.url.pathname + Astro.url.search), 303);
const lang = Astro.locals.lang; const a = getAppDict(lang); const theme = Astro.locals.theme;
const limits = limitsOf(user); const usage = usageOf(user.id);
const groups = [
  { label: a.nav.publish, items: [ ['overview', a.nav.overview, 'fa-gauge-high', '/app/'], ['upload', a.nav.upload, 'fa-cloud-arrow-up', '/app/upload'], ['calendar', a.nav.calendar, 'fa-calendar-days', '/app/calendar'], ['history', a.nav.history, 'fa-clock-rotate-left', '/app/history'] ] },
  { label: a.nav.accounts, items: [ ['profiles', a.nav.profiles, 'fa-users', '/app/manage-users'], ['api-keys', a.nav.apiKeys, 'fa-key', '/app/api-keys'], ['whitelabel', a.nav.whitelabel, 'fa-layer-group', '/app/whitelabel'] ] },
  { label: a.nav.insights, items: [ ['analytics', a.nav.analytics, 'fa-chart-line', '/app/analytics'], ['inbox', a.nav.inbox, 'fa-comments', '/app/inbox'] ] },
  { label: a.nav.tools, items: [ ['ffmpeg', a.nav.ffmpeg, 'fa-film', '/app/ffmpeg'], ['ai-shorts', a.nav.aiShorts, 'fa-wand-magic-sparkles', '/app/ai-shorts'] ] },
  { label: a.nav.account, items: [ ['notifications', a.nav.notifications, 'fa-bell', '/app/notifications'], ['team', a.nav.team, 'fa-user-group', '/app/team'], ['billing', a.nav.billing, 'fa-credit-card', '/app/billing'], ['settings', a.nav.settings, 'fa-gear', '/app/settings'] ] },
];
const initials = (user.name || user.email).slice(0, 2).toUpperCase();
const uploadsPct = limits.uploads ? Math.min(100, Math.round((usage.uploads / limits.uploads) * 100)) : 0;
---
<!doctype html>
<html lang={lang} class={theme === 'dark' ? 'dark' : ''}>
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title} · Upload-Post</title>
  <meta name="robots" content="noindex" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Fira+Code:wght@400;500&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
  <script is:inline>(function(){try{var s=localStorage.getItem('theme');var c=(document.cookie.match(/(?:^|; )theme=(light|dark)/)||[])[1];var t=s||c||'dark';document.documentElement.classList.toggle('dark',t==='dark');}catch(e){}})();</script>
  <slot name="head" />
</head>
<body class="bg-slate-50 dark:bg-slate-950 text-slate-700 dark:text-slate-300">
  <div class="flex min-h-screen">
    <!-- Sidebar -->
    <aside id="app-sidebar" class="fixed inset-y-0 left-0 z-40 w-64 -translate-x-full lg:translate-x-0 transition-transform duration-200 border-r border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 flex flex-col">
      <div class="h-16 flex items-center justify-between px-5 border-b border-slate-200 dark:border-slate-800">
        <a href="/app/" class="flex items-center gap-2 font-bold text-slate-900 dark:text-white"><Logo size={30} />Upload-Post</a>
        <button type="button" class="lg:hidden h-9 w-9 inline-flex items-center justify-center rounded-lg text-slate-500" data-sidebar-close aria-label="Close"><i class="fa-solid fa-xmark"></i></button>
      </div>
      <nav class="flex-1 overflow-y-auto px-3 py-4 space-y-5">
        {groups.map((g) => (
          <div>
            <div class="px-3 pb-1.5 text-[10px] font-semibold uppercase tracking-wider text-slate-400">{g.label}</div>
            {g.items.map(([key, label, icon, href]) => (
              <a href={href} class={`flex items-center gap-3 rounded-lg px-3 py-2 text-[13.5px] font-medium transition ${active === key ? 'bg-brand-50 dark:bg-brand-500/15 text-brand-700 dark:text-brand-300' : 'text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 hover:text-slate-900 dark:hover:text-white'}`} aria-current={active === key ? 'page' : undefined}>
                <i class={`fa-solid ${icon} w-4 text-center ${active === key ? 'text-brand-600 dark:text-brand-300' : 'text-slate-400'}`}></i>{label}
              </a>))}
          </div>))}
        <div>
          <div class="px-3 pb-1.5 text-[10px] font-semibold uppercase tracking-wider text-slate-400">{a.nav.docs}</div>
          <a href={localePath(lang, '/docs/')} target="_blank" class="flex items-center gap-3 rounded-lg px-3 py-2 text-[13.5px] font-medium text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800"><i class="fa-solid fa-book w-4 text-center text-slate-400"></i>{a.nav.docs}<i class="fa-solid fa-arrow-up-right-from-square ml-auto text-[10px] text-slate-400"></i></a>
          <a href={localePath(lang, '/status/')} target="_blank" class="flex items-center gap-3 rounded-lg px-3 py-2 text-[13.5px] font-medium text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800"><i class="fa-solid fa-signal w-4 text-center text-slate-400"></i>{a.nav.status}<span class="ml-auto h-2 w-2 rounded-full bg-emerald-500"></span></a>
        </div>
      </nav>
      <div class="border-t border-slate-200 dark:border-slate-800 p-4">
        <div class="rounded-xl bg-slate-100 dark:bg-slate-800/70 p-3 text-xs">
          <div class="flex items-center justify-between"><span class="font-semibold text-slate-700 dark:text-slate-200 capitalize">{user.plan}</span><a href="/app/billing" class="text-brand-600 dark:text-brand-400 font-semibold">{a.common.upgrade}</a></div>
          <div class="mt-2 h-1.5 rounded-full bg-slate-200 dark:bg-slate-700 overflow-hidden"><div class="h-full bg-brand-500 rounded-full" style={`width:${limits.uploads ? uploadsPct : 8}%`}></div></div>
          <div class="mt-1.5 text-slate-500">{usage.uploads} / {limits.uploads ?? '∞'} {a.billing.uploads.toLowerCase()}</div>
        </div>
        <div class="mt-3 flex items-center gap-3">
          {user.avatar_url ? <img src={user.avatar_url} alt="" class="h-9 w-9 rounded-full" /> : <span class="inline-flex h-9 w-9 items-center justify-center rounded-full bg-brand-600 text-white text-xs font-bold">{initials}</span>}
          <div class="min-w-0 flex-1"><div class="text-[13px] font-semibold text-slate-900 dark:text-white truncate">{user.name || user.email}</div><div class="text-[11px] text-slate-500 truncate">{user.email}</div></div>
          <form method="post" action="/app/auth/logout"><button type="submit" class="h-8 w-8 inline-flex items-center justify-center rounded-lg text-slate-400 hover:text-rose-500" title={a.nav.logout} aria-label={a.nav.logout}><i class="fa-solid fa-right-from-bracket"></i></button></form>
        </div>
      </div>
    </aside>
    <div id="sidebar-backdrop" class="fixed inset-0 z-30 hidden bg-slate-900/40 backdrop-blur-sm lg:hidden"></div>

    <!-- Main -->
    <div class="flex-1 lg:pl-64 flex flex-col min-w-0">
      <header class="sticky top-0 z-20 h-16 flex items-center gap-3 border-b border-slate-200 dark:border-slate-800 bg-white/80 dark:bg-slate-950/80 backdrop-blur px-4 sm:px-6">
        <button type="button" class="lg:hidden h-9 w-9 inline-flex items-center justify-center rounded-lg border border-slate-200 dark:border-slate-700" data-sidebar-open aria-label="Menu"><i class="fa-solid fa-bars"></i></button>
        <div class="min-w-0"><h1 class="text-base sm:text-lg font-bold text-slate-900 dark:text-white truncate">{title}</h1>{subtitle && <p class="text-xs text-slate-500 truncate hidden sm:block">{subtitle}</p>}</div>
        <div class="ml-auto flex items-center gap-2">
          <slot name="actions" />
          <button type="button" id="theme-toggle" class="h-9 w-9 inline-flex items-center justify-center rounded-lg border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300" aria-label="Theme"><span class="dark:hidden"><i class="fa-solid fa-moon"></i></span><span class="hidden dark:inline"><i class="fa-solid fa-sun"></i></span></button>
          <a href={localePath(lang, '/')} class="hidden sm:inline-flex h-9 items-center gap-2 rounded-lg border border-slate-200 dark:border-slate-700 px-3 text-xs font-medium text-slate-600 dark:text-slate-300"><i class="fa-solid fa-arrow-left"></i>{a.nav.backToSite}</a>
        </div>
      </header>
      <main class={`flex-1 px-4 sm:px-6 py-6 ${wide ? '' : 'max-w-6xl'} w-full`}>
        <slot />
      </main>
    </div>
  </div>
  <div id="toast" class="fixed bottom-5 right-5 z-[90] hidden rounded-xl bg-slate-900 text-white dark:bg-white dark:text-slate-900 px-4 py-3 text-sm shadow-elevated"></div>
  <script>
    const sb = document.getElementById('app-sidebar')!, bd = document.getElementById('sidebar-backdrop')!;
    const open = (o: boolean) => { sb.classList.toggle('-translate-x-full', !o); bd.classList.toggle('hidden', !o); };
    document.querySelectorAll('[data-sidebar-open]').forEach((b) => b.addEventListener('click', () => open(true)));
    document.querySelectorAll('[data-sidebar-close]').forEach((b) => b.addEventListener('click', () => open(false)));
    bd.addEventListener('click', () => open(false));
    document.getElementById('theme-toggle')?.addEventListener('click', () => { const d = !document.documentElement.classList.contains('dark'); document.documentElement.classList.toggle('dark', d); try { localStorage.setItem('theme', d ? 'dark' : 'light'); } catch {} document.cookie = `theme=${d ? 'dark' : 'light'}; path=/; max-age=31536000; SameSite=Lax`; });
    (window as any).toast = (msg: string, kind: 'ok' | 'err' = 'ok') => { const t = document.getElementById('toast')!; t.textContent = msg; t.classList.remove('hidden'); t.style.borderLeft = `4px solid ${kind === 'ok' ? '#10b981' : '#f43f5e'}`; clearTimeout((t as any)._h); (t as any)._h = setTimeout(() => t.classList.add('hidden'), 3500); };
    (window as any).api = async (path: string, opts: RequestInit = {}) => { const r = await fetch(path, { credentials: 'same-origin', ...opts, headers: { ...(opts.body && !(opts.body instanceof FormData) ? { 'content-type': 'application/json' } : {}), ...(opts.headers || {}) } }); let d: any = null; try { d = await r.json(); } catch {} if (!r.ok) throw Object.assign(new Error(d?.message || d?.error || `HTTP ${r.status}`), { data: d, status: r.status }); return d; };
    document.addEventListener('click', async (ev) => { const btn = (ev.target as HTMLElement).closest<HTMLElement>('[data-copy]'); if (!btn) return; const sel = btn.getAttribute('data-copy')!; const src = sel.startsWith('#') ? document.querySelector(sel)?.textContent ?? '' : sel; try { await navigator.clipboard.writeText(src.trim()); (window as any).toast(btn.dataset.copied || 'Copied'); } catch {} });
  </script>
</body>
</html>
