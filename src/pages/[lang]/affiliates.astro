---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/marketing/PageHero.astro';
import FaqList from '../../components/marketing/FaqList.astro';
import Cta from '../../components/marketing/Cta.astro';
import { TUTORIALS } from '../../lib/showcase';
import { isLang, localePath } from '../../lib/i18n';
if (!isLang(Astro.params.lang!)) return new Response(null, { status: 404 });
const lang = Astro.locals.lang; const fr = lang === 'fr'; const L = (p: string) => localePath(lang, p);
const s = fr ? { title: 'Devenez un affilié Upload-Post !', sub: 'Gagnez 50 % de commission récurrente sur chaque client que vous parrainez. Un revenu passif, mois après mois, tant que vos filleuls restent abonnés !', cta: 'Inscrivez-vous et commencez à gagner', dash: 'Accédez à votre tableau de bord pour voir les conversions, les clics, et plus encore.', what: 'Qu\'est-ce qu\'Upload-Post ?', whatBody: 'Upload-Post est une API puissante pour publier du contenu sur les réseaux sociaux. En un seul appel API, les utilisateurs publient vidéos, images et textes sur TikTok, Instagram, YouTube, Facebook, LinkedIn, X (Twitter), Threads, Pinterest et 14 autres plateformes.', whatBody2: 'Nous sommes profondément intégrés aux plateformes d\'automatisation comme n8n et Make.com, ce qui en fait la solution idéale pour les développeurs, agences et entreprises qui automatisent leurs réseaux sociaux.', ideas: 'Besoin d\'idées de contenu ?', ideasBody: 'Nous avons une immense bibliothèque de workflows n8n que vous pouvez utiliser pour créer des tutoriels, adapter pour vos clients ou présenter comme cas d\'usage. Une mine d\'or pour créer du contenu qui convertit !', browse: 'Parcourir les modèles n8n', promise: 'Notre promesse d\'affiliation', promiseBody: 'Nous partageons l\'abonnement de chaque utilisateur que vous amenez 50/50 à vie, tant que l\'utilisateur reste abonné.', recurring: 'Commission récurrente à jamais', see: 'Voyez ce que les autres créent', seeBody: 'Découvrez ces tutoriels pour vous inspirer sur ce que vous pouvez promouvoir.', more: 'Voir plus de tutoriels', calc: 'Calculateur de gains', calcBody: 'Voyez combien vous pourriez gagner ! Ajustez les curseurs pour calculer votre revenu annuel potentiel.', configure: 'Configurez vos parrainages', users: 'utilisateurs', yourCommission: 'Votre commission', potential: 'Vos gains potentiels', total: 'Total parrainages', monthly: 'Revenu mensuel', yearly: 'Revenu annuel', breakdown: 'Répartition par plan', remember: 'Rappelez-vous : c\'est un revenu récurrent à vie !', start: 'Commencez à gagner dès aujourd\'hui !', benefits: 'Les avantages de notre programme', benefitsBody: 'Découvrez pourquoi rejoindre notre programme d\'affiliation est une excellente opportunité.', b: [['💰', 'Commissions attractives', 'Recevez 50 % des revenus de chaque abonnement généré, mois après mois. Une source constante et croissante de revenus passifs.', 'Taux de conversion élevés'], ['👥', 'Paiements à temps', 'Recevez vos commissions en toute sécurité et à temps. Nous veillons à ce que vos efforts soient récompensés rapidement.', 'Système de suivi transparent'], ['📈', 'Support dédié', 'Nous vous fournissons des supports marketing et un soutien pour vous aider à maximiser vos gains.', 'Support personnalisé']], how: 'Comment ça marche ?', howBody: 'Commencer est très simple. Suivez ces étapes faciles.', steps: [['Inscrivez-vous', 'Remplissez le formulaire d\'inscription sur notre plateforme d\'affiliation. C\'est rapide et facile.'], ['Partagez votre lien', 'Vous recevrez un lien d\'affiliation unique. Partagez-le sur votre site web, blog, réseaux sociaux ou avec vos contacts.'], ['Gagnez des commissions', 'Pour chaque client qui s\'abonne via votre lien, vous gagnez une commission récurrente de 50 %. C\'est aussi simple que ça !']], ready: 'Prêt à commencer à gagner ?', readyBody: 'N\'attendez plus. Rejoignez notre programme d\'affiliation aujourd\'hui et générez un revenu passif en faisant la promotion d\'un outil que vos abonnés vont adorer.', want: 'Je veux devenir affilié !', faq: [{ q: 'Combien coûte l\'adhésion au programme d\'affiliation ?', a: 'Absolument rien. Rejoindre notre programme d\'affiliation est complètement gratuit.' }, { q: 'Comment mes références sont-elles suivies ?', a: 'Nous utilisons un système de suivi avancé. Lorsque quelqu\'un clique sur votre lien d\'affiliation unique, un cookie est stocké dans son navigateur pour suivre la référence. Vous pouvez voir tous vos clics, inscriptions et commissions dans votre tableau de bord.' }, { q: 'Quand et comment les commissions sont-elles payées ?', a: 'Les paiements sont effectués entre le 1er et le 5 de chaque mois par les méthodes de paiement configurées dans votre compte. Il n\'y a aucun montant minimum requis pour recevoir votre paiement.' }, { q: 'Y a-t-il une limite à combien je peux gagner ?', a: 'Il n\'y a pas de limites ! Plus vous référez de clients, plus vous gagnez. Vos revenus sont directement proportionnels à vos efforts et à l\'efficacité de vos promotions.' }] }
 : { title: 'Become an Upload-Post affiliate!', sub: 'Earn a 50% recurring commission for every customer you refer. Passive income month after month as long as your referrals stay subscribed!', cta: 'Sign up now and start earning!', dash: 'Access your dashboard to see conversions, clicks, and more.', what: 'What is Upload-Post?', whatBody: 'Upload-Post is a powerful API for uploading content to social media platforms. With a single API call, users can post videos, images, and text to TikTok, Instagram, YouTube, Facebook, LinkedIn, X (Twitter), Threads, Pinterest and 14 more platforms.', whatBody2: 'We\'re heavily integrated with automation platforms like n8n and Make.com, making it the perfect solution for developers, agencies, and businesses automating their social media workflows.', ideas: 'Need content ideas?', ideasBody: 'We have a massive library of n8n workflows that you can use to create tutorials, modify for clients, or showcase as powerful use cases. It\'s a goldmine for creating content that converts!', browse: 'Browse n8n templates', promise: 'Our affiliate promise', promiseBody: 'We split the subscription fee of each user you bring 50/50 for life, as long as the user remains subscribed.', recurring: 'Recurring commission forever', see: 'See what others are creating', seeBody: 'Check out these tutorials for inspiration on what you can promote.', more: 'Watch more tutorials', calc: 'Earnings calculator', calcBody: 'See how much you could earn! Adjust the sliders to calculate your potential annual income.', configure: 'Configure your referrals', users: 'users', yourCommission: 'Your commission', potential: 'Your potential earnings', total: 'Total referrals', monthly: 'Monthly income', yearly: 'Yearly income', breakdown: 'Breakdown by plan', remember: 'Remember: this is recurring income for life!', start: 'Start earning today!', benefits: 'Benefits of our program', benefitsBody: 'Discover why joining our affiliate program is a great opportunity.', b: [['💰', 'Attractive commissions', 'Receive 50% of the revenue of every subscription generated, month after month. A constant and growing source of passive income.', 'High conversion rates'], ['👥', 'On-time payments', 'Receive your commissions securely and on time. We make sure your efforts are rewarded quickly.', 'Transparent tracking system'], ['📈', 'Dedicated support', 'We provide marketing materials and support to help you maximize your earnings. We are here to help you succeed!', 'Personalized support']], how: 'How does it work?', howBody: 'Getting started is very simple. Follow these easy steps.', steps: [['Sign up', 'Fill out the registration form on our affiliate platform. It\'s quick and easy.'], ['Share your link', 'You will receive a unique affiliate link. Share it on your website, blog, social media or with your contacts.'], ['Earn commissions', 'For every customer who subscribes through your link, you earn a 50% recurring commission. It\'s that simple!']], ready: 'Ready to start earning?', readyBody: 'Don\'t wait any longer. Join our affiliate program today and start generating passive income by promoting a tool your followers will love.', want: 'I want to be an affiliate!', faq: [{ q: 'How much does it cost to join the affiliate program?', a: 'Absolutely nothing. Joining our affiliate program is completely free.' }, { q: 'How are my referrals tracked?', a: 'We use an advanced tracking system. When someone clicks your unique affiliate link, a cookie is stored in their browser to track the referral. You can see all your clicks, sign-ups and commissions in your dashboard.' }, { q: 'When and how are commissions paid?', a: 'Payments are made between the 1st and the 5th of each month via the payment methods configured in your account. There is no minimum amount required to receive your payment.' }, { q: 'Is there a limit to how much I can earn?', a: 'There are no limits! The more customers you refer, the more you earn. Your income is directly proportional to your efforts and the effectiveness of your promotions.' }] };
const plans = [['Basic', 24, 5], ['Professional', 50, 3], ['Advanced', 147, 1], ['Business', 438, 0]];
const affiliateUrl = `/app/login?source=${lang}-affiliates&plan=affiliate`;
---
<BaseLayout title={`${s.title} | Upload-Post`} description={s.sub}>
  <PageHero center title={s.title} subtitle={s.sub} cta={{ label: s.cta, href: affiliateUrl, icon: 'fa-rocket' }} note={s.dash} />
  <section class="lp-section-gray"><div class="container-x grid lg:grid-cols-2 gap-8 items-start">
    <div class="card p-8"><h2 class="text-2xl font-bold text-slate-900 dark:text-white">{s.what}</h2><p class="mt-4 text-slate-500 dark:text-slate-400">{s.whatBody}</p><p class="mt-3 text-slate-500 dark:text-slate-400">{s.whatBody2}</p><div class="mt-6 rounded-xl bg-brand-50 dark:bg-brand-500/10 p-5"><h4 class="font-semibold text-slate-900 dark:text-white">{s.ideas}</h4><p class="mt-2 text-sm text-slate-500 dark:text-slate-400">{s.ideasBody}</p><a href={L('/n8n-templates/')} class="btn-primary btn-sm mt-3">{s.browse}</a></div><div class="mt-5 flex flex-wrap gap-2">{['n8n', 'Make.com', 'Airtable'].map((x) => <span class="chip">{x}</span>)}</div></div>
    <div class="space-y-6"><div class="card p-8 text-center"><div class="text-4xl">🤝</div><h3 class="mt-3 text-xl font-bold text-slate-900 dark:text-white">{s.promise}</h3><p class="mt-2 text-slate-500 dark:text-slate-400">{s.promiseBody}</p><div class="mt-5 text-6xl font-extrabold text-brand-600">50%</div><div class="text-sm text-slate-500">{s.recurring}</div></div>
      <div class="card p-6"><h3 class="font-bold text-slate-900 dark:text-white">{s.see}</h3><p class="text-sm text-slate-500 mt-1">{s.seeBody}</p><div class="mt-4 grid grid-cols-3 gap-2">{TUTORIALS.slice(0, 3).map((v) => <a href={`https://www.youtube.com/watch?v=${v.id}`} target="_blank" rel="noopener" class="group"><img src={`https://i.ytimg.com/vi/${v.id}/hqdefault.jpg`} alt={v.title} class="aspect-video w-full rounded-lg object-cover" loading="lazy" /><div class="mt-1 text-[11px] font-medium line-clamp-2 group-hover:text-brand-600">{v.title}</div></a>)}</div><a href={L('/youtube-tutorials/')} class="btn-secondary btn-sm mt-4">{s.more}</a></div></div>
  </div></section>
  <section class="lp-section-white"><div class="container-x max-w-5xl"><div class="text-center reveal"><h2 class="section-title">{s.calc}</h2><p class="section-subtitle">{s.calcBody}</p></div>
    <div class="mt-10 grid lg:grid-cols-2 gap-6" id="calc">
      <div class="card p-6"><h3 class="font-semibold text-slate-900 dark:text-white mb-4">{s.configure}</h3>{plans.map(([n, price, def]) => <div class="mb-4"><div class="flex justify-between text-sm"><span class="font-medium text-slate-700 dark:text-slate-200">{n} ($" + "{price}/mo)</span><span><b data-count={n}>{def}</b> {s.users}</span></div><input type="range" min="0" max="50" value={def} data-plan={n} data-price={price} class="w-full accent-brand-600" /><div class="text-xs text-brand-600">{s.yourCommission}: <b data-comm={n}>${Number(price) * 0.5 * Number(def)}</b>/mo</div></div>)}</div>
      <div class="card p-6 bg-gradient-to-br from-brand-50 to-violet-50 dark:from-brand-500/10 dark:to-violet-500/10"><h3 class="font-semibold text-slate-900 dark:text-white mb-4">{s.potential}</h3><div class="grid grid-cols-3 gap-3 text-center"><div class="rounded-xl bg-white dark:bg-slate-900 p-3"><div class="text-2xl font-bold text-slate-900 dark:text-white" id="t-users">9</div><div class="text-[11px] text-slate-500">{s.total}</div></div><div class="rounded-xl bg-white dark:bg-slate-900 p-3"><div class="text-2xl font-bold text-brand-600" id="t-month">$209</div><div class="text-[11px] text-slate-500">{s.monthly}</div></div><div class="rounded-xl bg-white dark:bg-slate-900 p-3"><div class="text-2xl font-bold text-emerald-600" id="t-year">$2,502</div><div class="text-[11px] text-slate-500">{s.yearly}</div></div></div><div class="mt-5 text-xs text-slate-500"><div class="font-semibold mb-1">{s.breakdown}</div><ul id="breakdown" class="space-y-0.5"></ul></div><p class="mt-5 text-sm font-semibold text-slate-900 dark:text-white">{s.remember}</p><a href={affiliateUrl} class="btn-primary mt-4 w-full">{s.start}</a></div>
    </div></div></section>
  <section class="lp-section-gray"><div class="container-x"><div class="text-center reveal"><h2 class="section-title">{s.benefits}</h2><p class="section-subtitle">{s.benefitsBody}</p></div><div class="mt-10 grid md:grid-cols-3 gap-5">{s.b.map(([e, t, d, c]) => <div class="card p-7 text-center reveal"><div class="text-4xl">{e}</div><h3 class="mt-3 font-bold text-slate-900 dark:text-white">{t}</h3><p class="mt-2 text-sm text-slate-500 dark:text-slate-400">{d}</p><span class="chip mt-4">{c}</span></div>)}</div></div></section>
  <section class="lp-section-white"><div class="container-x"><div class="text-center reveal"><h2 class="section-title">{s.how}</h2><p class="section-subtitle">{s.howBody}</p></div><div class="mt-10 grid md:grid-cols-3 gap-5">{s.steps.map(([t, d], i) => <div class="relative card p-7 reveal"><span class="absolute -top-3 -left-3 inline-flex h-8 w-8 items-center justify-center rounded-full bg-brand-600 text-white font-bold">{i + 1}</span><h3 class="font-bold text-slate-900 dark:text-white">{t}</h3><p class="mt-2 text-sm text-slate-500 dark:text-slate-400">{d}</p></div>)}</div></div></section>
  <Cta title={s.ready} subtitle={s.readyBody} label={s.want} href={affiliateUrl} />
  <FaqList title={fr ? 'Questions fréquentes' : 'Frequently asked questions'} items={s.faq} />
  <script>
    const ranges = [...document.querySelectorAll<HTMLInputElement>('input[data-plan]')];
    const calc = () => { let users = 0, month = 0; const rows: string[] = []; for (const r of ranges) { const n = +r.value, p = +r.dataset.price!; const c = p * 0.5 * n; users += n; month += c; document.querySelector(`[data-count="${r.dataset.plan}"]`)!.textContent = String(n); document.querySelector(`[data-comm="${r.dataset.plan}"]`)!.textContent = '$' + c.toLocaleString('en-US'); rows.push(`<li class="flex justify-between"><span>${r.dataset.plan} (${n} × $${p * 0.5})</span><b>$${c.toLocaleString('en-US')}/mo</b></li>`); } document.getElementById('t-users')!.textContent = String(users); document.getElementById('t-month')!.textContent = '$' + Math.round(month).toLocaleString('en-US'); document.getElementById('t-year')!.textContent = '$' + Math.round(month * 12).toLocaleString('en-US'); document.getElementById('breakdown')!.innerHTML = rows.join(''); };
    ranges.forEach((r) => r.addEventListener('input', calc)); calc();
  </script>
</BaseLayout>
