---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { REVIEWS } from '../../lib/showcase';
import { all, run, newId, now } from '../../server/db';
import { isLang, fmtDate } from '../../lib/i18n';
if (!isLang(Astro.params.lang!)) return new Response(null, { status: 404 });
const lang = Astro.locals.lang; const fr = lang === 'fr';
let thanks = false;
if (Astro.request.method === 'POST') { const fd = await Astro.request.formData(); const name = String(fd.get('name') || '').slice(0, 80).trim(); const text = String(fd.get('text') || '').slice(0, 2000).trim(); const stars = Math.min(5, Math.max(1, Number(fd.get('stars') || 5))); if (name && text && !fd.get('website')) { run('INSERT INTO reviews (id, name, role, text, stars, created_at, approved, email) VALUES (?,?,?,?,?,?,?,?)', newId('rev_'), name, String(fd.get('role') || '').slice(0, 80), text, stars, now(), 0, String(fd.get('email') || '').slice(0, 120)); thanks = true; } }
const user = all<any>('SELECT * FROM reviews WHERE approved = 1 ORDER BY created_at DESC');
const items = [...user.map((r) => ({ text: r.text, name: r.name, initials: r.name.slice(0, 2).toUpperCase(), role: r.role, date: r.created_at.slice(0, 7), stars: r.stars })), ...REVIEWS.filter((r) => !r.video)];
const s = fr ? { title: 'Avis clients', sub: `${items.length}+ avis vérifiés · Note moyenne 4.9/5`, leave: 'Laisser un avis', name: 'Nom', role: 'Rôle / entreprise (optionnel)', text: 'Votre avis', stars: 'Note', send: 'Envoyer', thanks: 'Merci ! Votre avis sera publié après modération.' } : { title: 'Customer reviews', sub: `${items.length}+ verified reviews · Average rating 4.9/5`, leave: 'Leave a review', name: 'Name', role: 'Role / company (optional)', text: 'Your review', stars: 'Rating', send: 'Send', thanks: 'Thank you! Your review will be published after moderation.' };
const colors = ['#6366f1', '#0ea5e9', '#10b981', '#f59e0b', '#ec4899', '#8b5cf6'];
---
<BaseLayout title={`${s.title} | Upload-Post`} description={s.sub}>
  <section class="bg-white dark:bg-slate-950 pt-12 pb-8 text-center"><div class="container-x"><h1 class="text-4xl md:text-5xl font-extrabold text-slate-900 dark:text-white">{s.title}</h1><p class="mt-3 text-slate-500"><span class="text-amber-400">★★★★★</span> {s.sub}</p><a href="#leave" class="btn-primary mt-5"><i class="fa-solid fa-pen"></i>{s.leave}</a></div></section>
  <section class="lp-section-gray !pt-4"><div class="container-x columns-1 md:columns-2 lg:columns-3 gap-5 [&>*]:break-inside-avoid">{items.map((r, i) => <article class="card p-5 mb-5"><div class="text-amber-400 text-xs">{Array.from({ length: r.stars }).map(() => <i class="fa-solid fa-star"></i>)}</div><p class="mt-3 text-[15px] text-slate-700 dark:text-slate-300 whitespace-pre-line">{r.text}</p><div class="mt-4 flex items-center justify-between"><div class="flex items-center gap-2.5"><span class="inline-flex h-8 w-8 items-center justify-center rounded-full text-[11px] font-bold text-white" style={`background:${colors[i % colors.length]}`}>{r.initials}</span><div><div class="text-sm font-semibold text-slate-900 dark:text-white">{r.name}</div>{r.role && <div class="text-[11px] text-slate-500">{r.role}</div>}</div></div><time class="text-[11px] text-slate-400">{fmtDate(r.date + '-01', lang, { month: 'short', year: 'numeric' })}</time></div></article>)}</div></section>
  <section class="lp-section-white" id="leave"><div class="container-x max-w-xl"><h2 class="section-title text-center mb-6">{s.leave}</h2>{thanks ? <div class="rounded-xl bg-emerald-50 dark:bg-emerald-500/10 border border-emerald-300/60 p-4 text-center text-emerald-700 dark:text-emerald-300">{s.thanks}</div> : <form method="post" class="card p-6 space-y-4"><input type="text" name="website" class="hidden" tabindex="-1" autocomplete="off" /><div class="grid sm:grid-cols-2 gap-4"><div><label class="label">{s.name}</label><input name="name" required class="input" /></div><div><label class="label">{s.role}</label><input name="role" class="input" /></div></div><div><label class="label">{s.stars}</label><select name="stars" class="input input-select">{[5, 4, 3, 2, 1].map((n) => <option value={n}>{'★'.repeat(n)}</option>)}</select></div><div><label class="label">{s.text}</label><textarea name="text" required rows="4" class="input"></textarea></div><button class="btn-primary">{s.send}</button></form>}</div></section>
</BaseLayout>
