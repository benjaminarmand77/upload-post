---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/marketing/PageHero.astro';
import Cta from '../../components/marketing/Cta.astro';
import FaqList from '../../components/marketing/FaqList.astro';
import { competitorBySlug, COMPETITORS } from '../../lib/content/competitors';
import { isLang, localePath } from '../../lib/i18n';
if (!isLang(Astro.params.lang!)) return new Response(null, { status: 404 });
const c = competitorBySlug(Astro.params.competitor!); if (!c) return new Response(null, { status: 404 });
const lang = Astro.locals.lang; const fr = lang === 'fr'; const txt = fr ? 'fr' : 'en'; const L = (p: string) => localePath(lang, p);
const s = fr ? { title: `Alternative à ${c.name}`, titleB: 'Upload-Post : une API, 22 plateformes, dès 0 €', sub: `Vous cherchez une alternative à ${c.name} ? Upload-Post publie sur TikTok, Instagram, YouTube, LinkedIn, X et 17 autres réseaux depuis une seule API, un tableau de bord et vos agents IA, avec un plan gratuit et une marque blanche abordable.`, compare: 'Comparaison', feature: 'Fonctionnalité', rows: [['Plateformes', '22', String(c.platforms)], ['API de publication', '✓', c.api ? '✓' : '✗'], ['Plan gratuit', '✓ 10 uploads/mois', c.freeTier ? '✓' : '✗'], ['Marque blanche', '✓ dès 33 $/mois', c.whitelabel ? '✓' : '✗'], ['Agents IA / MCP', '✓ 50 outils', c.aiAgents ? '✓' : '✗'], ['Éditeur vidéo FFmpeg', '✓', '✗'], ['n8n / Make / Zapier', '✓ nœud officiel', c.type === 'api' ? '✓' : 'partiel'], ['Analytique & commentaires', '✓', c.type === 'scheduler' ? '✓' : 'partiel'], ['Prix d\'entrée', '0 $ · Basic 16 $/mois', c.price]], why: `Pourquoi passer de ${c.name} à Upload-Post`, strengths: `Ce que ${c.name} fait bien`, gaps: `Ce qui manque à ${c.name}`, pricing: 'Tarifs', faq: [{ q: `Puis-je migrer mes comptes depuis ${c.name} ?`, a: 'Oui. Reconnectez vos réseaux dans Upload-Post en deux clics (OAuth), puis importez votre calendrier via l\'API, n8n ou Google Sheets.' }, { q: 'Upload-Post est-il un planificateur ou une API ?', a: 'Les deux : un tableau de bord complet (calendrier, file, analytique, inbox) et une API REST documentée avec SDKs Python et JS.' }, { q: 'Y a-t-il un engagement ?', a: 'Non. Mensuel ou annuel (-40 %), résiliable à tout moment, satisfait ou remboursé 15 jours.' }] }
: { title: `${c.name} alternative`, titleB: 'Upload-Post: one API, 22 platforms, from $0', sub: `Looking for a ${c.name} alternative? Upload-Post posts to TikTok, Instagram, YouTube, LinkedIn, X and 17 more networks from one API, one dashboard and your AI agents, with a free plan and affordable whitelabel.`, compare: 'Comparison', feature: 'Feature', rows: [['Platforms', '22', String(c.platforms)], ['Publishing API', '✓', c.api ? '✓' : '✗'], ['Free plan', '✓ 10 uploads/mo', c.freeTier ? '✓' : '✗'], ['Whitelabel', '✓ from $33/mo', c.whitelabel ? '✓' : '✗'], ['AI agents / MCP', '✓ 50 tools', c.aiAgents ? '✓' : '✗'], ['FFmpeg video editor', '✓', '✗'], ['n8n / Make / Zapier', '✓ official node', c.type === 'api' ? '✓' : 'partial'], ['Analytics & comments', '✓', c.type === 'scheduler' ? '✓' : 'partial'], ['Entry price', '$0 · Basic $16/mo', c.price]], why: `Why switch from ${c.name} to Upload-Post`, strengths: `What ${c.name} does well`, gaps: `What ${c.name} lacks`, pricing: 'Pricing', faq: [{ q: `Can I migrate my accounts from ${c.name}?`, a: 'Yes. Reconnect your networks in Upload-Post in two clicks (OAuth), then import your calendar through the API, n8n or Google Sheets.' }, { q: 'Is Upload-Post a scheduler or an API?', a: 'Both: a full dashboard (calendar, queue, analytics, inbox) and a documented REST API with Python and JS SDKs.' }, { q: 'Is there a commitment?', a: 'No. Monthly or yearly (-40%), cancel anytime, 15-day money-back guarantee.' }] };
const others = COMPETITORS.filter((x) => x.slug !== c.slug).slice(0, 8);
---
<BaseLayout title={`${s.title} — ${s.titleB} | Upload-Post`} description={s.sub}>
  <PageHero eyebrow={fr ? 'Comparatif' : 'Comparison'} title={s.title} titleB={s.titleB} subtitle={s.sub} center cta={{ label: Astro.locals.t.common.startFree, href: `/app/login?source=${lang}-vs-${c.slug}` }} cta2={{ label: Astro.locals.t.nav.pricing, href: '/#pricing', icon: 'fa-tag' }} />
  <section class="lp-section-gray"><div class="container-x max-w-4xl"><h2 class="section-title text-center mb-8 reveal">{s.compare}</h2><div class="card overflow-x-auto reveal"><table class="w-full text-sm"><thead class="bg-slate-50 dark:bg-slate-900/60 text-left text-[11px] uppercase tracking-wider text-slate-400"><tr><th class="px-4 py-3">{s.feature}</th><th class="px-4 py-3 text-brand-600">Upload-Post</th><th class="px-4 py-3">{c.name}</th></tr></thead><tbody class="divide-y divide-slate-100 dark:divide-slate-800">{s.rows.map((r) => <tr><td class="px-4 py-3 font-medium text-slate-900 dark:text-white">{r[0]}</td><td class="px-4 py-3 text-emerald-600 dark:text-emerald-400 font-semibold">{r[1]}</td><td class="px-4 py-3 text-slate-500">{r[2]}</td></tr>)}</tbody></table></div><p class="mt-3 text-xs text-slate-400">{c.priceNote[txt]} · {fr ? 'Tarifs publics constatés en octobre 2026.' : 'Public prices observed in October 2026.'}</p></div></section>
  <section class="lp-section-white"><div class="container-x grid md:grid-cols-2 gap-6 max-w-4xl"><div class="card p-6"><h3 class="font-semibold text-slate-900 dark:text-white">{s.strengths}</h3><ul class="mt-3 space-y-2">{c.strengths[txt].map((x) => <li class="check-li">{x}</li>)}</ul></div><div class="card p-6"><h3 class="font-semibold text-slate-900 dark:text-white">{s.gaps}</h3><ul class="mt-3 space-y-2">{c.gaps[txt].map((x) => <li class="flex items-start gap-2 text-sm text-slate-600 dark:text-slate-300"><i class="fa-solid fa-xmark text-rose-500 mt-1 text-xs"></i>{x}</li>)}</ul></div></div></section>
  <FaqList title="FAQ" items={s.faq} gray />
  <section class="lp-section-white"><div class="container-x"><h2 class="text-sm font-semibold uppercase tracking-wider text-slate-400 mb-4 text-center">{fr ? 'Autres comparatifs' : 'Other comparisons'}</h2><div class="flex flex-wrap justify-center gap-2">{others.map((o) => <a href={L(`/${o.slug}-alternative/`)} class="rounded-lg border border-slate-200 dark:border-slate-700 px-3 py-1.5 text-sm hover:border-brand-400">vs {o.name}</a>)}<a href={L('/best-social-media-apis/')} class="rounded-lg border border-brand-300 px-3 py-1.5 text-sm font-semibold text-brand-600">{fr ? 'Meilleures API 2026' : 'Best APIs 2026'} →</a></div></div></section>
  <Cta title={s.titleB} label={Astro.locals.t.common.startFree} href={`/app/login?source=${lang}-vs-${c.slug}`} note={Astro.locals.t.common.noCreditCard} />
</BaseLayout>
