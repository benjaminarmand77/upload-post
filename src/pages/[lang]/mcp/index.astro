---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/marketing/PageHero.astro';
import CodeBlock from '../../../components/marketing/CodeBlock.astro';
import FeatureGrid from '../../../components/marketing/FeatureGrid.astro';
import Cta from '../../../components/marketing/Cta.astro';
import FaqList from '../../../components/marketing/FaqList.astro';
import PlatformIcon from '../../../components/PlatformIcon.astro';
import { PLATFORMS } from '../../../lib/platforms';
import { MCP_TOOLS, mcpConfig, AGENTS } from '../../../lib/content/mcp';
import { isLang, localePath } from '../../../lib/i18n';
if (!isLang(Astro.params.lang!)) return new Response(null, { status: 404 });
const lang = Astro.locals.lang; const fr = lang === 'fr'; const L = (p: string) => localePath(lang, p);
const base = (process.env.SITE_URL || Astro.url.origin).replace(/\/$/, '');
const s = fr ? { title: 'Serveur MCP réseaux sociaux', titleB: 'Connectez ChatGPT, Claude & tout agent IA', sub: 'Upload-Post est le serveur MCP réseaux sociaux open source. Ajoutez un bloc de configuration à votre client IA et votre assistant gagne 50 outils pour publier, planifier, analyser et gérer les réseaux sociaux — TikTok, Instagram, YouTube, LinkedIn, Facebook, X, Threads, Reddit, Bluesky, Pinterest, Google Business, Discord & Telegram.', cta: 'Commencer gratuitement — sans carte', github: 'Voir sur GitHub', f: [{ t: 'Publier', d: 'Vidéos, photos, carrousels, texte et documents sur 22 plateformes en une phrase.', icon: 'fa-cloud-arrow-up' }, { t: 'Planifier', d: 'Programmez à une date précise ou ajoutez à la file de publication de chaque profil.', icon: 'fa-calendar' }, { t: 'Analyser', d: 'Abonnés, vues, engagement et métriques par post, unifiés par plateforme.', icon: 'fa-chart-line' }, { t: 'Modérer', d: 'Lisez, répondez, masquez ou épinglez les commentaires, envoyez des DM.', icon: 'fa-comments' }, { t: 'Gérer', d: 'Profils, liens de connexion marque blanche, webhooks et quotas.', icon: 'fa-users' }, { t: 'Éditer', d: 'Jobs FFmpeg pour recadrer, convertir ou extraire l\'audio.', icon: 'fa-film' }], toolsTitle: '50 outils couvrant chaque endpoint public', agentsTitle: 'Fonctionne avec', setup: 'Installation', steps: [['Créez votre clé API', 'Inscrivez-vous, connectez un réseau et générez une clé dans Clés API.'], ['Ajoutez le serveur MCP', 'Collez le bloc de configuration dans Claude Desktop, Claude Code, Cursor, ChatGPT ou votre agent.'], ['Parlez', '« Publie cette vidéo sur TikTok et YouTube demain à 9h » — c\'est tout.']], selfhost: 'Auto-hébergement', selfhostBody: 'Le serveur MCP est inclus dans cette installation : il tourne sur votre propre domaine. Une seule commande Docker si vous préférez le déployer ailleurs.', faq: [{ q: 'Qu\'est-ce que MCP ?', a: 'Le Model Context Protocol est un standard ouvert qui permet aux assistants IA d\'utiliser des outils externes. Upload-Post expose ses endpoints comme outils MCP.' }, { q: 'Mes identifiants sociaux sont-ils partagés avec l\'IA ?', a: 'Non. L\'IA n\'a que votre clé API Upload-Post. Les jetons des réseaux sociaux restent chiffrés côté serveur.' }, { q: 'Est-ce payant ?', a: 'Le serveur MCP est gratuit et open source. Les publications consomment votre quota Upload-Post (10 gratuites par mois).' }] }
: { title: 'Social media MCP server', titleB: 'Connect ChatGPT, Claude & any AI agent', sub: 'Upload-Post is the open-source social media MCP server. Add one configuration block to your AI client and your assistant gains 50 tools to publish, schedule, analyze and manage social media — TikTok, Instagram, YouTube, LinkedIn, Facebook, X, Threads, Reddit, Bluesky, Pinterest, Google Business, Discord & Telegram.', cta: 'Start for free — no card', github: 'View on GitHub', f: [{ t: 'Publish', d: 'Videos, photos, carousels, text and documents to 22 platforms in one sentence.', icon: 'fa-cloud-arrow-up' }, { t: 'Schedule', d: 'Schedule at an exact time or add to each profile\'s publishing queue.', icon: 'fa-calendar' }, { t: 'Analyze', d: 'Followers, views, engagement and per-post metrics, unified per platform.', icon: 'fa-chart-line' }, { t: 'Moderate', d: 'Read, reply, hide or pin comments, send DMs.', icon: 'fa-comments' }, { t: 'Manage', d: 'Profiles, whitelabel connect links, webhooks and quotas.', icon: 'fa-users' }, { t: 'Edit', d: 'FFmpeg jobs to crop, convert or extract audio.', icon: 'fa-film' }], toolsTitle: '50 tools covering every public endpoint', agentsTitle: 'Works with', setup: 'Setup', steps: [['Create your API key', 'Sign up, connect a network and generate a key in API keys.'], ['Add the MCP server', 'Paste the configuration block into Claude Desktop, Claude Code, Cursor, ChatGPT or your agent.'], ['Talk', '"Post this video to TikTok and YouTube tomorrow at 9am" — that is it.']], selfhost: 'Self-hosting', selfhostBody: 'The MCP server ships with this installation: it runs on your own domain. One Docker command if you prefer to deploy it elsewhere.', faq: [{ q: 'What is MCP?', a: 'The Model Context Protocol is an open standard letting AI assistants use external tools. Upload-Post exposes its endpoints as MCP tools.' }, { q: 'Are my social credentials shared with the AI?', a: 'No. The AI only holds your Upload-Post API key. Social network tokens stay encrypted server-side.' }, { q: 'Is it paid?', a: 'The MCP server is free and open source. Posts consume your Upload-Post quota (10 free per month).' }] };
---
<BaseLayout title={`${s.title} ${fr ? 'pour ChatGPT, Claude et IA' : 'for ChatGPT, Claude and AI'} | Upload-Post`} description={s.sub}>
  <PageHero eyebrow={`${fr ? 'Guide d\'intégration' : 'Integration guide'} · Open Source`} title={s.title} titleB={s.titleB} subtitle={s.sub} cta={{ label: s.cta, href: `/app/login?source=${lang}-mcp`, icon: 'fa-rocket' }} cta2={{ label: s.github, href: 'https://github.com/upload-post', icon: 'fa-code-branch' }}>
    <CodeBlock slot="aside" title="~/.claude/mcp.json" code={mcpConfig(base)} />
  </PageHero>
  <FeatureGrid items={s.f} />
  <section class="lp-section-gray"><div class="container-x"><div class="text-center reveal"><h2 class="section-title">{s.setup}</h2></div><div class="mt-10 grid md:grid-cols-3 gap-5">{s.steps.map(([t, d], i) => <div class="relative card p-6 reveal"><span class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-brand-600 text-white font-bold text-sm">{i + 1}</span><h3 class="mt-3 font-semibold text-slate-900 dark:text-white">{t}</h3><p class="mt-2 text-sm text-slate-500 dark:text-slate-400">{d}</p></div>)}</div>
    <div class="mt-8 grid md:grid-cols-2 gap-5"><CodeBlock title="claude mcp add" code={`claude mcp add upload-post --transport http ${base}/mcp \\\n  --header "Authorization: Apikey YOUR_API_KEY"`} /><CodeBlock title="docker" code={`docker run -p 8787:8787 -e UPLOAD_POST_API_KEY=YOUR_API_KEY \\\n  ghcr.io/upload-post/mcp-server:latest`} /></div></div></section>
  <section class="lp-section-white"><div class="container-x"><h2 class="section-title text-center reveal">{s.toolsTitle}</h2><div class="mt-8 flex flex-wrap justify-center gap-1.5 reveal">{MCP_TOOLS.map((t) => <code class="chip font-mono !text-[11px]">{t}</code>)}</div></div></section>
  <section class="lp-section-gray"><div class="container-x"><h2 class="section-title text-center reveal">{s.agentsTitle}</h2><div class="mt-8 flex flex-wrap justify-center gap-2">{AGENTS.slice(0, 8).map((a) => <a href={L(`/${a.slug}-social-media/`)} class="inline-flex items-center gap-2 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 px-4 py-2.5 text-sm font-medium hover:border-brand-400"><i class={a.icon} style={`color:${a.color}`}></i>{a.name}</a>)}<a href={L('/ai-agents/')} class="inline-flex items-center gap-2 rounded-xl border border-brand-300 px-4 py-2.5 text-sm font-semibold text-brand-600">{fr ? 'Tous les agents' : 'All agents'} →</a></div>
    <h3 class="mt-12 text-center text-sm font-semibold uppercase tracking-wider text-slate-400">{fr ? 'Guides MCP par plateforme' : 'MCP guides per platform'}</h3><div class="mt-4 flex flex-wrap justify-center gap-2">{PLATFORMS.map((p) => <a href={L(`/mcp/${p.slug}/`)} class="inline-flex items-center gap-2 rounded-lg border border-slate-200 dark:border-slate-700 px-3 py-1.5 text-sm hover:border-brand-400"><PlatformIcon platform={p.key} size="text-sm" />{p.name}</a>)}</div></div></section>
  <section class="lp-section-white"><div class="container-x max-w-3xl text-center reveal"><h2 class="section-title">{s.selfhost}</h2><p class="section-subtitle">{s.selfhostBody}</p></div></section>
  <FaqList title={fr ? 'Questions fréquentes' : 'FAQ'} items={s.faq} gray />
  <Cta title={s.title} subtitle={s.titleB} label={s.cta} href={`/app/login?source=${lang}-mcp`} />
</BaseLayout>
