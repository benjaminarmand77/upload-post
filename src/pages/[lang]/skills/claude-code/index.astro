---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import PageHero from '../../../../components/marketing/PageHero.astro';
import CodeBlock from '../../../../components/marketing/CodeBlock.astro';
import FeatureGrid from '../../../../components/marketing/FeatureGrid.astro';
import Cta from '../../../../components/marketing/Cta.astro';
import FaqList from '../../../../components/marketing/FaqList.astro';
import PlatformIcon from '../../../../components/PlatformIcon.astro';
import { PLATFORMS } from '../../../../lib/platforms';
import { isLang, localePath } from '../../../../lib/i18n';
if (!isLang(Astro.params.lang!)) return new Response(null, { status: 404 });
const lang = Astro.locals.lang; const fr = lang === 'fr'; const L = (p: string) => localePath(lang, p);
const s = fr ? { title: 'Skill Claude Code pour les réseaux sociaux', titleB: 'Publiez depuis votre terminal', sub: 'Installez le skill Upload-Post pour Claude Code et demandez à Claude de publier une vidéo, un carrousel ou un thread en langage naturel. Il gère l\'API pour vous : TikTok, Instagram, YouTube, LinkedIn et 18 autres plateformes.', install: 'Installation en une commande', f: [{ t: 'Langage naturel', d: '« Publie ./clip.mp4 sur TikTok et Reels avec les hashtags de mon fichier notes.md ». Claude fait le reste.', icon: 'fa-comment' }, { t: 'Reels, Shorts, carrousels, threads', d: 'Chaque format est couvert : vidéos verticales, séries de photos, textes longs découpés en threads.', icon: 'fa-layer-group' }, { t: 'Programmation', d: 'Demandez une date ou « ajoute à la file » : le skill utilise scheduled_date ou add_to_queue.', icon: 'fa-calendar' }, { t: 'Analytique', d: 'Posez des questions sur vos vues, abonnés et meilleurs posts depuis le terminal.', icon: 'fa-chart-line' }, { t: 'Multi-profils', d: 'Gérez plusieurs clients ou marques : un profil Upload-Post par compte.', icon: 'fa-users' }, { t: 'Open source', d: 'Le skill est un dossier Markdown + scripts : lisez-le, adaptez-le, versionnez-le.', icon: 'fa-code-branch' }], ex: 'Exemples', exs: ['Publie la vidéo output/final.mp4 sur YouTube Shorts, TikTok et Instagram Reels avec un titre accrocheur', 'Crée un carrousel Instagram à partir des 5 images de ./slides et programme-le demain 10h', 'Transforme README.md en thread X et Threads, et publie-le', 'Montre-moi les stats de mes 10 derniers posts LinkedIn'], faq: [{ q: 'Que fait exactement le skill ?', a: 'Il apprend à Claude Code comment appeler l\'API Upload-Post : endpoints, paramètres par plateforme, limites de caractères et bonnes pratiques. Claude choisit ensuite l\'appel adapté à votre demande.' }, { q: 'Fonctionne-t-il avec Cursor ou d\'autres agents ?', a: 'Oui. Le format skills est lu par Claude Code, Cursor, OpenCode et tout agent compatible. Pour les autres assistants, utilisez le serveur MCP.' }, { q: 'Ai-je besoin d\'une clé API ?', a: 'Oui, gratuite : créez un compte, connectez un réseau et générez une clé dans Clés API. Exportez-la en UPLOAD_POST_API_KEY.' }] }
: { title: 'Claude Code skill for social media', titleB: 'Publish from your terminal', sub: 'Install the Upload-Post skill for Claude Code and tell Claude to post a video, carousel or thread in plain English. It handles the API for you: TikTok, Instagram, YouTube, LinkedIn and 18 more platforms.', install: 'One-command install', f: [{ t: 'Natural language', d: '"Post ./clip.mp4 to TikTok and Reels with the hashtags from my notes.md". Claude does the rest.', icon: 'fa-comment' }, { t: 'Reels, Shorts, carousels, threads', d: 'Every format is covered: vertical videos, photo series, long texts split into threads.', icon: 'fa-layer-group' }, { t: 'Scheduling', d: 'Ask for a date or "add to the queue": the skill uses scheduled_date or add_to_queue.', icon: 'fa-calendar' }, { t: 'Analytics', d: 'Ask about your views, followers and best posts from the terminal.', icon: 'fa-chart-line' }, { t: 'Multi-profile', d: 'Manage several clients or brands: one Upload-Post profile per account.', icon: 'fa-users' }, { t: 'Open source', d: 'The skill is a Markdown folder + scripts: read it, adapt it, version it.', icon: 'fa-code-branch' }], ex: 'Examples', exs: ['Post the video output/final.mp4 to YouTube Shorts, TikTok and Instagram Reels with a catchy title', 'Build an Instagram carousel from the 5 images in ./slides and schedule it tomorrow 10am', 'Turn README.md into an X and Threads thread, and publish it', 'Show me the stats of my last 10 LinkedIn posts'], faq: [{ q: 'What does the skill do exactly?', a: 'It teaches Claude Code how to call the Upload-Post API: endpoints, per-platform parameters, character limits and best practices. Claude then picks the right call for your request.' }, { q: 'Does it work with Cursor or other agents?', a: 'Yes. The skills format is read by Claude Code, Cursor, OpenCode and any compatible agent. For other assistants, use the MCP server.' }, { q: 'Do I need an API key?', a: 'Yes, a free one: create an account, connect a network and generate a key in API keys. Export it as UPLOAD_POST_API_KEY.' }] };
---
<BaseLayout title={`${s.title} | Upload-Post`} description={s.sub}>
  <PageHero eyebrow="Claude Code · Open Source" title={s.title} titleB={s.titleB} subtitle={s.sub} cta={{ label: Astro.locals.t.common.startFree, href: `/app/login?source=${lang}-skills` }} cta2={{ label: 'GitHub', href: 'https://github.com/upload-post/upload-post-skill', icon: 'fa-code-branch' }}>
    <div slot="aside" class="space-y-3"><div class="text-xs font-semibold uppercase tracking-wider text-slate-400">{s.install}</div><CodeBlock title="terminal" code={`npx skills add Upload-Post/upload-post-skill\nexport UPLOAD_POST_API_KEY=your-api-key\nclaude "${s.exs[0]}"`} /></div>
  </PageHero>
  <FeatureGrid items={s.f} />
  <section class="lp-section-gray"><div class="container-x grid md:grid-cols-2 gap-6"><div class="card p-6"><h2 class="font-bold text-lg text-slate-900 dark:text-white">{s.ex}</h2><ul class="mt-4 space-y-3">{s.exs.map((x) => <li class="rounded-xl bg-slate-100 dark:bg-slate-800 px-4 py-3 text-sm font-mono text-slate-700 dark:text-slate-200">$ claude "{x}"</li>)}</ul></div><div class="card p-6"><h2 class="font-bold text-lg text-slate-900 dark:text-white">{fr ? 'Skill par plateforme' : 'Skill per platform'}</h2><div class="mt-4 flex flex-wrap gap-2">{PLATFORMS.map((p) => <a href={L(`/skills/claude-code/${p.slug}/`)} class="inline-flex items-center gap-2 rounded-lg border border-slate-200 dark:border-slate-700 px-3 py-1.5 text-sm hover:border-brand-400"><PlatformIcon platform={p.key} size="text-sm" />{p.name}</a>)}</div></div></div></section>
  <FaqList title="FAQ" items={s.faq} />
  <Cta title={s.titleB} subtitle={s.sub} label={Astro.locals.t.common.startFree} href={`/app/login?source=${lang}-skills`} />
</BaseLayout>
