---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/marketing/PageHero.astro';
import CodeBlock from '../../components/marketing/CodeBlock.astro';
import FeatureGrid from '../../components/marketing/FeatureGrid.astro';
import Cta from '../../components/marketing/Cta.astro';
import FaqList from '../../components/marketing/FaqList.astro';
import { agentBySlug, mcpConfig, MCP_TOOLS, AGENTS } from '../../lib/content/mcp';
import { isLang, localePath } from '../../lib/i18n';
import Landing from '../../components/pages/Landing.astro';
import { landingBySlug } from '../../lib/content/landing';
if (!isLang(Astro.params.lang!)) return new Response(null, { status: 404 });
const found = agentBySlug(Astro.params.agent!);
const landingSlug = `${Astro.params.agent}-social-media`; const landing = !found && landingBySlug(landingSlug) ? landingSlug : null;
if (!found && !landing) return new Response(null, { status: 404 });
const a = found ?? AGENTS[0]; // placeholder when rendering the landing fallback
const lang = Astro.locals.lang; const fr = lang === 'fr'; const L = (p: string) => localePath(lang, p); const txt = fr ? 'fr' : 'en';
const base = (process.env.SITE_URL || Astro.url.origin).replace(/\/$/, '');
const s = fr ? { title: `${a.name} pour les réseaux sociaux`, titleB: `Publiez sur 22 plateformes depuis ${a.name}`, sub: `Connectez Upload-Post à ${a.name} et demandez-lui de publier des vidéos, photos et textes sur TikTok, Instagram, YouTube, LinkedIn, X et 17 autres réseaux, de programmer vos posts et de lire vos statistiques. ${a.how[txt]}`, f: [{ t: 'Publier en une phrase', d: `Décrivez le post, ${a.name} appelle upload_video, upload_photos ou upload_text avec les bons paramètres.`, icon: 'fa-paper-plane' }, { t: 'Programmer', d: 'Dates précises, fuseaux horaires et file de publication.', icon: 'fa-calendar' }, { t: 'Analyser', d: 'Abonnés, vues, engagement, métriques par post.', icon: 'fa-chart-line' }, { t: 'Modérer', d: 'Commentaires, réponses, DM Instagram.', icon: 'fa-comments' }, { t: 'Multi-comptes', d: 'Un profil par client, une clé API pour tout.', icon: 'fa-users' }, { t: 'Sécurisé', d: `${a.name} ne voit jamais vos jetons de réseaux sociaux.`, icon: 'fa-shield-halved' }], steps: 'Mise en place', st: [['Créez votre compte et votre clé API', 'Gratuit, sans carte. Connectez un premier réseau en deux clics.'], [`Connectez ${a.name}`, a.how[txt]], ['Demandez', '« Publie cette vidéo sur TikTok et YouTube Shorts demain 9h »']], faq: [{ q: `${a.name} peut-il publier des vidéos ?`, a: 'Oui : donnez un chemin de fichier ou une URL publique, l\'outil upload_video fait le reste, avec transcodage automatique par plateforme.' }, { q: 'Combien ça coûte ?', a: 'L\'intégration est gratuite. Les publications consomment votre quota Upload-Post : 10 gratuites par mois, illimitées dès le plan Basic.' }, { q: 'Et si je n\'utilise pas MCP ?', a: 'Donnez à votre agent l\'URL de notre documentation llm.txt : il écrira lui-même les appels HTTP.' }] }
: { title: `${a.name} for social media`, titleB: `Post to 22 platforms from ${a.name}`, sub: `Connect Upload-Post to ${a.name} and ask it to publish videos, photos and text to TikTok, Instagram, YouTube, LinkedIn, X and 17 more networks, schedule your posts and read your stats. ${a.how[txt]}`, f: [{ t: 'Publish in one sentence', d: `Describe the post, ${a.name} calls upload_video, upload_photos or upload_text with the right parameters.`, icon: 'fa-paper-plane' }, { t: 'Schedule', d: 'Exact dates, timezones and publishing queue.', icon: 'fa-calendar' }, { t: 'Analyze', d: 'Followers, views, engagement, per-post metrics.', icon: 'fa-chart-line' }, { t: 'Moderate', d: 'Comments, replies, Instagram DMs.', icon: 'fa-comments' }, { t: 'Multi-account', d: 'One profile per client, one API key for everything.', icon: 'fa-users' }, { t: 'Secure', d: `${a.name} never sees your social network tokens.`, icon: 'fa-shield-halved' }], steps: 'Setup', st: [['Create your account and API key', 'Free, no card. Connect a first network in two clicks.'], [`Connect ${a.name}`, a.how[txt]], ['Ask', '"Post this video to TikTok and YouTube Shorts tomorrow at 9am"']], faq: [{ q: `Can ${a.name} post videos?`, a: 'Yes: give a file path or a public URL, the upload_video tool does the rest, with automatic per-platform transcoding.' }, { q: 'How much does it cost?', a: 'The integration is free. Posts consume your Upload-Post quota: 10 free per month, unlimited from the Basic plan.' }, { q: 'What if I do not use MCP?', a: 'Give your agent the URL of our llm.txt documentation: it will write the HTTP calls itself.' }] };
---
{landing ? <Landing slug={landing} /> : (<BaseLayout title={`${s.title} — ${s.titleB} | Upload-Post`} description={s.sub}>
  <PageHero breadcrumb={[{ label: fr ? 'Agents IA' : 'AI agents', href: '/ai-agents/' }, { label: a.name }]} title={s.title} titleB={s.titleB} subtitle={s.sub} cta={{ label: Astro.locals.t.common.startFree, href: `/app/login?source=${lang}-${a.slug}` }} cta2={{ label: 'MCP', href: '/mcp/', icon: 'fa-robot' }}>
    <div slot="aside" class="space-y-3"><span class="inline-flex h-14 w-14 items-center justify-center rounded-2xl bg-slate-100 dark:bg-slate-800 text-2xl" style={`color:${a.color}`}><i class={a.icon}></i></span><CodeBlock title="mcp.json" code={mcpConfig(base)} /></div>
  </PageHero>
  <FeatureGrid items={s.f} />
  <section class="lp-section-gray"><div class="container-x"><h2 class="section-title text-center reveal">{s.steps}</h2><div class="mt-8 grid md:grid-cols-3 gap-5">{s.st.map(([t, d], i) => <div class="card p-6 reveal"><span class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-brand-600 text-white font-bold text-sm">{i + 1}</span><h3 class="mt-3 font-semibold text-slate-900 dark:text-white">{t}</h3><p class="mt-2 text-sm text-slate-500 dark:text-slate-400">{d}</p></div>)}</div><div class="mt-8 flex flex-wrap justify-center gap-1.5">{MCP_TOOLS.slice(0, 16).map((t) => <code class="chip font-mono !text-[11px]">{t}</code>)}<a href={L('/mcp/')} class="chip !text-brand-600">+34 …</a></div></div></section>
  <FaqList title="FAQ" items={s.faq} />
  <Cta title={s.titleB} label={Astro.locals.t.common.startFree} href={`/app/login?source=${lang}-${a.slug}`} />
</BaseLayout>)}
