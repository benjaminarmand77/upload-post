---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/marketing/PageHero.astro';
import CodeBlock from '../../components/marketing/CodeBlock.astro';
import Cta from '../../components/marketing/Cta.astro';
import FaqList from '../../components/marketing/FaqList.astro';
import PlatformIcon from '../../components/PlatformIcon.astro';
import { isLang, localePath } from '../../lib/i18n';
if (!isLang(Astro.params.lang!)) return new Response(null, { status: 404 });
const lang = Astro.locals.lang; const fr = lang === 'fr'; const L = (p: string) => localePath(lang, p);
const s = fr ? { title: 'Gestion des réseaux sociaux en marque blanche', titleB: 'pour les agences et les SaaS', sub: 'Envoyez à chaque client le lien d\'une page de connexion avec votre logo, vos textes et votre thème. Il connecte son TikTok, son Instagram, sa chaîne YouTube ou son LinkedIn une seule fois. Ensuite, vous publiez et programmez pour lui via l\'API, n8n ou Make.', cta: 'Commencer gratuitement', cta2: 'Lire le guide marque blanche', note: 'Gratuit pour commencer, sans carte bancaire. La marque blanche est incluse à partir de l\'offre Professional.', chips: ['11 options de personnalisation', 'Jetons stockés chiffrés'], seeTitle: 'Ce que voient vos clients', seeBody: 'Voici la page de connexion que votre client ouvre. Logo, titre, description, langue, réseaux affichés, bouton de retour : tout est à vous.', can: 'Ce que le client peut faire sur cette page', canList: ['Connecter TikTok, Instagram, YouTube, LinkedIn et les autres réseaux OAuth sur l\'écran de connexion du réseau lui-même : son mot de passe n\'arrive jamais ni chez vous ni chez Upload-Post.', 'Choisir la page Facebook, la page entreprise LinkedIn ou l\'établissement Google Business sur lequel vous publierez.', 'Reconnecter un compte dont l\'accès a expiré, ou en déconnecter un à tout moment.', 'Consulter le calendrier des publications programmées, si vous le laissez activé.', 'Revenir sur votre site avec le bouton dont vous avez choisi le texte.'], bound: 'Le lien est lié à un seul profil. Un client ne peut voir et modifier que ses propres comptes, jamais vos autres clients ni votre clé API.', how: 'Comment ça marche pour une agence', howBody: 'Cinq étapes entre un nouveau client et sa première publication programmée. Chaque étape se fait depuis le tableau de bord ou par l\'API.', steps: [['Créez un profil par client', 'Dans le tableau de bord, allez dans Profils & comptes et ajoutez un profil, ou appelez POST /api/uploadposts/users avec un nom comme client-harbor. Un profil contient un compte par réseau.'], ['Générez le lien de connexion à votre marque', 'Cliquez sur Lien de connexion client et renseignez logo, titre, description, langue, URL de retour, texte du bouton et réseaux. Ou envoyez les mêmes champs à POST /api/uploadposts/users/generate-jwt. Vous recevez une access_url valable 48 heures.'], ['Envoyez-le à votre client', 'Par e-mail, par messagerie ou dans votre propre parcours d\'onboarding. Le client n\'a pas besoin de compte Upload-Post et ne voit jamais votre tableau de bord.'], ['Le client connecte ses comptes', 'Il se connecte sur TikTok, Instagram, YouTube ou LinkedIn et autorise l\'accès. Les jetons sont stockés chiffrés et renouvelés pour vous. Avec un webhook configuré, vous recevez social_account.connected au moment même.'], ['Publiez et programmez pour lui', 'Publiez avec user=client-harbor et ajoutez scheduled_date pour programmer. Depuis le tableau de bord, votre code, des templates n8n, un scénario Make ou un assistant IA.']], options: 'Toutes les options de personnalisation', optionsBody: 'Ce sont toutes des champs de l\'appel generate-jwt, enregistrés sur le profil du client. La dernière colonne indique si vous pouvez aussi les régler depuis le tableau de bord.', cols: ['Option', 'Paramètre', 'Ce qu\'elle fait', 'Exemple', 'Tableau de bord'], rows: [['Logo', 'logo_image', 'Affiche votre logo en haut de la page. N\'importe quelle URL d\'image publique.', '"https://votreagence.fr/logo.png"'], ['Titre de la page', 'connect_title', 'Remplace le titre principal.', '"Connectez vos comptes à Northwind Studio"'], ['Description', 'connect_description', 'Remplace la ligne de texte sous le titre.', '"Associez les réseaux que nous allons gérer pour vous."'], ['Réseaux affichés', 'platforms', 'Seuls les réseaux listés apparaissent.', '["instagram", "tiktok", "linkedin"]'], ['URL de retour', 'redirect_url', 'L\'adresse où le bouton de retour renvoie le client.', '"https://votreagence.fr/onboarding/termine"'], ['Texte du bouton', 'redirect_button_text', 'Le libellé du bouton de retour.', '"Retour à Northwind Studio"'], ['Langue', 'language', 'Impose en, es, de, fr, pt, pl ou tr. Sinon, langue du navigateur.', '"fr"'], ['Calendrier', 'show_calendar', 'Affiche ou masque les publications programmées du client.', 'true'], ['Textes', 'ui_labels', 'Réécrit n\'importe quel libellé de la page.', '{"connect.button": "Associer"}'], ['Durée', '—', 'Le lien est valable 48 heures et lié à un seul profil.', '48h'], ['Thème', 'connect_theme', 'Impose le thème clair ou sombre.', '"dark"']], faq: [{ q: 'Mes clients ont-ils besoin d\'un compte Upload-Post ?', a: 'Non. Ils ouvrent le lien, connectent leurs réseaux et c\'est tout. Ils ne voient jamais votre tableau de bord ni votre clé API.' }, { q: 'Combien de clients puis-je gérer ?', a: 'Un client = un profil. Le plan Professional inclut 25 profils, Advanced 75 et Business 225, avec des profils supplémentaires en option.' }, { q: 'Puis-je utiliser mon propre domaine ?', a: 'La page de connexion est servie par Upload-Post avec votre marque. Pour un domaine entièrement personnalisé, utilisez l\'API Connect pour construire votre propre page.' }, { q: 'Comment suis-je prévenu quand un client connecte un compte ?', a: 'Configurez un webhook dans Webhooks & notifications : vous recevez social_account.connected, social_account.disconnected et social_account.reauth_required.' }] }
: { title: 'Whitelabel social media management', titleB: 'for agencies and SaaS', sub: 'Send each client a link to a connect page with your logo, your copy and your theme. They connect their TikTok, Instagram, YouTube channel or LinkedIn once. Then you publish and schedule for them through the API, n8n or Make.', cta: 'Start for free', cta2: 'Read the whitelabel guide', note: 'Free to start, no credit card. Whitelabel is included from the Professional plan.', chips: ['11 customization options', 'Tokens stored encrypted'], seeTitle: 'What your clients see', seeBody: 'This is the connect page your client opens. Logo, title, description, language, networks shown, return button: all yours.', can: 'What the client can do on this page', canList: ['Connect TikTok, Instagram, YouTube, LinkedIn and the other OAuth networks on the network\'s own login screen, so their password never reaches you or Upload-Post.', 'Pick the Facebook Page, LinkedIn company page or Google Business location you will publish to.', 'Reconnect an account whose access expired, or disconnect one at any time.', 'See the calendar of scheduled posts, if you leave it enabled.', 'Go back to your site with the button whose text you chose.'], bound: 'The link is bound to a single profile. A client can only see and change their own accounts, never your other clients or your API key.', how: 'How it works for an agency', howBody: 'Five steps between a new client and their first scheduled post. Each step works from the dashboard or through the API.', steps: [['Create one profile per client', 'In the dashboard, go to Profiles & accounts and add a profile, or call POST /api/uploadposts/users with a username like client-harbor. A profile holds one account per network.'], ['Generate your branded connect link', 'Click Client connect link and fill in logo, title, description, language, return URL, button text and networks. Or send the same fields to POST /api/uploadposts/users/generate-jwt. You get an access_url valid for 48 hours.'], ['Send it to your client', 'By email, chat or inside your own onboarding flow. The client needs no Upload-Post account and never sees your dashboard.'], ['The client connects their accounts', 'They log in on TikTok, Instagram, YouTube or LinkedIn and grant access. Tokens are stored encrypted and refreshed for you. With a webhook configured you receive social_account.connected the moment it happens.'], ['Publish and schedule for them', 'Publish with user=client-harbor and add scheduled_date to schedule. From the dashboard, your code, n8n templates, a Make scenario or an AI assistant.']], options: 'All customization options', optionsBody: 'These are all fields of the generate-jwt call, saved on the client profile. The last column says whether you can also set them from the dashboard.', cols: ['Option', 'Parameter', 'What it does', 'Example', 'Dashboard'], rows: [['Logo', 'logo_image', 'Shows your logo at the top of the page. Any public image URL.', '"https://youragency.com/logo.png"'], ['Page title', 'connect_title', 'Replaces the main title.', '"Connect your accounts to Northwind Studio"'], ['Description', 'connect_description', 'Replaces the line under the title.', '"Link the networks we will manage for you."'], ['Networks shown', 'platforms', 'Only the listed networks appear.', '["instagram", "tiktok", "linkedin"]'], ['Return URL', 'redirect_url', 'Where the return button sends the client when done.', '"https://youragency.com/onboarding/done"'], ['Button text', 'redirect_button_text', 'The label of the return button.', '"Back to Northwind Studio"'], ['Language', 'language', 'Forces en, es, de, fr, pt, pl or tr. Otherwise the browser language.', '"en"'], ['Calendar', 'show_calendar', 'Shows or hides the client\'s scheduled posts.', 'true'], ['Labels', 'ui_labels', 'Rewrites any label on the page.', '{"connect.button": "Link account"}'], ['Validity', '—', 'The link is valid 48 hours and bound to one profile.', '48h'], ['Theme', 'connect_theme', 'Forces light or dark theme.', '"dark"']], faq: [{ q: 'Do my clients need an Upload-Post account?', a: 'No. They open the link, connect their networks and that is it. They never see your dashboard or your API key.' }, { q: 'How many clients can I manage?', a: 'One client = one profile. Professional includes 25 profiles, Advanced 75 and Business 225, with extra profiles available as an add-on.' }, { q: 'Can I use my own domain?', a: 'The connect page is served by Upload-Post with your branding. For a fully custom domain, use the Connect API to build your own page.' }, { q: 'How do I know when a client connects an account?', a: 'Configure a webhook in Webhooks & notifications: you receive social_account.connected, social_account.disconnected and social_account.reauth_required.' }] };
const code = `import { UploadPost } from 'upload-post';\nconst api = new UploadPost('YOUR_API_KEY');\n\n// ${fr ? 'Un profil par client' : 'One profile per client'}\nconst client = 'client-harbor';\nawait api.createUser(client);\n\n// ${fr ? 'Lien de connexion à votre marque, valable 48 heures' : 'Branded connect link, valid 48 hours'}\nconst { access_url } = await api.generateJwt(client, {\n  logoImage: 'https://${fr ? 'votreagence.fr' : 'youragency.com'}/logo.png',\n  connectTitle: '${fr ? 'Connectez vos comptes' : 'Connect your accounts'}',\n  redirectUrl: 'https://${fr ? 'votreagence.fr/termine' : 'youragency.com/done'}',\n  platforms: ['instagram', 'tiktok', 'linkedin']\n});\n// ${fr ? 'Envoyez access_url à votre client' : 'Send access_url to your client'}`;
---
<BaseLayout title={`${s.title} ${s.titleB} | Upload-Post`} description={s.sub}>
  <PageHero eyebrow="Whitelabel" title={s.title} titleB={s.titleB} subtitle={s.sub} cta={{ label: s.cta, href: `/app/login?source=${lang}-whitelabel`, icon: 'fa-rocket' }} cta2={{ label: s.cta2, href: '/docs/guides/whitelabel/', icon: 'fa-book' }} note={s.note}>
    <div slot="extra" class="mt-5 flex flex-wrap gap-2">{s.chips.map((c) => <span class="badge-ok"><i class="fa-solid fa-circle-check"></i>{c}</span>)}</div>
    <CodeBlock slot="aside" title="onboard-client.js" code={code} />
  </PageHero>
  <section class="lp-section-gray"><div class="container-x"><div class="text-center reveal"><span class="eyebrow">{fr ? 'Vraie page' : 'Real page'}</span><h2 class="section-title mt-3">{s.seeTitle}</h2><p class="section-subtitle">{s.seeBody}</p></div>
    <div class="mt-10 grid lg:grid-cols-[1.1fr_1fr] gap-8 items-start">
      <div class="rounded-3xl border border-slate-200 dark:border-slate-800 bg-slate-950 p-6 shadow-elevated"><div class="text-center"><span class="inline-flex h-12 w-12 items-center justify-center rounded-xl bg-brand-600 text-white"><i class="fa-solid fa-n"></i></span><div class="mt-3 text-lg font-bold text-white">Connect your accounts to Northwind Studio</div><div class="text-sm text-slate-400">Link the networks we will manage for you.</div></div><div class="mt-5 grid grid-cols-2 gap-2">{[['instagram', true], ['tiktok', false], ['linkedin', false], ['youtube', false], ['facebook', false], ['x', false]].map(([k, on]) => <div class={`rounded-xl border p-3 flex items-center gap-2 ${on ? 'border-emerald-500/50 bg-emerald-500/10' : 'border-slate-800 bg-slate-900'}`}><PlatformIcon platform={k as any} /><span class="text-sm text-white flex-1">{k === 'x' ? 'X' : String(k)[0].toUpperCase() + String(k).slice(1)}</span><span class={`text-[10px] rounded-md px-2 py-0.5 ${on ? 'bg-emerald-500 text-white' : 'bg-brand-600 text-white'}`}>{on ? 'Connected' : 'Connect'}</span></div>)}</div><div class="mt-5 text-center"><span class="btn-primary btn-sm">Back to Northwind Studio</span></div></div>
      <div><h3 class="text-xl font-bold text-slate-900 dark:text-white">{s.can}</h3><ul class="mt-4 space-y-3">{s.canList.map((x) => <li class="check-li">{x}</li>)}</ul><p class="mt-5 rounded-xl bg-brand-50 dark:bg-brand-500/10 p-4 text-sm text-slate-600 dark:text-slate-300"><i class="fa-solid fa-lock text-brand-500 mr-2"></i>{s.bound}</p></div>
    </div></div></section>
  <section class="lp-section-white"><div class="container-x"><div class="text-center reveal"><h2 class="section-title">{s.how}</h2><p class="section-subtitle">{s.howBody}</p></div><div class="mt-10 grid md:grid-cols-2 lg:grid-cols-5 gap-4">{s.steps.map(([t, d], i) => <div class="relative card p-5 reveal" style={`transition-delay:${i * 70}ms`}><span class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-brand-600 text-white text-sm font-bold">{i + 1}</span><h3 class="mt-3 font-semibold text-slate-900 dark:text-white">{t}</h3><p class="mt-2 text-xs text-slate-500 dark:text-slate-400 leading-relaxed">{d}</p></div>)}</div></div></section>
  <section class="lp-section-gray"><div class="container-x"><div class="text-center reveal"><h2 class="section-title">{s.options}</h2><p class="section-subtitle">{s.optionsBody}</p></div><div class="mt-8 card overflow-x-auto"><table class="w-full text-sm"><thead class="bg-slate-50 dark:bg-slate-900/60 text-left text-[11px] uppercase tracking-wider text-slate-400"><tr>{s.cols.map((c) => <th class="px-4 py-2.5">{c}</th>)}</tr></thead><tbody class="divide-y divide-slate-100 dark:divide-slate-800">{s.rows.map((r) => <tr><td class="px-4 py-2.5 font-medium text-slate-900 dark:text-white">{r[0]}</td><td class="px-4 py-2.5"><code class="font-mono text-xs">{r[1]}</code></td><td class="px-4 py-2.5 text-slate-500 dark:text-slate-400">{r[2]}</td><td class="px-4 py-2.5"><code class="font-mono text-[11px] text-slate-500">{r[3]}</code></td><td class="px-4 py-2.5"><i class="fa-solid fa-check text-emerald-500"></i></td></tr>)}</tbody></table></div></div></section>
  <FaqList title={fr ? 'Questions fréquentes' : 'Frequently asked questions'} items={s.faq} />
  <Cta title={s.title} subtitle={s.sub} label={s.cta} href={`/app/login?source=${lang}-whitelabel`} note={s.note} />
</BaseLayout>
