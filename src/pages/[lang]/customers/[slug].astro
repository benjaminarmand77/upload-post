---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PlatformIcon from '../../../components/PlatformIcon.astro';
import Cta from '../../../components/marketing/Cta.astro';
import { CUSTOMERS } from '../../../lib/showcase';
import type { PlatformKey } from '../../../lib/platforms';
import { isLang, localePath } from '../../../lib/i18n';
if (!isLang(Astro.params.lang!)) return new Response(null, { status: 404 });
const c = CUSTOMERS.find((x) => x.slug === Astro.params.slug); if (!c) return new Response(null, { status: 404 });
const lang = Astro.locals.lang; const fr = lang === 'fr'; const txt = fr ? 'fr' : 'en'; const L = (p: string) => localePath(lang, p);
const s = fr ? { back: 'Tous les témoignages', results: 'Résultats', how: 'Comment ils utilisent Upload-Post', steps: ['Un profil Upload-Post par compte ou par client.', 'Connexion des réseaux en deux clics, sans app développeur.', 'Publication et programmation via l\'API, n8n, Make ou le tableau de bord.', 'Suivi des performances dans l\'analytique unifiée.'] } : { back: 'All stories', results: 'Results', how: 'How they use Upload-Post', steps: ['One Upload-Post profile per account or client.', 'Networks connected in two clicks, no developer app.', 'Publishing and scheduling through the API, n8n, Make or the dashboard.', 'Performance tracking in the unified analytics.'] };
---
<BaseLayout title={`${c.name} — ${c.industry[txt]} | Upload-Post`} description={c.summary[txt]}>
  <section class="bg-white dark:bg-slate-950 pt-10 pb-12"><div class="container-x max-w-4xl"><a href={L('/customers/')} class="text-xs text-slate-500 hover:text-brand-500">← {s.back}</a><div class="mt-4 flex items-center gap-4"><span class="inline-flex h-16 w-16 items-center justify-center rounded-2xl text-white text-xl font-bold" style={`background:${c.color}`}>{c.initials}</span><div><h1 class="text-3xl md:text-4xl font-extrabold text-slate-900 dark:text-white">{c.name}</h1><div class="text-slate-500">{c.industry[txt]}</div></div></div><p class="mt-6 text-lg text-slate-600 dark:text-slate-300">{c.summary[txt]}</p><blockquote class="mt-8 rounded-2xl border-l-4 border-brand-500 bg-slate-50 dark:bg-slate-900 p-6 text-xl italic text-slate-800 dark:text-slate-100">“{c.quote[txt]}”<footer class="mt-3 text-sm not-italic text-slate-500">— {c.person}, {c.role[txt]}, {c.name}</footer></blockquote></div></section>
  <section class="lp-section-gray"><div class="container-x max-w-4xl grid md:grid-cols-[1fr_1.2fr] gap-6"><div class="card p-6"><h2 class="font-semibold text-slate-900 dark:text-white">{s.results}</h2><div class="mt-4 grid grid-cols-3 gap-3 text-center">{c.results.map((r) => <div class="rounded-xl bg-slate-100 dark:bg-slate-800 p-3"><div class="text-xl font-bold text-brand-600">{r.value}</div><div class="text-[11px] text-slate-500">{r.label[txt]}</div></div>)}</div><div class="mt-5 flex flex-wrap gap-2">{c.platforms.map((k) => <span class="inline-flex items-center gap-1.5 rounded-lg border border-slate-200 dark:border-slate-700 px-2 py-1 text-xs"><PlatformIcon platform={k as PlatformKey} size="text-xs" />{k}</span>)}</div></div><div class="card p-6"><h2 class="font-semibold text-slate-900 dark:text-white">{s.how}</h2><ul class="mt-4 space-y-3">{s.steps.map((x) => <li class="check-li">{x}</li>)}</ul></div></div></section>
  <Cta title={Astro.locals.t.home.useCases.title} label={Astro.locals.t.common.startFree} />
</BaseLayout>
