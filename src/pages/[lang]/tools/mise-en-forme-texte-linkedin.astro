---
import ToolLayout from '../../../layouts/ToolLayout.astro';
import { toolBySlug } from '../../../lib/content/tools';
import { isLang } from '../../../lib/i18n';
if (!isLang(Astro.params.lang!)) return new Response(null, { status: 404 });
const lang = Astro.locals.lang; const fr = lang === 'fr'; const tool = toolBySlug('mise-en-forme-texte-linkedin')!;
const s = fr ? { write: 'Rédigez votre post', example: 'Essayer un exemple', hint: 'Sélectionnez du texte, puis cliquez sur un bouton ou faites Ctrl+B, Ctrl+I, Ctrl+U. Recommencez pour retirer le style.', chars: 'caractères', copy: 'Copier le post', schedule: 'Programmez-le sur LinkedIn avec Upload-Post', preview: 'Aperçu dans le fil', desktop: 'Ordinateur', mobile: 'Mobile', name: 'Votre nom', title: 'Votre titre', now: 'À l\'instant', ph: 'Votre post s\'affichera ici, coupé comme dans le fil.', more: '…voir plus', cut: 'La coupure est une estimation : environ 210 caractères ou 3 lignes sur ordinateur (140 sur mobile), selon ce qui arrive en premier.', sample: 'On a fait la semaine de 4 jours pendant six mois.\n\nVoici ce qui a changé :\nRéunions plus courtes\nPas de réunion le vendredi\nPoints d\'avancement par écrit\n\nMon livre de l\'année : Sapiens' } : { write: 'Write your post', example: 'Try an example', hint: 'Select text, then click a button or press Ctrl+B, Ctrl+I, Ctrl+U. Repeat to remove the style.', chars: 'characters', copy: 'Copy post', schedule: 'Schedule it on LinkedIn with Upload-Post', preview: 'Feed preview', desktop: 'Desktop', mobile: 'Mobile', name: 'Your name', title: 'Your headline', now: 'Just now', ph: 'Your post will appear here, cut like in the feed.', more: '…see more', cut: 'The cut is an estimate: about 210 characters or 3 lines on desktop (140 on mobile), whichever comes first.', sample: 'We tried the 4-day week for six months.\n\nHere is what changed:\nShorter meetings\nNo meetings on Friday\nWritten status updates\n\nMy book of the year: Sapiens' };
---
<ToolLayout tool={tool}>
  <div class="grid lg:grid-cols-2 gap-6" id="lf" data-s={JSON.stringify(s)}>
    <div class="card p-5"><div class="flex items-center justify-between mb-2"><label class="label !mb-0">{s.write}</label><button type="button" id="example" class="text-xs text-brand-600">{s.example}</button></div>
      <div class="flex flex-wrap gap-1 mb-2">{[['bold_sans', 'B', 'font-bold'], ['italic_sans', 'I', 'italic'], ['bold_italic_sans', 'BI', 'font-bold italic'], ['underline', 'U', 'underline'], ['strike', 'S', 'line-through']].map(([k, l, c]) => <button type="button" data-fmt={k} class={`h-8 min-w-8 px-2 rounded-lg border border-slate-200 dark:border-slate-700 text-sm ${c}`}>{l}</button>)}<button type="button" data-list="bullet" class="h-8 px-2 rounded-lg border border-slate-200 dark:border-slate-700 text-sm"><i class="fa-solid fa-list-ul"></i></button><button type="button" data-list="number" class="h-8 px-2 rounded-lg border border-slate-200 dark:border-slate-700 text-sm"><i class="fa-solid fa-list-ol"></i></button><button type="button" data-clear class="h-8 px-2 rounded-lg border border-slate-200 dark:border-slate-700 text-sm" title="clear"><i class="fa-solid fa-eraser"></i></button></div>
      <textarea id="src" rows="12" class="input"></textarea><p class="help">{s.hint}</p><div class="mt-2 flex items-center justify-between text-xs text-slate-500"><span><b id="cnt">0</b> / 3 000 {s.chars}</span><button type="button" class="btn-primary btn-sm" id="copy"><i class="fa-regular fa-copy"></i>{s.copy}</button></div><a href={`/app/login?source=${lang}-tools-linkedin`} class="mt-3 inline-block text-sm text-brand-600 dark:text-brand-400">{s.schedule} →</a></div>
    <div class="card p-5"><div class="flex items-center justify-between mb-3"><h3 class="font-semibold text-slate-900 dark:text-white">{s.preview}</h3><div class="inline-flex rounded-lg border border-slate-200 dark:border-slate-700 p-0.5 text-xs"><button type="button" data-view="desktop" class="rounded-md px-2 py-1 bg-brand-600 text-white">{s.desktop}</button><button type="button" data-view="mobile" class="rounded-md px-2 py-1">{s.mobile}</button></div></div>
      <div id="pv" class="rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 p-4 mx-auto transition-all" style="max-width:520px"><div class="flex items-center gap-3"><span class="h-10 w-10 rounded-full bg-slate-300 dark:bg-slate-700"></span><div><div class="text-sm font-semibold text-slate-900 dark:text-white">{s.name}</div><div class="text-xs text-slate-500">{s.title}</div><div class="text-[11px] text-slate-400">{s.now} · <i class="fa-solid fa-earth-americas"></i></div></div></div><div id="pv-text" class="mt-3 text-sm whitespace-pre-wrap text-slate-800 dark:text-slate-100">{s.ph}</div><div class="mt-3 flex gap-4 text-xs text-slate-500 border-t border-slate-100 dark:border-slate-800 pt-3"><span><i class="fa-regular fa-thumbs-up"></i> Like</span><span><i class="fa-regular fa-comment"></i> Comment</span><span><i class="fa-solid fa-retweet"></i> Repost</span><span><i class="fa-regular fa-paper-plane"></i> Send</span></div></div><p class="help mt-3">{s.cut}</p></div>
  </div>
  <script>
    import { STYLES } from '../../../lib/unicode-fonts';
    const root = document.getElementById('lf')!; const S = JSON.parse(root.dataset.s!); const src = document.getElementById('src') as HTMLTextAreaElement; let view = 'desktop';
    const INV: Record<string, string> = {}; for (const [k, st] of Object.entries(STYLES)) { if (!['bold_sans', 'italic_sans', 'bold_italic_sans', 'bold_serif', 'italic', 'bold_italic'].includes(k)) continue; const plain = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789'; const styled = [...st.fn(plain)]; styled.forEach((ch, i) => { if (ch !== plain[i]) INV[ch] = plain[i]; }); }
    const unstyle = (s: string) => [...s.replace(/[̶̲]/g, '')].map((c) => INV[c] ?? c).join('');
    const apply = (k: string) => { const a = src.selectionStart, b = src.selectionEnd; if (a === b) return; const sel = src.value.slice(a, b); const plain = unstyle(sel); const already = STYLES[k].fn(plain) === sel; const out = already ? plain : STYLES[k].fn(plain); src.setRangeText(out, a, b, 'select'); render(); };
    root.querySelectorAll<HTMLElement>('[data-fmt]').forEach((b) => b.addEventListener('click', () => apply(b.dataset.fmt!)));
    root.querySelectorAll<HTMLElement>('[data-list]').forEach((b) => b.addEventListener('click', () => { const a = src.selectionStart, e = src.selectionEnd; const start = src.value.lastIndexOf('\n', a - 1) + 1; const end = src.value.indexOf('\n', e) === -1 ? src.value.length : src.value.indexOf('\n', e); const lines = src.value.slice(start, end).split('\n'); const out = lines.map((l, i) => { const bare = l.replace(/^(• |\d+\. )/, ''); return b.dataset.list === 'bullet' ? `• ${bare}` : `${i + 1}. ${bare}`; }).join('\n'); src.setRangeText(out, start, end, 'select'); render(); }));
    root.querySelector('[data-clear]')!.addEventListener('click', () => { src.value = unstyle(src.value); render(); });
    src.addEventListener('keydown', (e) => { if ((e.ctrlKey || e.metaKey) && ['b', 'i', 'u'].includes(e.key.toLowerCase())) { e.preventDefault(); apply({ b: 'bold_sans', i: 'italic_sans', u: 'underline' }[e.key.toLowerCase()]!); } });
    document.getElementById('example')!.addEventListener('click', () => { src.value = S.sample; render(); });
    document.getElementById('copy')!.addEventListener('click', async () => { await navigator.clipboard.writeText(src.value); (document.getElementById('copy') as HTMLElement).innerHTML = '<i class="fa-solid fa-check"></i> ✓'; });
    root.querySelectorAll<HTMLElement>('[data-view]').forEach((b) => b.addEventListener('click', () => { view = b.dataset.view!; root.querySelectorAll<HTMLElement>('[data-view]').forEach((x) => { x.classList.toggle('bg-brand-600', x === b); x.classList.toggle('text-white', x === b); }); (document.getElementById('pv') as HTMLElement).style.maxWidth = view === 'mobile' ? '340px' : '520px'; render(); }));
    const render = () => { const v = src.value; const len = [...v].length; document.getElementById('cnt')!.textContent = String(len); const limit = view === 'mobile' ? 140 : 210; const lines = v.split('\n'); let cut = v; let truncated = false; if (len > limit) { cut = [...v].slice(0, limit).join(''); truncated = true; } else if (lines.length > 3) { cut = lines.slice(0, 3).join('\n'); truncated = true; } const el = document.getElementById('pv-text')!; el.textContent = cut || S.ph; if (truncated) { const m = document.createElement('span'); m.className = 'text-slate-500'; m.textContent = ' ' + S.more; el.appendChild(m); } };
    src.addEventListener('input', render); render();
  </script>
  <Fragment slot="content">{fr ? <><h2>Pourquoi LinkedIn n'a pas de bouton gras dans les posts</h2><p>La zone de saisie des posts LinkedIn n'accepte que du texte brut. Seul l'éditeur d'articles et de newsletters propose des boutons de mise en forme. Pour avoir du gras ou de l'italique dans un post classique, l'outil remplace vos lettres par des caractères Unicode qui leur ressemblent (𝗕 au lieu de B), que LinkedIn enregistre et affiche comme n'importe quel texte.</p><h2>Où tombe la coupure « …voir plus »</h2><p>Le fil affiche le début de votre post et cache la suite derrière « …voir plus ». LinkedIn ne documente pas l'endroit exact. En pratique, on voit à peu près les 210 premiers caractères sur ordinateur et environ 140 sur téléphone, et le texte s'arrête aussi après environ trois lignes. Les lignes vides comptent comme des lignes.</p><h2>Avant de publier</h2><ul><li>Mettez quelques mots en gras, pas des paragraphes entiers. Les lecteurs d'écran peuvent lire les lettres stylisées une par une.</li><li>Laissez les hashtags, les @mentions et les liens en texte normal.</li><li>La recherche LinkedIn ne trouve pas vos mots stylisés.</li></ul></> : <><h2>Why LinkedIn has no bold button in posts</h2><p>The LinkedIn post box only accepts plain text. Only the article and newsletter editor has formatting buttons. To get bold or italic in a regular post, the tool replaces your letters with look-alike Unicode characters (𝗕 instead of B), which LinkedIn stores and displays like any text.</p><h2>Where the "…see more" cut falls</h2><p>The feed shows the start of your post and hides the rest behind "…see more". LinkedIn does not document the exact spot. In practice you see roughly the first 210 characters on desktop and about 140 on phones, and the text also stops after about three lines. Empty lines count as lines.</p><h2>Before publishing</h2><ul><li>Bold a few words, not whole paragraphs. Screen readers may read styled letters one by one.</li><li>Leave hashtags, @mentions and links as normal text.</li><li>LinkedIn search does not find your styled words.</li></ul></>}</Fragment>
</ToolLayout>
