---
import ToolLayout from '../../../layouts/ToolLayout.astro';
import { toolBySlug } from '../../../lib/content/tools';
import { isLang } from '../../../lib/i18n';
if (!isLang(Astro.params.lang!)) return new Response(null, { status: 404 });
const lang = Astro.locals.lang; const fr = lang === 'fr'; const tool = toolBySlug('font-generator')!;
const keys = ['bold_serif', 'italic', 'script', 'mono', 'double', 'fraktur', 'circled', 'small_caps', 'wide', 'bold_sans', 'script_bold', 'bold_italic'];
---
<ToolLayout tool={tool}>
  <div id="fg" data-lang={lang}><div class="card p-5 mb-5"><input id="src" class="input text-lg" placeholder={fr ? 'Tapez votre texte ici...' : 'Type your text here...'} value={fr ? 'Tapez votre texte ici...' : 'Type your text here...'} /></div>
  <div class="grid sm:grid-cols-2 gap-3">{keys.map((k) => <div class="card p-4 flex items-center gap-3" data-style={k}><div class="flex-1 min-w-0"><div class="text-xs font-semibold text-slate-500" data-label></div><div class="mt-1 break-words text-slate-900 dark:text-white text-lg" data-val></div></div><button type="button" class="btn-secondary btn-sm" data-copybtn><i class="fa-regular fa-copy"></i></button></div>)}</div></div>
  <script>
    import { STYLES } from '../../../lib/unicode-fonts';
    const root = document.getElementById('fg')!; const lang = root.dataset.lang === 'fr' ? 'fr' : 'en'; const src = document.getElementById('src') as HTMLInputElement;
    const render = () => root.querySelectorAll<HTMLElement>('[data-style]').forEach((el) => { const st = STYLES[el.dataset.style!]; el.querySelector('[data-label]')!.textContent = st[lang]; el.querySelector('[data-val]')!.textContent = st.fn(src.value || ''); });
    src.addEventListener('input', render); render();
    root.addEventListener('click', async (e) => { const b = (e.target as HTMLElement).closest('[data-copybtn]'); if (!b) return; await navigator.clipboard.writeText(b.parentElement!.querySelector('[data-val]')!.textContent || ''); b.innerHTML = '<i class="fa-solid fa-check"></i>'; setTimeout(() => (b.innerHTML = '<i class="fa-regular fa-copy"></i>'), 1200); });
  </script>
  <Fragment slot="content">{fr ? <><h2>Comment fonctionne le générateur de polices ?</h2><p>Ces « polices » ne sont pas de vraies polices mais des caractères Unicode spéciaux qui ressemblent à des lettres stylisées. Vous pouvez donc les copier-coller presque partout : bios Instagram, tweets, publications Facebook, pseudos de jeux, etc.</p><h3>Conseils d'utilisation</h3><ul><li><strong>Démarquez-vous</strong> : utilisez-les pour mettre en valeur les mots-clés dans votre bio ou vos légendes.</li><li><strong>Accessibilité</strong> : les lecteurs d'écran peuvent mal lire ces caractères. Utilisez-les avec parcimonie et jamais pour une information essentielle.</li></ul></> : <><h2>How does the font generator work?</h2><p>These "fonts" are not real fonts but special Unicode characters that look like stylized letters. You can copy and paste them almost anywhere: Instagram bios, tweets, Facebook posts, game usernames and more.</p><h3>Usage tips</h3><ul><li><strong>Stand out</strong>: use them to highlight keywords in your bio or captions.</li><li><strong>Accessibility</strong>: screen readers may struggle with these characters. Use them sparingly and never for critical information.</li></ul></>}</Fragment>
</ToolLayout>
