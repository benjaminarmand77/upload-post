---
import ToolLayout from '../../../layouts/ToolLayout.astro';
import { toolBySlug } from '../../../lib/content/tools';
import { isLang } from '../../../lib/i18n';
if (!isLang(Astro.params.lang!)) return new Response(null, { status: 404 });
const lang = Astro.locals.lang; const fr = lang === 'fr'; const tool = toolBySlug('calcul-taux-engagement')!;
const s = fr ? { inter: 'Interactions', likes: 'J\'aime', comments: 'Commentaires', shares: 'Partages', saves: 'Enregistrements (facultatif)', aud: 'Audience', followers: 'Abonnés', reach: 'Couverture', reachH: 'Comptes touchés', imp: 'Impressions', impH: 'Ou vues', posts: 'Nombre de posts', postsH: 'Pour plusieurs posts, saisissez les totaux', total: 'Interactions', byF: 'Par abonnés', byR: 'Par couverture', byI: 'Par impressions', f1: 'Pour comparer des comptes, y compris des concurrents, puisque le nombre d\'abonnés est public.', f2: 'Pour juger le contenu lui-même : combien de personnes l\'ayant vu ont réagi.', f3: 'Pour comparer avec la publicité et avec les plateformes qui donnent des vues plutôt qu\'une couverture.', add: 'Ajoutez', see: 'pour le voir', perPost: 'par post' } : { inter: 'Interactions', likes: 'Likes', comments: 'Comments', shares: 'Shares', saves: 'Saves (optional)', aud: 'Audience', followers: 'Followers', reach: 'Reach', reachH: 'Accounts reached', imp: 'Impressions', impH: 'Or views', posts: 'Number of posts', postsH: 'For several posts, enter totals', total: 'Interactions', byF: 'By followers', byR: 'By reach', byI: 'By impressions', f1: 'To compare accounts, including competitors, since follower counts are public.', f2: 'To judge the content itself: how many of those who saw it reacted.', f3: 'To compare with ads and with platforms that report views rather than reach.', add: 'Add', see: 'to see it', perPost: 'per post' };
---
<ToolLayout tool={tool}>
  <div class="grid lg:grid-cols-[1fr_1.2fr] gap-6" id="er" data-s={JSON.stringify(s)} data-lang={lang}>
    <form class="card p-5 space-y-4"><div><div class="text-xs font-semibold uppercase tracking-wider text-slate-400 mb-2">{s.inter}</div><div class="grid grid-cols-2 gap-3">{[['likes', s.likes, 420], ['comments', s.comments, 35], ['shares', s.shares, 12], ['saves', s.saves, '']].map(([k, l, v]) => <div><label class="label">{l}</label><input name={k} type="number" min="0" class="input" value={v} /></div>)}</div></div>
      <div><div class="text-xs font-semibold uppercase tracking-wider text-slate-400 mb-2">{s.aud}</div><div class="grid grid-cols-2 gap-3"><div><label class="label">{s.followers}</label><input name="followers" type="number" min="0" class="input" value="18000" /></div><div><label class="label">{s.reach}</label><input name="reach" type="number" min="0" class="input" value="9500" /><p class="help">{s.reachH}</p></div><div><label class="label">{s.imp}</label><input name="impressions" type="number" min="0" class="input" /><p class="help">{s.impH}</p></div><div><label class="label">{s.posts}</label><input name="posts" type="number" min="1" class="input" value="1" /><p class="help">{s.postsH}</p></div></div></div></form>
    <div class="space-y-4"><div class="text-sm text-slate-500" id="tot"></div>{[['f', s.byF, s.f1], ['r', s.byR, s.f2], ['i', s.byI, s.f3]].map(([k, t, d]) => <div class="card p-5"><div class="text-xs font-semibold uppercase tracking-wider text-slate-400">{t}</div><div class="mt-1 text-3xl font-extrabold text-brand-600 dark:text-brand-400" data-val={k}>—</div><div class="text-xs font-mono text-slate-500 mt-1" data-formula={k}></div><p class="mt-2 text-sm text-slate-500">{d}</p></div>)}</div>
  </div>
  <script>
    const root = document.getElementById('er')!; const S = JSON.parse(root.dataset.s!); const lang = root.dataset.lang!; const form = root.querySelector('form')!;
    const n = (k: string) => Number((form.elements.namedItem(k) as HTMLInputElement).value) || 0; const f = (x: number) => x.toLocaleString(lang); const pct = (x: number) => x.toLocaleString(lang, { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' %';
    const render = () => { const posts = Math.max(1, n('posts')); const I = n('likes') + n('comments') + n('shares') + n('saves'); const parts = [n('likes'), n('comments'), n('shares')].concat(n('saves') ? [n('saves')] : []).map(f).join(' + '); document.getElementById('tot')!.textContent = `${S.total} : ${f(I)}${posts > 1 ? ` (${f(I / posts)} ${S.perPost})` : ''}`; const set = (k: string, denom: number, label: string, perPost: boolean) => { const v = root.querySelector(`[data-val="${k}"]`)!, fo = root.querySelector(`[data-formula="${k}"]`)!; if (!denom) { v.textContent = `${S.add} ${label.toLowerCase()} ${S.see}`; (v as HTMLElement).className = 'mt-1 text-base text-slate-400'; fo.textContent = `(${parts}) ÷ ${label.toLowerCase()} × 100`; return; } const val = perPost ? (I / posts) / denom * 100 : I / denom * 100; v.textContent = pct(val); (v as HTMLElement).className = 'mt-1 text-3xl font-extrabold text-brand-600 dark:text-brand-400'; fo.textContent = `(${parts})${perPost && posts > 1 ? ` ÷ ${posts}` : ''} ÷ ${f(denom)} ${label.toLowerCase()} × 100 = ${pct(val)}`; }; set('f', n('followers'), S.followers, true); set('r', n('reach'), S.reach, false); set('i', n('impressions'), S.imp, false); };
    form.addEventListener('input', render); render();
  </script>
  <Fragment slot="content">{fr ? <><h2>Les trois formules et quand utiliser chacune</h2><p><strong>Par abonnés</strong> = interactions ÷ abonnés × 100. Pour comparer des comptes, y compris des concurrents. Elle pénalise les comptes dont les posts touchent peu de leurs abonnés.</p><p><strong>Par couverture</strong> = interactions ÷ couverture × 100. Pour juger le contenu : parmi les personnes qui l'ont vu, combien ont réagi. Seul le propriétaire du compte voit la couverture.</p><p><strong>Par impressions</strong> = interactions ÷ impressions × 100. À utiliser à côté des campagnes payantes, ou sur les plateformes qui donnent des vues au lieu d'une couverture. C'est en général le plus bas des trois.</p><h2>Qu'est-ce qu'un bon taux d'engagement ?</h2><p>Cela dépend de la plateforme, du secteur et de la taille du compte. Comme repère public, le rapport Rival IQ 2026 donne ces médianes tous secteurs confondus, calculées par post et par abonnés :</p><table><thead><tr><th>Plateforme</th><th>Taux médian par post, par abonnés</th></tr></thead><tbody><tr><td>TikTok</td><td>2,01 %</td></tr><tr><td>Instagram</td><td>0,30 %</td></tr><tr><td>YouTube</td><td>0,21 %</td></tr><tr><td>X</td><td>0,03 %</td></tr></tbody></table><h2>Questions fréquentes</h2><h3>Faut-il compter les enregistrements dans l'engagement ?</h3><p>Beaucoup de marketeurs les comptent sur Instagram et TikTok, mais tous les rapports ne le font pas. Laissez le champ vide pour vous comparer à un repère qui ne les inclut pas.</p><h3>Le taux par couverture peut-il dépasser 100 % ?</h3><p>Oui, dans de rares cas : une même personne peut aimer, commenter et partager. Cela signale une petite audience très active, ou un chiffre de couverture trop bas.</p></> : <><h2>The three formulas and when to use each</h2><p><strong>By followers</strong> = interactions ÷ followers × 100. To compare accounts, including competitors. It penalizes accounts whose posts reach few of their followers.</p><p><strong>By reach</strong> = interactions ÷ reach × 100. To judge the content: among the people who saw it, how many reacted. Only the account owner sees reach.</p><p><strong>By impressions</strong> = interactions ÷ impressions × 100. Use it alongside paid campaigns, or on platforms that report views instead of reach. Usually the lowest of the three.</p><h2>What is a good engagement rate?</h2><p>It depends on the platform, industry and account size. As a public benchmark, the Rival IQ 2026 report gives these all-industry medians, per post and by followers:</p><table><thead><tr><th>Platform</th><th>Median rate per post, by followers</th></tr></thead><tbody><tr><td>TikTok</td><td>2.01%</td></tr><tr><td>Instagram</td><td>0.30%</td></tr><tr><td>YouTube</td><td>0.21%</td></tr><tr><td>X</td><td>0.03%</td></tr></tbody></table><h2>FAQ</h2><h3>Should saves count as engagement?</h3><p>Many marketers count them on Instagram and TikTok, but not every report does. Leave the field empty to compare with a benchmark that excludes them.</p><h3>Can the rate by reach exceed 100%?</h3><p>Yes, rarely: one person can like, comment and share. It usually signals a small, very active audience or a reach figure that is too low.</p></>}</Fragment>
</ToolLayout>
