---
import ToolLayout from '../../../layouts/ToolLayout.astro';
import { toolBySlug } from '../../../lib/content/tools';
import { isLang } from '../../../lib/i18n';
if (!isLang(Astro.params.lang!)) return new Response(null, { status: 404 });
const lang = Astro.locals.lang; const fr = lang === 'fr'; const tool = toolBySlug('social-media-holiday-calendar')!;
const E: [string, string, string, string][] = [['01-01', 'Jour de l\'An', 'New Year\'s Day', 'Global'], ['01-20', 'Blue Monday', 'Blue Monday', 'Fun'], ['02-04', 'Journée mondiale contre le cancer', 'World Cancer Day', 'Awareness'], ['02-14', 'Saint-Valentin', 'Valentine\'s Day', 'Culture'], ['03-08', 'Journée internationale des femmes', 'International Women\'s Day', 'Awareness'], ['03-20', 'Journée internationale du bonheur', 'International Day of Happiness', 'Fun'], ['04-01', 'Poisson d\'avril', 'April Fools\' Day', 'Fun'], ['04-22', 'Journée de la Terre', 'Earth Day', 'Environment'], ['05-01', 'Fête du Travail', 'Labour Day', 'Global'], ['05-04', 'Star Wars Day', 'Star Wars Day', 'Fun'], ['06-05', 'Journée mondiale de l\'environnement', 'World Environment Day', 'Environment'], ['06-21', 'Journée internationale du yoga', 'International Yoga Day', 'Health'], ['06-30', 'Journée mondiale des réseaux sociaux', 'Social Media Day', 'Social Media'], ['07-17', 'Journée mondiale de l\'emoji', 'World Emoji Day', 'Social Media'], ['07-30', 'Journée internationale de l\'amitié', 'International Friendship Day', 'Culture'], ['08-12', 'Journée internationale de la jeunesse', 'International Youth Day', 'Awareness'], ['08-19', 'Journée mondiale de la photographie', 'World Photography Day', 'Art'], ['09-21', 'Journée internationale de la paix', 'International Day of Peace', 'Awareness'], ['09-27', 'Journée mondiale du tourisme', 'World Tourism Day', 'Travel'], ['10-01', 'Journée mondiale du café', 'International Coffee Day', 'Food'], ['10-10', 'Journée mondiale de la santé mentale', 'World Mental Health Day', 'Health'], ['10-31', 'Halloween', 'Halloween', 'Culture'], ['11-13', 'Journée mondiale de la gentillesse', 'World Kindness Day', 'Awareness'], ['11-28', 'Black Friday', 'Black Friday', 'Shopping'], ['12-01', 'Cyber Monday', 'Cyber Monday', 'Shopping'], ['12-25', 'Jour de Noël', 'Christmas Day', 'Culture'], ['12-31', 'Réveillon du Nouvel An', 'New Year\'s Eve', 'Global']];
const months = Array.from({ length: 12 }, (_, i) => new Date(2026, i, 1).toLocaleDateString(lang, { month: 'long' }));
const cats = [...new Set(E.map((e) => e[3]))];
const s = fr ? { date: 'Date', event: 'Événement', cat: 'Catégorie', all: 'Toutes', month: 'Mois', ics: 'Exporter (.ics)', plan: 'Programmer avec Upload-Post' } : { date: 'Date', event: 'Event', cat: 'Category', all: 'All', month: 'Month', ics: 'Export (.ics)', plan: 'Schedule with Upload-Post' };
---
<ToolLayout tool={tool}>
  <div class="card overflow-hidden" id="hc"><div class="p-4 flex flex-wrap gap-2 border-b border-slate-100 dark:border-slate-800"><select id="month" class="input input-select !w-auto !py-2 text-sm"><option value="">{s.month}: {s.all}</option>{months.map((m, i) => <option value={String(i + 1).padStart(2, '0')}>{m}</option>)}</select><select id="cat" class="input input-select !w-auto !py-2 text-sm"><option value="">{s.cat}: {s.all}</option>{cats.map((c) => <option value={c}>{c}</option>)}</select><button type="button" id="ics" class="btn-secondary btn-sm ml-auto"><i class="fa-regular fa-calendar"></i>{s.ics}</button></div>
    <table class="w-full text-sm"><thead class="bg-slate-50 dark:bg-slate-900/60 text-left text-[11px] uppercase tracking-wider text-slate-400"><tr><th class="px-4 py-2.5">{s.date}</th><th class="px-4 py-2.5">{s.event}</th><th class="px-4 py-2.5">{s.cat}</th><th class="px-4 py-2.5"></th></tr></thead><tbody class="divide-y divide-slate-100 dark:divide-slate-800">{E.map(([d, f, e, c]) => <tr data-m={d.slice(0, 2)} data-c={c}><td class="px-4 py-2.5 whitespace-nowrap text-slate-500">{new Date(`2026-${d}T12:00:00`).toLocaleDateString(lang, { day: 'numeric', month: 'long' })}</td><td class="px-4 py-2.5 font-medium text-slate-900 dark:text-white">{fr ? f : e}</td><td class="px-4 py-2.5"><span class="chip">{c}</span></td><td class="px-4 py-2.5 text-right"><a href={`/app/upload?title=${encodeURIComponent(fr ? f : e)}`} class="text-xs text-brand-600 hover:underline">{s.plan}</a></td></tr>)}</tbody></table></div>
  <script define:vars={{ events: E.map(([d, f, e]) => [d, f, e]), fr }}>
    const m = document.getElementById('month'), c = document.getElementById('cat');
    const filter = () => document.querySelectorAll('#hc tbody tr').forEach((r) => { r.style.display = (!m.value || r.dataset.m === m.value) && (!c.value || r.dataset.c === c.value) ? '' : 'none'; });
    m.addEventListener('change', filter); c.addEventListener('change', filter);
    document.getElementById('ics').addEventListener('click', () => { const y = new Date().getFullYear(); const lines = ['BEGIN:VCALENDAR', 'VERSION:2.0', 'PRODID:-//Upload-Post//Holiday Calendar//EN']; for (const [d, f, e] of events) { const ds = `${y}${d.replace('-', '')}`; lines.push('BEGIN:VEVENT', `UID:${ds}-${e.replace(/\W/g, '')}@upload-post`, `DTSTART;VALUE=DATE:${ds}`, `SUMMARY:${fr ? f : e}`, 'END:VEVENT'); } lines.push('END:VCALENDAR'); const a = document.createElement('a'); a.href = URL.createObjectURL(new Blob([lines.join('\r\n')], { type: 'text/calendar' })); a.download = 'social-media-holidays.ics'; a.click(); });
  </script>
  <Fragment slot="content">{fr ? <><h2>Boostez votre marketing avec le calendrier des fêtes des réseaux sociaux</h2><p>Le marketing saisonnier est une stratégie puissante. S'appuyer sur les fêtes et les « journées mondiales » permet de rejoindre votre audience sur des sujets tendance et de montrer le côté humain de votre marque.</p><h3>Comment utiliser ce calendrier</h3><ul><li><strong>Planifiez à l'avance</strong> : consultez le calendrier au début de chaque mois.</li><li><strong>Soyez pertinent</strong> : choisissez les fêtes qui correspondent à votre marque et votre audience.</li><li><strong>Préparez le contenu</strong> : créez des visuels ou vidéos thématiques, puis programmez-les avec Upload-Post sur tous vos réseaux en une fois.</li></ul></> : <><h2>Boost your marketing with the social media holiday calendar</h2><p>Seasonal marketing is a powerful strategy. Leveraging holidays and "world days" lets you connect with your audience on trending topics and show the human side of your brand.</p><h3>How to use this calendar</h3><ul><li><strong>Plan ahead</strong>: check the calendar at the start of each month.</li><li><strong>Stay relevant</strong>: pick the holidays that fit your brand and audience.</li><li><strong>Prepare content</strong>: create themed visuals or videos, then schedule them with Upload-Post on all your networks at once.</li></ul></>}</Fragment>
</ToolLayout>
