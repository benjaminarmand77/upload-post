---
import ToolLayout from '../../../layouts/ToolLayout.astro';
import { toolBySlug } from '../../../lib/content/tools';
import { TT_GEO } from '../../../lib/content/rpm';
import { isLang } from '../../../lib/i18n';
if (!isLang(Astro.params.lang!)) return new Response(null, { status: 404 });
const lang = Astro.locals.lang; const fr = lang === 'fr'; const tool = toolBySlug('calculateur-revenus-tiktok')!; const txt = fr ? 'fr' : 'en';
const s = fr ? { views: 'Vues qualifiées', viewsH: 'Affichées dans TikTok Studio > Creator Rewards. Ce ne sont pas vos vues totales.', are: 'Ces vues sont', perVideo: 'Par vidéo', perMonth: 'Par mois', geo: 'D\'où viennent la plupart des vues qualifiées', geoH: 'Les vues venant de pays hors des 8 pays du programme ne comptent jamais.', q: 'Une vue n\'est qualifiée que si', ql: ['la vidéo est originale et dure plus d\'une minute', 'elle a été regardée au moins 5 secondes dans le fil Pour toi (30 secondes pour la Recherche)', 'elle vient d\'un spectateur unique situé dans un pays du programme, sans être payée, sponsorisée ni fausse'], est: 'Creator Rewards estimés', perMo: 'par mois', usd: 'en dollars américains', rpm: 'RPM utilisé', per1000: 'pour 1 000 vues qualifiées', src: 'Sources', note: 'Creator Rewards uniquement, avant impôts. Les cadeaux en LIVE, les abonnements, TikTok Shop et les partenariats de marque ne sont pas inclus.', cta: 'Plus de vidéos de plus d\'une minute, c\'est plus de vues qualifiées. Upload-Post publie et programme la même vidéo sur TikTok, YouTube et Instagram en une seule fois.', try: 'Essayer Upload-Post →', yearly: 'sur 12 mois à ce rythme', min: 'sous le minimum de 50 $US fixé par TikTok pour retirer les récompenses' } : { views: 'Qualified views', viewsH: 'Shown in TikTok Studio > Creator Rewards. Not your total views.', are: 'These views are', perVideo: 'Per video', perMonth: 'Per month', geo: 'Where most qualified views come from', geoH: 'Views from outside the 8 program countries never count.', q: 'A view only qualifies if', ql: ['the video is original and longer than one minute', 'it was watched at least 5 seconds in the For You feed (30 seconds from Search)', 'it comes from a unique viewer in a program country, not paid, sponsored or fake'], est: 'Estimated Creator Rewards', perMo: 'per month', usd: 'in US dollars', rpm: 'RPM used', per1000: 'per 1,000 qualified views', src: 'Sources', note: 'Creator Rewards only, before taxes. LIVE gifts, subscriptions, TikTok Shop and brand deals are not included.', cta: 'More videos over one minute means more qualified views. Upload-Post publishes and schedules the same video to TikTok, YouTube and Instagram in one go.', try: 'Try Upload-Post →', yearly: 'over 12 months at this pace', min: 'below the $50 minimum TikTok sets to withdraw rewards' };
const cur = fr ? 'eur' : 'usd';
---
<ToolLayout tool={tool}>
  <div class="grid lg:grid-cols-[1fr_1fr] gap-6" id="tt" data-geo={JSON.stringify(TT_GEO)} data-cur={cur} data-lang={lang} data-s={JSON.stringify(s)}>
    <form class="card p-5 space-y-4"><div class="grid grid-cols-2 gap-3"><div><label class="label">{s.views}</label><input name="views" type="number" min="0" class="input" value="500000" /><p class="help">{s.viewsH}</p></div><div><label class="label">{s.are}</label><select name="period" class="input input-select"><option value="video">{s.perVideo}</option><option value="month" selected>{s.perMonth}</option></select></div></div><div><label class="label">{s.geo}</label><select name="geo" class="input input-select">{TT_GEO.map((g) => <option value={g.key} selected={g.key === (fr ? 'defr' : 'us')}>{g[txt]}</option>)}</select><p class="help">{s.geoH}</p></div><div class="rounded-xl border border-slate-200 dark:border-slate-700 p-4 text-sm"><b class="text-slate-900 dark:text-white">{s.q}</b><ul class="mt-2 list-disc pl-5 space-y-1 text-slate-500">{s.ql.map((x) => <li>{x}</li>)}</ul></div></form>
    <div class="card p-5"><div class="text-xs font-semibold uppercase tracking-wider text-slate-400">{s.est} <span id="per"></span></div><div class="mt-2 text-3xl font-extrabold text-brand-600 dark:text-brand-400" id="main"></div><div class="text-xs text-slate-500" id="usd"></div><div class="mt-2 text-sm text-slate-500" id="yr"></div><div class="mt-4 text-sm"><b>{s.rpm}</b> : <span id="rpm"></span> {s.per1000}</div><div class="mt-3 rounded-lg bg-slate-100 dark:bg-slate-800 p-3 text-xs"><b>{s.src}</b><div id="src" class="mt-1 text-slate-500"></div></div><p class="mt-4 text-xs text-slate-500">{s.note}</p><p class="mt-4 text-sm text-slate-600 dark:text-slate-300">{s.cta}</p><a href={`/app/login?source=${lang}-tools-tiktok`} class="btn-primary btn-sm mt-3">{s.try}</a></div>
  </div>
  <script>
    const root = document.getElementById('tt')!; const G = JSON.parse(root.dataset.geo!), S = JSON.parse(root.dataset.s!); const cur = root.dataset.cur!, lang = root.dataset.lang!; const form = root.querySelector('form')!;
    const money = (usd: number) => cur === 'eur' ? (usd * 0.8724).toLocaleString(lang, { maximumFractionDigits: usd * 0.8724 < 100 ? 2 : 0 }) + ' €' : '$' + usd.toLocaleString(lang, { maximumFractionDigits: usd < 100 ? 2 : 0 });
    const render = () => { const v = Number((form.elements.namedItem('views') as HTMLInputElement).value) || 0; const g = G.find((x: any) => x.key === (form.elements.namedItem('geo') as HTMLSelectElement).value); const a = v / 1000 * g.rpm[0], b = v / 1000 * g.rpm[1]; const monthly = (form.elements.namedItem('period') as HTMLSelectElement).value === 'month'; document.getElementById('per')!.textContent = monthly ? S.perMo : ''; document.getElementById('main')!.textContent = `${money(a)} – ${money(b)}`; document.getElementById('usd')!.textContent = cur === 'eur' ? `($${a.toFixed(0)} – $${b.toFixed(0)} ${S.usd})` : ''; document.getElementById('yr')!.textContent = monthly ? `${money(a * 12)} – ${money(b * 12)} ${S.yearly}${b < 50 ? ' · ' + S.min : ''}` : b < 50 ? S.min : ''; document.getElementById('rpm')!.textContent = `$${g.rpm[0].toFixed(2)} – $${g.rpm[1].toFixed(2)}`; document.getElementById('src')!.textContent = g.src + ' × 0.85 (entertainment) – 1.3 (finance)'; };
    form.addEventListener('input', render); render();
  </script>
  <Fragment slot="content">{fr ? <><h2>Qui peut gagner de l'argent</h2><p>D'après les pages de TikTok : il faut avoir au moins 18 ans, au moins 10 000 abonnés et 100 000 vues de vidéos sur les 30 derniers jours, utiliser un compte personnel en règle et résider dans l'un de ces pays : États-Unis, Royaume-Uni, Allemagne, Japon, Corée du Sud, France, Mexique et Brésil. Les vidéos doivent être originales, durer plus d'une minute et atteindre au moins 1 000 vues dans le fil Pour toi.</p><p>La rémunération a deux parties. La Standard Reward dépend des vues qualifiées, du pays des spectateurs et de la langue du contenu. L'Additional Reward dépend du temps de visionnage, de la rétention, du taux de complétion et de la valeur en recherche.</p><h2>Méthode et sources</h2><p>TikTok ne publie pas de chiffres de RPM. Pour chaque pays, nous prenons le chiffre de marché d'Elev8or et le multiplions par leurs multiplicateurs de niche le plus bas et le plus haut (0,85× pour le divertissement, 1,3× pour la finance). Pour les audiences mixtes nous utilisons la fourchette d'Influencer Marketing Hub.</p><table><thead><tr><th>Audience</th><th>Retenu (USD pour 1 000 vues qualifiées)</th></tr></thead><tbody>{TT_GEO.map((g) => <tr><td>{g.fr}</td><td>${g.rpm[0].toFixed(2)} – ${g.rpm[1].toFixed(2)}</td></tr>)}</tbody></table><h2>Questions fréquentes</h2><h3>Combien rapporte 1 million de vues sur TikTok ?</h3><p>Si le million correspond à des vues qualifiées avec une audience mixte, cela donne environ 349 € à 872 €. S'il s'agit de vues totales, une partie seulement est qualifiée et le montant est plus bas.</p><h3>Quand TikTok paie-t-il ?</h3><p>Vous pouvez retirer vos récompenses le 15 de chaque mois dès que vous avez au moins 50 $US.</p></> : <><h2>Who can earn money</h2><p>According to TikTok's pages: you need to be at least 18, have at least 10,000 followers and 100,000 video views in the last 30 days, use a personal account in good standing and live in one of these countries: United States, United Kingdom, Germany, Japan, South Korea, France, Mexico and Brazil. Videos must be original, longer than one minute and reach at least 1,000 views in the For You feed.</p><p>Pay has two parts. The Standard Reward depends on qualified views, viewer country and content language. The Additional Reward depends on watch time, retention, completion rate and search value.</p><h2>Method and sources</h2><p>TikTok does not publish RPM figures. For each country we take Elev8or's market figure and multiply it by their lowest and highest niche multipliers (0.85× for entertainment, 1.3× for finance). For mixed audiences we use the Influencer Marketing Hub range.</p><table><thead><tr><th>Audience</th><th>Used (USD per 1,000 qualified views)</th></tr></thead><tbody>{TT_GEO.map((g) => <tr><td>{g.en}</td><td>${g.rpm[0].toFixed(2)} – ${g.rpm[1].toFixed(2)}</td></tr>)}</tbody></table><h2>FAQ</h2><h3>How much does 1 million TikTok views pay?</h3><p>If the million are qualified views with a mixed audience, roughly $400 to $1,000. If they are total views, only part of them qualify and the amount is lower.</p><h3>When does TikTok pay?</h3><p>You can withdraw rewards on the 15th of each month once you have at least $50.</p></>}</Fragment>
</ToolLayout>
