---
import ToolLayout from '../../../layouts/ToolLayout.astro';
import { toolBySlug } from '../../../lib/content/tools';
import { isLang } from '../../../lib/i18n';
if (!isLang(Astro.params.lang!)) return new Response(null, { status: 404 });
const lang = Astro.locals.lang; const fr = lang === 'fr'; const tool = toolBySlug('decouper-image-instagram')!;
const s = fr ? { drop: 'Déposez une image ici ou choisissez un fichier', dropH: 'JPG, PNG ou WebP. Elle reste sur votre appareil : rien n\'est envoyé.', choose: 'Choisir une image', layout: 'Disposition (colonnes x lignes)', posts: 'posts', format: 'Format des morceaux', portrait: '3:4 portrait', square: '1:1 carré', preview: 'Le rendu sur votre profil', previewH: 'Le numéro de chaque morceau indique l\'ordre de publication. Publiez le 1 en premier : Instagram place le post le plus récent en haut à gauche.', first: 'À publier en premier', dl: 'Télécharger les {n} morceaux (ZIP)', blurry: 'Image trop petite : certains morceaux seront agrandis et pourront paraître flous.', zoom: 'Zoom' } : { drop: 'Drop an image here or choose a file', dropH: 'JPG, PNG or WebP. It stays on your device: nothing is uploaded.', choose: 'Choose an image', layout: 'Layout (columns x rows)', posts: 'posts', format: 'Piece format', portrait: '3:4 portrait', square: '1:1 square', preview: 'How it looks on your profile', previewH: 'The number on each piece is the posting order. Post 1 first: Instagram puts the newest post top-left.', first: 'Post first', dl: 'Download the {n} pieces (ZIP)', blurry: 'Image too small: some pieces will be upscaled and may look blurry.', zoom: 'Zoom' };
---
<ToolLayout tool={tool}>
  <div class="grid lg:grid-cols-2 gap-6" id="gm" data-s={JSON.stringify(s)}>
    <div class="card p-5 space-y-4"><div id="drop" class="rounded-xl border-2 border-dashed border-slate-300 dark:border-slate-700 p-6 text-center cursor-pointer"><i class="fa-solid fa-image text-3xl text-brand-500"></i><p class="mt-2 text-sm">{s.drop}</p><p class="help">{s.dropH}</p><button type="button" class="btn-secondary btn-sm mt-2">{s.choose}</button><input type="file" id="file" accept="image/*" class="hidden" /></div>
      <div class="grid grid-cols-2 gap-3"><div><label class="label">{s.layout}</label><select id="layout" class="input input-select"><option value="1">3 x 1 · 3 {s.posts}</option><option value="2">3 x 2 · 6 {s.posts}</option><option value="3" selected>3 x 3 · 9 {s.posts}</option></select></div><div><label class="label">{s.format}</label><select id="ratio" class="input input-select"><option value="0.75">{s.portrait} · 1080 x 1440</option><option value="1">{s.square} · 1080 x 1080</option></select></div></div>
      <div><label class="label">{s.zoom}</label><input id="zoom" type="range" min="1" max="3" step="0.01" value="1" class="w-full accent-brand-600" /></div>
      <div class="relative overflow-hidden rounded-xl bg-slate-900 select-none" id="stage" style="aspect-ratio:1"><canvas id="cv" class="absolute inset-0 w-full h-full cursor-move"></canvas><div id="grid-lines" class="absolute inset-0 pointer-events-none"></div></div>
      <p id="warn" class="hidden text-xs text-amber-600">{s.blurry}</p></div>
    <div class="card p-5"><h3 class="font-semibold text-slate-900 dark:text-white">{s.preview}</h3><p class="help mb-3">{s.previewH}</p><div id="profile" class="grid grid-cols-3 gap-0.5 bg-white dark:bg-slate-900"></div><button type="button" id="dl" class="btn-primary mt-4 w-full" disabled><i class="fa-solid fa-download"></i><span id="dl-label"></span></button></div>
  </div>
  <script>
    const root = document.getElementById('gm')!; const S = JSON.parse(root.dataset.s!); const $ = (id: string) => document.getElementById(id)!;
    const cv = $('cv') as HTMLCanvasElement; const ctx = cv.getContext('2d')!; let img: HTMLImageElement | null = null; let ox = 0, oy = 0, zoom = 1; let drag: { x: number; y: number; ox: number; oy: number } | null = null;
    const rows = () => +($('layout') as HTMLSelectElement).value; const ratio = () => +($('ratio') as HTMLSelectElement).value; const W = 1080; const PW = W, PH = () => Math.round(W / ratio());
    const stageSize = () => { const w = 600, h = Math.round(w * (rows() * PH()) / (3 * PW)); cv.width = w; cv.height = h; ($('stage') as HTMLElement).style.aspectRatio = `${w}/${h}`; };
    const cover = () => { if (!img) return 1; return Math.max(cv.width / img.width, cv.height / img.height); };
    const draw = () => { ctx.fillStyle = '#0f172a'; ctx.fillRect(0, 0, cv.width, cv.height); if (!img) return; const sc = cover() * zoom; const dw = img.width * sc, dh = img.height * sc; ox = Math.min(0, Math.max(cv.width - dw, ox)); oy = Math.min(0, Math.max(cv.height - dh, oy)); ctx.drawImage(img, ox, oy, dw, dh); $('grid-lines').innerHTML = `<div class="absolute inset-0" style="background-image:linear-gradient(to right, rgba(255,255,255,.8) 1px, transparent 1px),linear-gradient(to bottom, rgba(255,255,255,.8) 1px, transparent 1px);background-size:${100 / 3}% ${100 / rows()}%"></div>`; ($('warn') as HTMLElement).classList.toggle('hidden', img.width * zoom >= 3 * PW * 0.8 && img.width >= 3 * PW * 0.6); renderProfile(); };
    const pieces = () => { const out: HTMLCanvasElement[] = []; if (!img) return out; const n = rows(); const sc = cover() * zoom; for (let r = 0; r < n; r++) for (let c = 0; c < 3; c++) { const p = document.createElement('canvas'); p.width = PW; p.height = PH(); const pc = p.getContext('2d')!; const cw = cv.width / 3, ch = cv.height / n; const sx = (c * cw - ox) / sc, sy = (r * ch - oy) / sc, sw = cw / sc, sh = ch / sc; pc.drawImage(img, sx, sy, sw, sh, 0, 0, PW, PH()); out.push(p); } return out; };
    const renderProfile = () => { const ps = pieces(); const n = rows(); const box = $('profile'); box.innerHTML = ''; ps.forEach((p, i) => { const order = ps.length - i; const d = document.createElement('div'); d.className = 'relative'; d.style.aspectRatio = String(ratio()); const im = new Image(); im.src = p.toDataURL('image/jpeg', 0.7); im.className = 'w-full h-full object-cover'; d.appendChild(im); const b = document.createElement('span'); b.className = 'absolute top-1 left-1 rounded bg-black/70 text-white text-[10px] font-bold px-1.5'; b.textContent = String(order) + (order === 1 ? ' · ' + S.first : ''); d.appendChild(b); box.appendChild(d); }); ($('dl') as HTMLButtonElement).disabled = !img; $('dl-label').textContent = S.dl.replace('{n}', String(3 * n)); };
    const load = (f: File) => { const im = new Image(); im.onload = () => { img = im; ox = oy = 0; zoom = 1; ($('zoom') as HTMLInputElement).value = '1'; stageSize(); draw(); }; im.src = URL.createObjectURL(f); };
    $('drop').addEventListener('click', () => $('file').click()); ($('file') as HTMLInputElement).addEventListener('change', (e) => { const f = (e.target as HTMLInputElement).files?.[0]; if (f) load(f); });
    $('drop').addEventListener('dragover', (e) => e.preventDefault()); $('drop').addEventListener('drop', (e) => { e.preventDefault(); const f = e.dataTransfer?.files[0]; if (f) load(f); });
    cv.addEventListener('pointerdown', (e) => { drag = { x: e.clientX, y: e.clientY, ox, oy }; cv.setPointerCapture(e.pointerId); }); cv.addEventListener('pointermove', (e) => { if (!drag) return; const k = cv.width / cv.getBoundingClientRect().width; ox = drag.ox + (e.clientX - drag.x) * k; oy = drag.oy + (e.clientY - drag.y) * k; draw(); }); cv.addEventListener('pointerup', () => (drag = null));
    $('zoom').addEventListener('input', (e) => { zoom = +(e.target as HTMLInputElement).value; draw(); }); $('layout').addEventListener('change', () => { stageSize(); draw(); }); $('ratio').addEventListener('change', () => { stageSize(); draw(); });
    // Minimal ZIP writer (store, no compression) so nothing leaves the browser
    const crcTable = (() => { const t = new Uint32Array(256); for (let n = 0; n < 256; n++) { let c = n; for (let k = 0; k < 8; k++) c = c & 1 ? 0xedb88320 ^ (c >>> 1) : c >>> 1; t[n] = c >>> 0; } return t; })();
    const crc32 = (u8: Uint8Array) => { let c = 0xffffffff; for (let i = 0; i < u8.length; i++) c = crcTable[(c ^ u8[i]) & 0xff] ^ (c >>> 8); return (c ^ 0xffffffff) >>> 0; };
    const zip = (files: { name: string; data: Uint8Array }[]) => { const enc = new TextEncoder(); const parts: Uint8Array[] = []; const central: Uint8Array[] = []; let offset = 0; for (const f of files) { const name = enc.encode(f.name); const crc = crc32(f.data); const h = new DataView(new ArrayBuffer(30)); h.setUint32(0, 0x04034b50, true); h.setUint16(4, 20, true); h.setUint16(6, 0, true); h.setUint16(8, 0, true); h.setUint16(10, 0, true); h.setUint16(12, 0, true); h.setUint32(14, crc, true); h.setUint32(18, f.data.length, true); h.setUint32(22, f.data.length, true); h.setUint16(26, name.length, true); h.setUint16(28, 0, true); parts.push(new Uint8Array(h.buffer), name, f.data); const c = new DataView(new ArrayBuffer(46)); c.setUint32(0, 0x02014b50, true); c.setUint16(4, 20, true); c.setUint16(6, 20, true); c.setUint16(8, 0, true); c.setUint16(10, 0, true); c.setUint16(12, 0, true); c.setUint16(14, 0, true); c.setUint32(16, crc, true); c.setUint32(20, f.data.length, true); c.setUint32(24, f.data.length, true); c.setUint16(28, name.length, true); c.setUint16(30, 0, true); c.setUint16(32, 0, true); c.setUint16(34, 0, true); c.setUint16(36, 0, true); c.setUint32(38, 0, true); c.setUint32(42, offset, true); central.push(new Uint8Array(c.buffer), name); offset += 30 + name.length + f.data.length; } const cdSize = central.reduce((s, p) => s + p.length, 0); const e = new DataView(new ArrayBuffer(22)); e.setUint32(0, 0x06054b50, true); e.setUint16(8, files.length, true); e.setUint16(10, files.length, true); e.setUint32(12, cdSize, true); e.setUint32(16, offset, true); return new Blob([...parts, ...central, new Uint8Array(e.buffer)], { type: 'application/zip' }); };
    $('dl').addEventListener('click', async () => { const ps = pieces(); const n = rows(); const files: { name: string; data: Uint8Array }[] = []; for (let i = 0; i < ps.length; i++) { const order = ps.length - i; const r = Math.floor(i / 3) + 1, c = (i % 3) + 1; const blob: Blob = await new Promise((res) => ps[i].toBlob((b) => res(b!), 'image/jpeg', 0.92)); files.push({ name: `${String(order).padStart(2, '0')}-post-${order === 1 ? 'first' : order === ps.length ? 'last' : 'next'}_row${r}-col${c}.jpg`, data: new Uint8Array(await blob.arrayBuffer()) }); } const a = document.createElement('a'); a.href = URL.createObjectURL(zip(files)); a.download = `instagram-grid-3x${n}.zip`; a.click(); });
    stageSize(); draw();
  </script>
  <Fragment slot="content">{fr ? <><h2>Comment faire une grille Instagram</h2><ol><li>Choisissez la disposition : 3 x 1 (une ligne, 3 posts), 3 x 2 (6 posts) ou 3 x 3 (9 posts). Les profils Instagram font toujours 3 posts de large.</li><li>Déposez votre image. Faites-la glisser pour choisir ce qui entre dans le cadre et zoomez si vous voulez un cadrage plus serré. Les lignes blanches montrent où elle sera coupée.</li><li>Vérifiez l'aperçu à droite. Il est dessiné comme votre profil.</li><li>Téléchargez le ZIP. Les fichiers commencent par leur numéro de publication : 01 se publie en premier, 09 en dernier.</li></ol><h2>Pourquoi les morceaux sont en 3:4</h2><p>Instagram a remplacé la grille de profil carrée par des rectangles plus hauts en janvier 2025. La grille affiche les posts en 3:4 et Instagram accepte les photos jusqu'au 3:4 en 1080 x 1440. C'est pour cela que cet outil exporte par défaut des morceaux de 1080 x 1440.</p><h2>Ce qui casse une grille</h2><ul><li>Les carrousels : seule la première image apparaît dans la grille, donc chaque morceau doit être un post séparé.</li><li>Les posts épinglés : ils se placent au début de votre grille et décalent vos morceaux.</li><li>Les Reels partagés dans la grille comptent comme des posts.</li></ul><p>Avec Upload-Post, vous ajoutez chaque morceau comme un post Instagram à image unique et vous les programmez à quelques minutes d'écart depuis le calendrier ou l'API, en commençant par le morceau 01.</p></> : <><h2>How to make an Instagram grid</h2><ol><li>Pick the layout: 3 x 1 (one row, 3 posts), 3 x 2 (6 posts) or 3 x 3 (9 posts). Instagram profiles are always 3 posts wide.</li><li>Drop your image. Drag it to choose what fits in the frame and zoom for a tighter crop. The white lines show where it will be cut.</li><li>Check the preview on the right. It is drawn like your profile.</li><li>Download the ZIP. Files start with their posting number: 01 goes first, 09 last.</li></ol><h2>Why pieces are 3:4</h2><p>Instagram replaced the square profile grid with taller rectangles in January 2025. The grid shows posts in 3:4 and Instagram accepts photos up to 3:4 at 1080 x 1440, which is why this tool exports 1080 x 1440 pieces by default.</p><h2>What breaks a grid</h2><ul><li>Carousels: only the first image shows in the grid, so each piece must be a separate post.</li><li>Pinned posts: they sit at the start of your grid and shift your pieces.</li><li>Reels shared to the grid count as posts.</li></ul><p>With Upload-Post, add each piece as a single-image Instagram post and schedule them a few minutes apart from the calendar or the API, starting with piece 01.</p></>}</Fragment>
</ToolLayout>
