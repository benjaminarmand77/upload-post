---
import ToolLayout from '../../../layouts/ToolLayout.astro';
import { toolBySlug } from '../../../lib/content/tools';
import { isLang } from '../../../lib/i18n';
if (!isLang(Astro.params.lang!)) return new Response(null, { status: 404 });
const lang = Astro.locals.lang; const fr = lang === 'fr'; const tool = toolBySlug('zone-de-securite-tiktok-reels')!;
const s = fr ? { ph: 'Votre image ou vidéo s\'affiche ici, en 9:16', drop: 'Déposez une image ou une vidéo, ou choisissez un fichier', dropH: 'Lu uniquement sur votre appareil. Rien n\'est envoyé.', choose: 'Choisir un fichier', platform: 'Plateforme', all: 'Les trois', gray: 'Griser les zones recouvertes', sketch: 'Afficher les boutons de l\'appli (croquis)', legend1: 'Zone grisée : l\'interface de l\'appli peut la recouvrir. N\'y mettez ni texte, ni visage, ni logo.', legend2: 'Pointillés : la zone de sécurité selon les consignes de la plateforme.', note: 'Les zones suivent les consignes publicitaires publiées par chaque plateforme. Le croquis des boutons montre leur emplacement approximatif.' } : { ph: 'Your image or video shows here, in 9:16', drop: 'Drop an image or video, or choose a file', dropH: 'Read on your device only. Nothing is uploaded.', choose: 'Choose a file', platform: 'Platform', all: 'All three', gray: 'Gray out covered areas', sketch: 'Show app buttons (sketch)', legend1: 'Gray area: the app interface may cover it. Keep text, faces and logos out of it.', legend2: 'Dashed: the safe zone according to the platform guidelines.', note: 'Zones follow the advertising guidelines published by each platform. The button sketch shows approximate positions.' };
const ZONES = { tiktok: { top: 240, bottom: 660, left: 120, right: 120, rail: { from: 840, width: 300 } }, reels: { top: 269, bottom: 672, left: 65, right: 65 }, shorts: { top: 288, bottom: 672, left: 48, right: 192 }, all: { top: 288, bottom: 672, left: 120, right: 192, rail: { from: 840, width: 300 } } };
---
<ToolLayout tool={tool}>
  <div class="grid lg:grid-cols-[1fr_1.2fr] gap-6" id="sz" data-zones={JSON.stringify(ZONES)}>
    <div class="card p-5 space-y-4"><div id="drop" class="rounded-xl border-2 border-dashed border-slate-300 dark:border-slate-700 p-6 text-center cursor-pointer"><i class="fa-solid fa-mobile-screen text-3xl text-brand-500"></i><p class="mt-2 text-sm">{s.drop}</p><p class="help">{s.dropH}</p><button type="button" class="btn-secondary btn-sm mt-2">{s.choose}</button><input type="file" id="file" accept="image/*,video/*" class="hidden" /></div>
      <div><label class="label">{s.platform}</label><div class="flex flex-wrap gap-1.5">{[['tiktok', 'TikTok'], ['reels', 'Instagram Reels'], ['shorts', 'YouTube Shorts'], ['all', s.all]].map(([k, l], i) => <label class="cursor-pointer rounded-lg border border-slate-200 dark:border-slate-700 px-3 py-1.5 text-sm has-[:checked]:border-brand-500 has-[:checked]:bg-brand-50 dark:has-[:checked]:bg-brand-500/15"><input type="radio" name="pf" value={k} class="sr-only" checked={i === 0} />{l}</label>)}</div></div>
      <label class="flex items-center gap-2 text-sm"><input type="checkbox" id="gray" checked class="rounded" />{s.gray}</label><label class="flex items-center gap-2 text-sm"><input type="checkbox" id="sketch" checked class="rounded" />{s.sketch}</label>
      <p class="text-xs text-slate-500">{s.legend1}</p><p class="text-xs text-slate-500">{s.legend2}</p><p class="text-xs text-slate-400">{s.note}</p></div>
    <div class="card p-5 flex flex-col items-center"><div class="relative w-full max-w-[300px] rounded-[28px] border-8 border-slate-900 dark:border-slate-700 bg-slate-800 overflow-hidden shadow-elevated" style="aspect-ratio:9/16" id="phone"><div id="media" class="absolute inset-0 flex items-center justify-center text-xs text-slate-400 text-center p-6">{s.ph}</div><svg id="overlay" viewBox="0 0 1080 1920" class="absolute inset-0 w-full h-full" preserveAspectRatio="none"></svg></div><input id="seek" type="range" min="0" max="100" value="0" class="hidden w-full max-w-[300px] mt-3 accent-brand-600" /></div>
  </div>
  <script>
    const root = document.getElementById('sz')!; const Z = JSON.parse(root.dataset.zones!); const $ = (id: string) => document.getElementById(id)!; let video: HTMLVideoElement | null = null;
    const pf = () => (root.querySelector('input[name=pf]:checked') as HTMLInputElement).value;
    const draw = () => { const z = Z[pf()]; const gray = ($('gray') as HTMLInputElement).checked; const sk = ($('sketch') as HTMLInputElement).checked; const g = 'rgba(15,23,42,.62)'; let svg = ''; if (gray) { svg += `<rect x="0" y="0" width="1080" height="${z.top}" fill="${g}"/><rect x="0" y="${1920 - z.bottom}" width="1080" height="${z.bottom}" fill="${g}"/><rect x="0" y="${z.top}" width="${z.left}" height="${1920 - z.top - z.bottom}" fill="${g}"/><rect x="${1080 - z.right}" y="${z.top}" width="${z.right}" height="${1920 - z.top - z.bottom}" fill="${g}"/>`; if (z.rail) svg += `<rect x="${1080 - z.rail.width}" y="${z.rail.from}" width="${z.rail.width - z.right}" height="${1920 - z.bottom - z.rail.from}" fill="${g}"/>`; } svg += `<rect x="${z.left}" y="${z.top}" width="${1080 - z.left - z.right}" height="${1920 - z.top - z.bottom}" fill="none" stroke="#fff" stroke-width="4" stroke-dasharray="18 14"/>`; if (sk) { const icons = [1000, 1150, 1300, 1450]; svg += icons.map((y) => `<circle cx="990" cy="${y}" r="42" fill="rgba(255,255,255,.85)"/>`).join('') + `<rect x="60" y="1560" width="620" height="28" rx="14" fill="rgba(255,255,255,.85)"/><rect x="60" y="1620" width="820" height="22" rx="11" fill="rgba(255,255,255,.6)"/><rect x="60" y="1662" width="520" height="22" rx="11" fill="rgba(255,255,255,.6)"/><rect x="380" y="100" width="320" height="34" rx="17" fill="rgba(255,255,255,.7)"/>`; } $('overlay').innerHTML = svg; };
    const load = (f: File) => { const m = $('media'); m.innerHTML = ''; m.className = 'absolute inset-0'; if (f.type.startsWith('video')) { video = document.createElement('video'); video.src = URL.createObjectURL(f); video.muted = true; video.loop = true; video.playsInline = true; video.autoplay = true; video.className = 'w-full h-full object-cover'; m.appendChild(video); $('seek').classList.remove('hidden'); video.addEventListener('timeupdate', () => { if (video!.duration) ($('seek') as HTMLInputElement).value = String((video!.currentTime / video!.duration) * 100); }); } else { const im = new Image(); im.src = URL.createObjectURL(f); im.className = 'w-full h-full object-cover'; m.appendChild(im); $('seek').classList.add('hidden'); video = null; } };
    $('seek').addEventListener('input', (e) => { if (video?.duration) { video.pause(); video.currentTime = (+(e.target as HTMLInputElement).value / 100) * video.duration; } });
    $('drop').addEventListener('click', () => $('file').click()); ($('file') as HTMLInputElement).addEventListener('change', (e) => { const f = (e.target as HTMLInputElement).files?.[0]; if (f) load(f); }); $('drop').addEventListener('dragover', (e) => e.preventDefault()); $('drop').addEventListener('drop', (e) => { e.preventDefault(); const f = e.dataTransfer?.files[0]; if (f) load(f); });
    root.querySelectorAll('input[name=pf], #gray, #sketch').forEach((i) => i.addEventListener('change', draw)); draw();
  </script>
  <Fragment slot="content">{fr ? <><h2>Tailles des zones de sécurité par plateforme</h2><p>En pixels sur un cadre 1080 x 1920 (9:16).</p><table><thead><tr><th>Plateforme</th><th>Haut</th><th>Bas</th><th>Gauche</th><th>Droite</th><th>Source</th></tr></thead><tbody><tr><td>TikTok</td><td>240 px (12,5 %)</td><td>660 px (34,4 %)</td><td>120 px</td><td>120 px, 300 px à partir de 840 px du haut (boutons)</td><td>TikTok Ads Manager Help, modèle In-Feed</td></tr><tr><td>Instagram Reels</td><td>269 px (14 %)</td><td>672 px (35 %)</td><td>65 px (6 %)</td><td>65 px (6 %)</td><td>Meta Ads Guide</td></tr><tr><td>YouTube Shorts</td><td>288 px (15 %)</td><td>672 px (35 %)</td><td>48 px</td><td>192 px</td><td>Google Ads Help</td></tr><tr><td>Les trois</td><td>288 px</td><td>672 px</td><td>120 px</td><td>192 px, 300 px à partir de 840 px</td><td>La plus grande marge de chaque côté</td></tr></tbody></table><h2>Exemples</h2><ul><li>Accroche en texte en haut : commencez-la sous 288 px.</li><li>Sous-titres incrustés : gardez-les au-dessus de 1248 px.</li><li>Logo ou étiquette de prix à droite : gardez-le à gauche de 888 px, et de 780 px dans la moitié basse.</li></ul><h2>Pourquoi votre écran peut ne pas correspondre exactement</h2><p>Les zones de sécurité sont une marge, pas une carte au pixel près. L'interface change selon la forme de l'écran, la version de l'appli et la longueur de la légende. Le croquis des boutons est notre propre dessin de leur emplacement approximatif.</p><p>Sans risque sur les trois ? Upload-Post publie la même vidéo verticale sur TikTok, Instagram Reels et YouTube Shorts en une seule fois.</p></> : <><h2>Safe zone sizes per platform</h2><p>In pixels on a 1080 x 1920 (9:16) frame.</p><table><thead><tr><th>Platform</th><th>Top</th><th>Bottom</th><th>Left</th><th>Right</th><th>Source</th></tr></thead><tbody><tr><td>TikTok</td><td>240 px (12.5%)</td><td>660 px (34.4%)</td><td>120 px</td><td>120 px, 300 px from 840 px down (buttons)</td><td>TikTok Ads Manager Help, In-Feed template</td></tr><tr><td>Instagram Reels</td><td>269 px (14%)</td><td>672 px (35%)</td><td>65 px (6%)</td><td>65 px (6%)</td><td>Meta Ads Guide</td></tr><tr><td>YouTube Shorts</td><td>288 px (15%)</td><td>672 px (35%)</td><td>48 px</td><td>192 px</td><td>Google Ads Help</td></tr><tr><td>All three</td><td>288 px</td><td>672 px</td><td>120 px</td><td>192 px, 300 px from 840 px</td><td>Largest margin on each side</td></tr></tbody></table><h2>Examples</h2><ul><li>Text hook at the top: start it below 288 px.</li><li>Burned-in captions: keep them above 1248 px.</li><li>Logo or price tag on the right: keep it left of 888 px, and of 780 px in the bottom half.</li></ul><h2>Why your screen may not match exactly</h2><p>Safe zones are a margin, not a pixel-perfect map. The interface changes with the phone screen shape, app version and caption length. The button sketch is our own drawing of their approximate position.</p><p>Safe on all three? Upload-Post publishes the same vertical video to TikTok, Instagram Reels and YouTube Shorts in one go.</p></>}</Fragment>
</ToolLayout>
