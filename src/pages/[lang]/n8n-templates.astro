---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PlatformIcon from '../../components/PlatformIcon.astro';
import Cta from '../../components/marketing/Cta.astro';
import { N8N_TEMPLATES, PLATFORM_UPLOAD_GUIDES, uploadGuideSlug } from '../../lib/content/templates';
import { PLATFORM_MAP, type PlatformKey } from '../../lib/platforms';
import { isLang, localePath } from '../../lib/i18n';
if (!isLang(Astro.params.lang!)) return new Response(null, { status: 404 });
const lang = Astro.locals.lang; const fr = lang === 'fr'; const txt = fr ? 'fr' : 'en'; const L = (p: string) => localePath(lang, p);
const s = fr ? { title: 'Modèles de workflows n8n', sub: `${N8N_TEMPLATES.length} workflows n8n prêts à importer : de Google Drive aux réseaux sociaux, génération vidéo IA, clips de podcast, carrousels, validation Telegram… Tous utilisent le nœud Upload-Post officiel.`, all: 'Tous', cats: { ai: 'IA', video: 'Vidéo', drive: 'Drive & fichiers', social: 'Réseaux', agency: 'Agences', podcast: 'Podcast' }, open: 'Voir le workflow', guides: 'Guides d\'upload n8n par plateforme' } : { title: 'n8n workflow templates', sub: `${N8N_TEMPLATES.length} n8n workflows ready to import: Google Drive to social media, AI video generation, podcast clips, carousels, Telegram approval… All use the official Upload-Post node.`, all: 'All', cats: { ai: 'AI', video: 'Video', drive: 'Drive & files', social: 'Social', agency: 'Agencies', podcast: 'Podcast' }, open: 'View workflow', guides: 'n8n upload guides per platform' };
---
<BaseLayout title={`${s.title} | Upload-Post`} description={s.sub}>
  <section class="bg-white dark:bg-slate-950 pt-12 pb-8 text-center"><div class="container-x"><h1 class="text-4xl md:text-5xl font-extrabold text-slate-900 dark:text-white">{s.title}</h1><p class="mt-4 max-w-3xl mx-auto text-slate-500 dark:text-slate-400">{s.sub}</p><div class="mt-6 flex flex-wrap justify-center gap-1.5" id="cats"><button type="button" data-cat="" class="rounded-lg px-3 py-1.5 text-sm font-medium bg-brand-600 text-white">{s.all}</button>{Object.entries(s.cats).map(([k, v]) => <button type="button" data-cat={k} class="rounded-lg px-3 py-1.5 text-sm font-medium border border-slate-200 dark:border-slate-700">{v}</button>)}</div></div></section>
  <section class="lp-section-gray !pt-4"><div class="container-x grid sm:grid-cols-2 lg:grid-cols-3 gap-4" id="tpls">{N8N_TEMPLATES.map((t) => <a href={L(`/n8n/${t.slug}/`)} class="card card-hover p-5 flex flex-col" data-cat={t.category}><div class="flex items-center gap-1.5 mb-3">{t.platforms.slice(0, 5).map((k) => <PlatformIcon platform={k as PlatformKey} size="text-sm" />)}<span class="ml-auto chip">{(s.cats as any)[t.category]}</span></div><h2 class="font-semibold text-slate-900 dark:text-white">{t.title[txt]}</h2><p class="mt-2 text-sm text-slate-500 dark:text-slate-400 flex-1">{t.desc[txt]}</p><div class="mt-3 flex flex-wrap gap-1">{t.apps.map((a) => <span class="chip">{a}</span>)}</div><span class="mt-3 text-sm font-semibold text-brand-600">{s.open} →</span></a>)}</div></section>
  <section class="lp-section-white"><div class="container-x"><h2 class="text-sm font-semibold uppercase tracking-wider text-slate-400 mb-4">{s.guides}</h2><div class="flex flex-wrap gap-2">{PLATFORM_UPLOAD_GUIDES.map((k) => <a href={L(`/n8n/${uploadGuideSlug(k)}/`)} class="inline-flex items-center gap-2 rounded-lg border border-slate-200 dark:border-slate-700 px-3 py-1.5 text-sm hover:border-brand-400"><PlatformIcon platform={k as PlatformKey} size="text-sm" />{PLATFORM_MAP[k as PlatformKey].name}</a>)}</div></div></section>
  <Cta title={Astro.locals.t.home.integrations.n8n.t} subtitle={Astro.locals.t.home.integrations.n8n.d} label={Astro.locals.t.common.startFree} secondary={{ label: Astro.locals.t.home.integrations.viewGuide, href: '/n8n-integration-guide/' }} />
  <script>
    document.querySelectorAll<HTMLElement>('[data-cat]').forEach((b) => b.addEventListener('click', () => { if (b.closest('#tpls')) return; const c = b.dataset.cat; document.querySelectorAll<HTMLElement>('#cats [data-cat]').forEach((x) => { x.classList.toggle('bg-brand-600', x === b); x.classList.toggle('text-white', x === b); x.classList.toggle('border', x !== b); }); document.querySelectorAll<HTMLElement>('#tpls [data-cat]').forEach((card) => { card.style.display = !c || card.dataset.cat === c ? '' : 'none'; }); }));
  </script>
</BaseLayout>
