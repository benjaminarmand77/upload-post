---
import '../../styles/global.css';
import Logo from '../../components/Logo.astro';
import { getAppDict } from '../../i18n/app';
import { localePath } from '../../lib/i18n';
const lang = Astro.locals.lang; const a = getAppDict(lang);
if (Astro.locals.user) return Astro.redirect(Astro.url.searchParams.get('redirect') || '/app/', 303);
const q = Astro.url.searchParams;
const sent = q.get('sent') === '1'; const email = q.get('email') || ''; const devLink = q.get('dev_link'); const error = q.get('error'); const loggedOut = q.get('logged_out');
const source = q.get('source') || ''; const plan = q.get('plan') || ''; const redirect = q.get('redirect') || '';
const google = !!process.env.GOOGLE_CLIENT_ID;
---
<!doctype html>
<html lang={lang} class={Astro.locals.theme === 'dark' ? 'dark' : ''}>
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{a.login.title} · Upload-Post</title><meta name="robots" content="noindex" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
  <script is:inline>(function(){try{var s=localStorage.getItem('theme');var c=(document.cookie.match(/(?:^|; )theme=(light|dark)/)||[])[1];var t=s||c||'dark';document.documentElement.classList.toggle('dark',t==='dark');}catch(e){}})();</script>
</head>
<body class="min-h-screen bg-slate-50 dark:bg-slate-950 flex items-center justify-center px-4 py-10 relative overflow-hidden">
  <div class="glow -top-40 left-1/2 -translate-x-1/2 h-[520px] w-[720px] bg-brand-500/20"></div>
  <div class="relative w-full max-w-md">
    <a href={localePath(lang, '/')} class="flex flex-col items-center gap-2 mb-6"><span class="inline-flex h-14 w-14 items-center justify-center rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow"><Logo size={34} /></span><span class="font-bold text-slate-900 dark:text-white">Upload-Post</span></a>
    <div class="card p-8">
      {sent ? (
        <div class="text-center">
          <span class="inline-flex h-14 w-14 items-center justify-center rounded-full bg-emerald-500/15 text-emerald-500 text-2xl"><i class="fa-solid fa-envelope-circle-check"></i></span>
          <h1 class="mt-4 text-2xl font-bold text-slate-900 dark:text-white">{a.login.sentTitle}</h1>
          <p class="mt-2 text-slate-500 dark:text-slate-400">{a.login.sentBody} <strong class="text-slate-900 dark:text-white">{email}</strong></p>
          {devLink && <div class="mt-5 rounded-xl border border-amber-300/60 bg-amber-50 dark:bg-amber-500/10 p-4 text-left"><p class="text-xs text-amber-800 dark:text-amber-300">{a.login.sentDev}</p><a href={devLink} class="btn-primary mt-3 w-full"><i class="fa-solid fa-arrow-right-to-bracket"></i>{a.login.open}</a></div>}
          <a href="/app/login" class="mt-6 inline-block text-sm text-brand-600 dark:text-brand-400">{a.common.back}</a>
        </div>
      ) : (
        <div>
          <h1 class="text-2xl font-bold text-slate-900 dark:text-white text-center">{a.login.title}</h1>
          <p class="mt-2 text-center text-slate-500 dark:text-slate-400">{a.login.subtitle}</p>
          {error && <div class="mt-4 rounded-lg bg-rose-50 dark:bg-rose-500/10 border border-rose-200 dark:border-rose-500/30 px-3 py-2 text-sm text-rose-700 dark:text-rose-300">{(a.login.errors as any)[error] || error}</div>}
          {loggedOut && <div class="mt-4 rounded-lg bg-slate-100 dark:bg-slate-800 px-3 py-2 text-sm">{a.login.loggedOut}</div>}
          <a href={google ? '/app/auth/google' : '/app/login?error=google_not_configured'} class="btn-secondary mt-6 w-full !bg-white !text-slate-800"><svg width="18" height="18" viewBox="0 0 48 48" aria-hidden="true"><path fill="#EA4335" d="M24 9.5c3.5 0 6.6 1.2 9 3.5l6.7-6.7C35.7 2.6 30.2 0 24 0 14.6 0 6.5 5.4 2.6 13.3l7.8 6C12.3 13.5 17.7 9.5 24 9.5z"/><path fill="#4285F4" d="M46.5 24.5c0-1.6-.1-3.1-.4-4.5H24v9h12.7c-.6 3-2.2 5.5-4.7 7.2l7.6 5.9c4.4-4.1 6.9-10.1 6.9-17.6z"/><path fill="#FBBC05" d="M10.4 28.7c-.5-1.5-.8-3-.8-4.7s.3-3.2.8-4.7l-7.8-6C.9 16.5 0 20.1 0 24s.9 7.5 2.6 10.7l7.8-6z"/><path fill="#34A853" d="M24 48c6.2 0 11.5-2 15.3-5.6l-7.6-5.9c-2.1 1.4-4.7 2.2-7.7 2.2-6.3 0-11.7-4-13.6-9.7l-7.8 6C6.5 42.6 14.6 48 24 48z"/></svg>{a.login.google}</a>
          <div class="my-5 flex items-center gap-3 text-[11px] font-semibold tracking-wider text-slate-400"><span class="h-px flex-1 bg-slate-200 dark:bg-slate-800"></span>{a.login.or}<span class="h-px flex-1 bg-slate-200 dark:bg-slate-800"></span></div>
          <form method="post" action="/app/auth/send-link" class="space-y-4">
            <input type="hidden" name="source" value={source} /><input type="hidden" name="plan" value={plan} /><input type="hidden" name="redirect" value={redirect} />
            <div><label class="label" for="email">{a.login.email}</label><div class="relative"><i class="fa-solid fa-envelope absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-sm"></i><input id="email" name="email" type="email" required autocomplete="email" placeholder="name@company.com" class="input !pl-10" /></div></div>
            <button type="submit" class="btn-primary w-full btn-lg">{a.login.send}<i class="fa-solid fa-arrow-right text-xs"></i></button>
          </form>
          <p class="mt-4 text-center text-xs text-slate-500">{a.login.noPassword}</p>
          <p class="mt-4 text-center text-[11px] text-slate-400">{a.login.terms} <a href={localePath(lang, '/terms-of-use/')} class="underline">{a.login.termsLink}</a> {a.login.and} <a href={localePath(lang, '/data-and-privacy-policy/')} class="underline">{a.login.privacyLink}</a>.</p>
        </div>
      )}
    </div>
  </div>
</body>
</html>
