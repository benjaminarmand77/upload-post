---
import AppLayout from '../../layouts/AppLayout.astro';
import { getAppDict } from '../../i18n/app';
import { PLATFORMS } from '../../lib/platforms';
import { listProfiles } from '../../server/uploads';
import { getQueueSettings } from '../../server/queue';
const user = Astro.locals.user; if (!user) return Astro.redirect('/app/login', 303);
const lang = Astro.locals.lang; const a = getAppDict(lang); const c = a.calendar;
const owner = user.owner_user_id || user.id;
const profiles = listProfiles(owner);
const tz = profiles[0] ? getQueueSettings(profiles[0].id).timezone : user.timezone || 'UTC';
const plat = Object.fromEntries(PLATFORMS.map((p) => [p.key, { name: p.name, icon: p.icon, color: p.color }]));
---
<AppLayout title={c.title} subtitle={c.subtitle} active="calendar" wide>
  <div slot="actions" class="flex items-center gap-1 rounded-lg border border-slate-200 dark:border-slate-700 p-0.5 text-xs">{[['month', c.month], ['week', c.week], ['list', c.list]].map(([v, l]) => <button type="button" data-view={v} class="rounded-md px-2.5 py-1.5 font-medium data-[on=true]:bg-brand-600 data-[on=true]:text-white">{l}</button>)}</div>
  <div class="card p-4" id="cal" data-plat={JSON.stringify(plat)} data-lang={lang} data-tz={tz} data-s={JSON.stringify({ today: c.today, empty: c.empty, cancel: c.cancel, edit: c.edit, newDate: c.newDate, queueSlot: c.queueSlot, confirm: a.common.confirmDelete })}>
    <div class="flex items-center justify-between mb-3"><div class="flex items-center gap-1"><button type="button" id="prev" class="h-8 w-8 rounded-lg border border-slate-200 dark:border-slate-700"><i class="fa-solid fa-chevron-left text-xs"></i></button><button type="button" id="today" class="h-8 rounded-lg border border-slate-200 dark:border-slate-700 px-3 text-xs font-medium">{c.today}</button><button type="button" id="next" class="h-8 w-8 rounded-lg border border-slate-200 dark:border-slate-700"><i class="fa-solid fa-chevron-right text-xs"></i></button></div><h2 id="cal-title" class="font-semibold text-slate-900 dark:text-white"></h2><a href="/app/upload" class="btn-primary btn-sm"><i class="fa-solid fa-plus"></i>{a.nav.upload}</a></div>
    <div id="grid"></div>
  </div>
  <div id="edit-modal" class="hidden fixed inset-0 z-[80] flex items-center justify-center p-4"><div class="absolute inset-0 bg-slate-900/50 backdrop-blur-sm" data-close></div><form id="edit-form" class="relative card w-full max-w-md p-6 space-y-3"><h3 class="font-bold text-slate-900 dark:text-white">{c.edit}</h3><input type="hidden" name="job_id" /><div><label class="label">{a.common.title}</label><input name="title" class="input" /></div><div><label class="label">{c.newDate}</label><input type="datetime-local" name="scheduled_date" class="input" /></div><div class="flex justify-between gap-2 pt-2"><button type="button" id="cancel-job" class="btn-secondary btn-sm !text-rose-500">{c.cancel}</button><div class="flex gap-2"><button type="button" class="btn-secondary btn-sm" data-close>{a.common.close}</button><button class="btn-primary btn-sm">{a.common.save}</button></div></div></form></div>
  <script>
    const root = document.getElementById('cal')!; const PL = JSON.parse(root.dataset.plat!); const S = JSON.parse(root.dataset.s!); const lang = root.dataset.lang!; const api = (window as any).api, toast = (window as any).toast;
    let view = localStorage.getItem('cal_view') || 'month'; let cursor = new Date(); let posts: any[] = []; let slots: any[] = [];
    const sameDay = (a: Date, b: Date) => a.getFullYear() === b.getFullYear() && a.getMonth() === b.getMonth() && a.getDate() === b.getDate();
    const fmtT = (d: Date) => d.toLocaleTimeString(lang, { hour: '2-digit', minute: '2-digit' });
    const chip = (p: any) => `<button type="button" data-job="${p.job_id}" class="w-full text-left truncate rounded-md px-1.5 py-0.5 text-[11px] bg-brand-50 dark:bg-brand-500/15 text-brand-800 dark:text-brand-200 hover:bg-brand-100" title="${(p.title || '').replace(/"/g, '&quot;')}">${fmtT(new Date(p.scheduled_date))} ${p.platforms.map((k: string) => `<i class="${PL[k]?.icon}" style="color:${PL[k]?.color}"></i>`).join('')} ${p.title || ''}</button>`;
    const render = () => {
      document.querySelectorAll<HTMLElement>('[data-view]').forEach((b) => b.dataset.on = String(b.dataset.view === view));
      const g = document.getElementById('grid')!; const t = document.getElementById('cal-title')!;
      if (view === 'list') { t.textContent = ''; const upcoming = [...posts].sort((a, b) => a.scheduled_date.localeCompare(b.scheduled_date)); g.innerHTML = upcoming.length ? `<ul class="divide-y divide-slate-100 dark:divide-slate-800">${upcoming.map((p) => `<li class="py-3 flex items-center gap-3 text-sm"><div class="w-40 text-slate-500 text-xs">${new Date(p.scheduled_date).toLocaleString(lang, { dateStyle: 'medium', timeStyle: 'short' })}</div><div class="flex gap-1">${p.platforms.map((k: string) => `<i class="${PL[k]?.icon}" style="color:${PL[k]?.color}"></i>`).join('')}</div><div class="flex-1 truncate">${p.title || '<i>' + p.post_type + '</i>'}${p.from_queue ? ` <span class="chip">${S.queueSlot}</span>` : ''}</div><span class="text-xs text-slate-400">${p.profile_username}</span><button type="button" data-job="${p.job_id}" class="btn-ghost btn-sm"><i class="fa-solid fa-pen"></i></button></li>`).join('')}</ul>` : `<p class="text-sm text-slate-500 py-6 text-center">${S.empty}</p>`; return; }
      const days: Date[] = []; let start: Date;
      if (view === 'month') { const first = new Date(cursor.getFullYear(), cursor.getMonth(), 1); start = new Date(first); start.setDate(first.getDate() - ((first.getDay() + 6) % 7)); for (let i = 0; i < 42; i++) { const d = new Date(start); d.setDate(start.getDate() + i); days.push(d); } t.textContent = cursor.toLocaleDateString(lang, { month: 'long', year: 'numeric' }); }
      else { start = new Date(cursor); start.setDate(cursor.getDate() - ((cursor.getDay() + 6) % 7)); for (let i = 0; i < 7; i++) { const d = new Date(start); d.setDate(start.getDate() + i); days.push(d); } t.textContent = `${days[0].toLocaleDateString(lang, { day: 'numeric', month: 'short' })} – ${days[6].toLocaleDateString(lang, { day: 'numeric', month: 'short', year: 'numeric' })}`; }
      const dow = Array.from({ length: 7 }, (_, i) => { const d = new Date(2024, 0, 1 + i); return d.toLocaleDateString(lang, { weekday: 'short' }); });
      const now = new Date();
      g.innerHTML = `<div class="grid grid-cols-7 text-[11px] font-semibold uppercase tracking-wider text-slate-400 mb-1">${dow.map((d) => `<div class="px-1">${d}</div>`).join('')}</div><div class="grid grid-cols-7 gap-px bg-slate-200 dark:bg-slate-800 rounded-xl overflow-hidden">${days.map((d) => { const inMonth = view === 'week' || d.getMonth() === cursor.getMonth(); const ps = posts.filter((p) => sameDay(new Date(p.scheduled_date), d)).sort((a, b) => a.scheduled_date.localeCompare(b.scheduled_date)); const ss = slots.filter((s) => s.available && sameDay(new Date(s.datetime_utc), d)); return `<div class="bg-white dark:bg-slate-900 p-1.5 ${view === 'week' ? 'min-h-48' : 'min-h-24'} ${inMonth ? '' : 'opacity-40'}"><div class="flex items-center justify-between"><span class="text-xs ${sameDay(d, now) ? 'inline-flex h-5 w-5 items-center justify-center rounded-full bg-brand-600 text-white font-bold' : 'text-slate-500'}">${d.getDate()}</span>${ss.length ? `<span class="text-[9px] text-emerald-500" title="${S.queueSlot}">${ss.length} <i class="fa-regular fa-clock"></i></span>` : ''}</div><div class="mt-1 space-y-0.5">${ps.map(chip).join('')}</div></div>`; }).join('')}</div>`;
    };
    const load = async () => { const d = await api('/api/uploadposts/schedule'); posts = d.scheduled_posts; try { const profiles = await api('/api/uploadposts/users'); slots = []; for (const p of profiles.profiles.slice(0, 5)) { const q = await api(`/api/uploadposts/queue/preview?profile_username=${encodeURIComponent(p.username)}&count=40`); slots.push(...q.slots); } } catch {} render(); };
    document.querySelectorAll<HTMLElement>('[data-view]').forEach((b) => b.addEventListener('click', () => { view = b.dataset.view!; localStorage.setItem('cal_view', view); render(); }));
    document.getElementById('prev')!.addEventListener('click', () => { view === 'week' ? cursor.setDate(cursor.getDate() - 7) : cursor.setMonth(cursor.getMonth() - 1); render(); });
    document.getElementById('next')!.addEventListener('click', () => { view === 'week' ? cursor.setDate(cursor.getDate() + 7) : cursor.setMonth(cursor.getMonth() + 1); render(); });
    document.getElementById('today')!.addEventListener('click', () => { cursor = new Date(); render(); });
    const modal = document.getElementById('edit-modal')!; const form = document.getElementById('edit-form') as HTMLFormElement;
    document.getElementById('grid')!.addEventListener('click', (e) => { const b = (e.target as HTMLElement).closest<HTMLElement>('[data-job]'); if (!b) return; const p = posts.find((x) => x.job_id === b.dataset.job); if (!p) return; (form.elements.namedItem('job_id') as HTMLInputElement).value = p.job_id; (form.elements.namedItem('title') as HTMLInputElement).value = p.title || ''; const d = new Date(p.scheduled_date); (form.elements.namedItem('scheduled_date') as HTMLInputElement).value = new Date(d.getTime() - d.getTimezoneOffset() * 60000).toISOString().slice(0, 16); modal.classList.remove('hidden'); });
    modal.querySelectorAll('[data-close]').forEach((b) => b.addEventListener('click', () => modal.classList.add('hidden')));
    form.addEventListener('submit', async (e) => { e.preventDefault(); const id = (form.elements.namedItem('job_id') as HTMLInputElement).value; const sd = new Date((form.elements.namedItem('scheduled_date') as HTMLInputElement).value).toISOString(); try { await api(`/api/uploadposts/schedule/${id}`, { method: 'PATCH', body: JSON.stringify({ title: (form.elements.namedItem('title') as HTMLInputElement).value, scheduled_date: sd }) }); modal.classList.add('hidden'); toast('✓'); load(); } catch (err: any) { toast(err.message, 'err'); } });
    document.getElementById('cancel-job')!.addEventListener('click', async () => { if (!confirm(S.confirm)) return; const id = (form.elements.namedItem('job_id') as HTMLInputElement).value; try { await api(`/api/uploadposts/schedule/${id}`, { method: 'DELETE' }); modal.classList.add('hidden'); toast('✓'); load(); } catch (err: any) { toast(err.message, 'err'); } });
    load();
  </script>
</AppLayout>
