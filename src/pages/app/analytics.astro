---
import AppLayout from '../../layouts/AppLayout.astro';
import { getAppDict } from '../../i18n/app';
import { PLATFORMS } from '../../lib/platforms';
import { listProfiles, accountsOf } from '../../server/uploads';
const user = Astro.locals.user; if (!user) return Astro.redirect('/app/login', 303);
const lang = Astro.locals.lang; const a = getAppDict(lang); const an = a.analytics;
const owner = user.owner_user_id || user.id;
const ANALYTICS_PLATFORMS = ['instagram', 'tiktok', 'linkedin', 'facebook', 'x', 'youtube', 'threads', 'pinterest', 'reddit', 'bluesky'];
const profiles = listProfiles(owner).map((p) => ({ username: p.username, platforms: accountsOf(p.id).map((x) => x.platform).filter((k) => ANALYTICS_PLATFORMS.includes(k)) }));
const plat = Object.fromEntries(PLATFORMS.map((p) => [p.key, { name: p.name, icon: p.icon, color: p.color }]));
---
<AppLayout title={an.title} subtitle={an.subtitle} active="analytics" wide>
  <div id="an" data-profiles={JSON.stringify(profiles)} data-plat={JSON.stringify(plat)} data-lang={lang} data-s={JSON.stringify(an)}>
    <div class="card p-3 mb-4 flex flex-wrap items-center gap-2">
      <select id="profile" class="input input-select !w-auto !py-2 text-sm">{profiles.map((p) => <option value={p.username}>{p.username}</option>)}</select>
      <div id="plats" class="flex flex-wrap gap-1.5"></div>
      <select id="days" class="input input-select !w-auto !py-2 text-sm ml-auto"><option value="7">7 {an.days}</option><option value="30" selected>30 {an.days}</option><option value="90">90 {an.days}</option></select>
    </div>
    <div id="empty" class="hidden card p-8 text-center text-sm text-slate-500">{an.noAccounts} <a href="/app/manage-users" class="text-brand-600 underline">{a.nav.profiles}</a></div>
    <div id="cards" class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4"></div>
    <div class="mt-4 grid lg:grid-cols-[1.4fr_1fr] gap-4">
      <div class="card p-5"><h3 class="font-semibold text-slate-900 dark:text-white mb-3" id="chart-title">{an.growth}</h3><div class="flex items-center gap-2 mb-2 text-xs" id="metric-tabs"></div><svg id="chart" viewBox="0 0 800 260" class="w-full h-64"></svg></div>
      <div class="card p-5"><h3 class="font-semibold text-slate-900 dark:text-white mb-3">{an.perPost}</h3><ul id="posts" class="divide-y divide-slate-100 dark:divide-slate-800 text-sm max-h-72 overflow-auto"></ul></div>
    </div>
    <div id="audience-wrap" class="hidden mt-4 grid lg:grid-cols-2 gap-4"><div class="card p-5"><h3 class="font-semibold text-slate-900 dark:text-white mb-3">{an.bestHours}</h3><svg id="hours" viewBox="0 0 800 160" class="w-full h-40"></svg></div><div class="card p-5"><h3 class="font-semibold text-slate-900 dark:text-white mb-3">{an.audience}</h3><div id="audience" class="grid grid-cols-2 gap-4 text-xs"></div></div></div>
  </div>
  <script>
    const root = document.getElementById('an')!; const profiles = JSON.parse(root.dataset.profiles!); const PL = JSON.parse(root.dataset.plat!); const S = JSON.parse(root.dataset.s!); const lang = root.dataset.lang!; const api = (window as any).api;
    const $ = (id: string) => document.getElementById(id)!; let data: any = {}; let metric = 'followers'; let platform = '';
    const fmt = (n: number) => new Intl.NumberFormat(lang, { notation: n > 9999 ? 'compact' : 'standard', maximumFractionDigits: 1 }).format(n || 0);
    const renderPlats = () => { const p = profiles.find((x: any) => x.username === ($('profile') as HTMLSelectElement).value); const box = $('plats'); box.innerHTML = (p?.platforms || []).map((k: string) => `<button type="button" data-k="${k}" class="inline-flex items-center gap-1.5 rounded-lg border px-2.5 py-1.5 text-xs font-medium ${platform === k ? 'border-brand-500 bg-brand-50 dark:bg-brand-500/15' : 'border-slate-200 dark:border-slate-700'}"><i class="${PL[k].icon}" style="color:${PL[k].color}"></i>${PL[k].name}</button>`).join(''); $('empty').classList.toggle('hidden', !!p?.platforms.length); if (!platform || !p?.platforms.includes(platform)) platform = p?.platforms[0] || ''; };
    const load = async () => { renderPlats(); if (!platform) { $('cards').innerHTML = ''; return; } const u = ($('profile') as HTMLSelectElement).value; const d = await api(`/api/analytics/${encodeURIComponent(u)}?platforms=${platform}&days=${($('days') as HTMLSelectElement).value}`); data = d[platform] || {}; render(); const pm = await api(`/api/uploadposts/post-analytics/cached?user=${encodeURIComponent(u)}&platform=${platform}&limit=20`).catch(() => ({ posts: [] })); $('posts').innerHTML = pm.posts.length ? pm.posts.map((p: any) => `<li class="py-2 flex items-center gap-3"><div class="flex-1 min-w-0"><a href="${p.post_url}" target="_blank" class="block truncate text-slate-800 dark:text-slate-100 hover:text-brand-600">${p.post_url || p.post_id}</a><div class="text-[11px] text-slate-400">${new Date(p.upload_timestamp).toLocaleDateString(lang)}</div></div><div class="flex gap-3 text-xs text-slate-500"><span title="${S.views}"><i class="fa-regular fa-eye"></i> ${fmt(p.metrics.views)}</span><span title="${S.likes}"><i class="fa-regular fa-heart"></i> ${fmt(p.metrics.likes)}</span><span title="${S.comments}"><i class="fa-regular fa-comment"></i> ${fmt(p.metrics.comments)}</span></div></li>`).join('') : `<li class="py-6 text-center text-slate-400 text-xs">—</li>`; if (platform === 'tiktok') { const au = await api(`/api/uploadposts/audience?platform=tiktok&user=${encodeURIComponent(u)}`).catch(() => null); $('audience-wrap').classList.toggle('hidden', !au); if (au) renderAudience(au); } else $('audience-wrap').classList.add('hidden'); };
    const render = () => {
      const cards = [[S.followers, data.followers_count, data.followers_gained], [S.views, data.views], [S.likes, data.likes], [S.comments, data.comments], [S.shares, data.shares], [S.reach, data.reach], [S.impressions, data.impressions], [S.engagement, (data.engagement_rate || 0) + '%']];
      $('cards').innerHTML = cards.map(([l, v, d]) => `<div class="card p-4"><div class="text-xs text-slate-500">${l}</div><div class="text-2xl font-bold text-slate-900 dark:text-white">${typeof v === 'string' ? v : fmt(v)}</div>${d !== undefined ? `<div class="text-xs ${d >= 0 ? 'text-emerald-500' : 'text-rose-500'}">${d >= 0 ? '+' : ''}${fmt(d)} · ${S.last30}</div>` : ''}</div>`).join('');
      const metrics = ['followers', 'views', 'likes', 'comments', 'shares', 'reach']; $('metric-tabs').innerHTML = metrics.map((m) => `<button type="button" data-m="${m}" class="rounded-md px-2 py-1 ${metric === m ? 'bg-brand-600 text-white' : 'bg-slate-100 dark:bg-slate-800'}">${S[m]}</button>`).join('');
      drawChart((data.time_series || []).map((x: any) => ({ date: x.date, v: x[metric] })));
    };
    const drawChart = (pts: { date: string; v: number }[]) => { const svg = $('chart'); if (!pts.length) { svg.innerHTML = ''; return; } const W = 800, H = 260, P = 36; const vs = pts.map((p) => p.v); const min = Math.min(...vs), max = Math.max(...vs); const r = max - min || 1; const x = (i: number) => P + (i / Math.max(1, pts.length - 1)) * (W - P * 2); const y = (v: number) => H - P - ((v - min) / r) * (H - P * 2); const d = pts.map((p, i) => `${i ? 'L' : 'M'}${x(i).toFixed(1)},${y(p.v).toFixed(1)}`).join(' '); const ticks = [0, 0.5, 1].map((t) => min + r * t); svg.innerHTML = `<defs><linearGradient id="ag" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#6366f1" stop-opacity=".35"/><stop offset="1" stop-color="#6366f1" stop-opacity="0"/></linearGradient></defs>${ticks.map((t) => `<line x1="${P}" x2="${W - P}" y1="${y(t)}" y2="${y(t)}" stroke="currentColor" stroke-opacity=".08"/><text x="${P - 6}" y="${y(t) + 4}" text-anchor="end" font-size="10" fill="currentColor" fill-opacity=".5">${fmt(t)}</text>`).join('')}<path d="${d} L${x(pts.length - 1)},${H - P} L${x(0)},${H - P} Z" fill="url(#ag)"/><path d="${d}" fill="none" stroke="#6366f1" stroke-width="2.5" stroke-linejoin="round"/>${pts.filter((_, i) => i % Math.ceil(pts.length / 6) === 0 || i === pts.length - 1).map((p, _, arr) => { const i = pts.indexOf(p); return `<text x="${x(i)}" y="${H - P + 16}" text-anchor="middle" font-size="10" fill="currentColor" fill-opacity=".5">${new Date(p.date).toLocaleDateString(lang, { day: 'numeric', month: 'short' })}</text>`; }).join('')}`; };
    const renderAudience = (au: any) => { const hs = au.activity_by_hour; const max = Math.max(...hs.map((h: any) => h.followers_online)); $('hours').innerHTML = hs.map((h: any, i: number) => { const v = h.followers_online / max; return `<rect x="${12 + i * 32.5}" y="${140 - v * 120}" width="22" height="${v * 120}" rx="3" fill="#6366f1" fill-opacity="${0.35 + v * 0.65}"/><text x="${23 + i * 32.5}" y="154" text-anchor="middle" font-size="9" fill="currentColor" fill-opacity=".5">${h.hour}h</text>`; }).join(''); const list = (t: string, arr: any[], k: string) => `<div><div class="font-semibold text-slate-700 dark:text-slate-200 mb-1">${t}</div>${arr.slice(0, 5).map((x) => `<div class="flex justify-between"><span>${x[k]}</span><span class="text-slate-400">${Math.round(x.percentage * 100)}%</span></div>`).join('')}</div>`; $('audience').innerHTML = list('Countries', au.audience.countries, 'country') + list('Ages', au.audience.ages, 'age') + list('Cities', au.audience.cities, 'city') + list('Genders', au.audience.genders, 'gender'); };
    $('profile').addEventListener('change', () => { platform = ''; load(); }); $('days').addEventListener('change', load);
    $('plats').addEventListener('click', (e) => { const b = (e.target as HTMLElement).closest<HTMLElement>('[data-k]'); if (b) { platform = b.dataset.k!; load(); } });
    $('metric-tabs').addEventListener('click', (e) => { const b = (e.target as HTMLElement).closest<HTMLElement>('[data-m]'); if (b) { metric = b.dataset.m!; render(); } });
    load();
  </script>
</AppLayout>
