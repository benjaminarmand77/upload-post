---
import AppLayout from '../../layouts/AppLayout.astro';
import { getAppDict } from '../../i18n/app';
import { run, parse } from '../../server/db';
import { isValidTimezone } from '../../server/queue';
import { getUser, destroySession } from '../../server/auth';
import { deleteProfile } from '../../server/connect';
import { listProfiles } from '../../server/uploads';
const user0 = Astro.locals.user; if (!user0) return Astro.redirect('/app/login', 303);
const lang = Astro.locals.lang; const a = getAppDict(lang); const s = a.settings;
let user = user0; let msg: string | null = null;
if (Astro.request.method === 'POST') {
  const fd = await Astro.request.formData();
  if (fd.get('action') === 'delete' && fd.get('confirm') === user.email) {
    for (const p of listProfiles(user.id)) await deleteProfile(p.id);
    for (const tbl of ['sessions', 'api_keys', 'uploads', 'upload_results', 'media_files', 'scheduled_jobs', 'notifications', 'webhook_deliveries', 'ffmpeg_jobs', 'usage', 'events', 'ai_jobs', 'autodm_monitors']) run(`DELETE FROM ${tbl} WHERE user_id = ?`, user.id);
    run('DELETE FROM team_members WHERE owner_user_id = ? OR member_user_id = ?', user.id, user.id); run('DELETE FROM users WHERE id = ?', user.id);
    Astro.cookies.delete('up_session', { path: '/' }); return Astro.redirect('/app/login?deleted=1', 303);
  }
  const tz = String(fd.get('timezone') || 'UTC'); const settings = { ...parse(user.settings_json, {}), email_notifications: fd.get('email_notifications') === 'on', marketing_emails: fd.get('marketing_emails') === 'on' };
  if (!isValidTimezone(tz)) msg = 'Invalid timezone'; else { run('UPDATE users SET name = ?, timezone = ?, locale = ?, settings_json = ? WHERE id = ?', String(fd.get('name') || '').slice(0, 80), tz, String(fd.get('locale') || 'en'), JSON.stringify(settings), user.id); Astro.cookies.set('lang', String(fd.get('locale') || 'en'), { path: '/', maxAge: 31536000 }); user = getUser(user.id)!; msg = a.common.saved; }
}
const st = parse(user.settings_json, {} as any);
---
<AppLayout title={s.title} subtitle={s.subtitle} active="settings">
  {msg && <div class="mb-5 rounded-xl bg-slate-100 dark:bg-slate-800 px-4 py-3 text-sm">{msg}</div>}
  <form method="post" class="card p-6 space-y-4 max-w-2xl">
    <div class="grid sm:grid-cols-2 gap-4"><div><label class="label">{s.name}</label><input name="name" class="input" value={user.name || ''} /></div><div><label class="label">{s.email}</label><input class="input" value={user.email} disabled /></div></div>
    <div class="grid sm:grid-cols-2 gap-4"><div><label class="label">{s.timezone}</label><input name="timezone" class="input" value={user.timezone || 'UTC'} list="tzs" /><datalist id="tzs">{['UTC', 'Europe/Paris', 'Europe/London', 'Europe/Madrid', 'Europe/Berlin', 'America/New_York', 'America/Los_Angeles', 'America/Sao_Paulo', 'Asia/Tokyo', 'Australia/Sydney'].map((z) => <option value={z}></option>)}</datalist></div><div><label class="label">{s.language}</label><select name="locale" class="input input-select"><option value="en" selected={user.locale === 'en'}>English</option><option value="fr" selected={user.locale === 'fr'}>Français</option></select></div></div>
    <label class="flex items-center gap-2 text-sm"><input type="checkbox" name="email_notifications" class="rounded" checked={st.email_notifications !== false} />{s.emailNotif}</label>
    <label class="flex items-center gap-2 text-sm"><input type="checkbox" name="marketing_emails" class="rounded" checked={!!st.marketing_emails} />{s.marketing}</label>
    <button class="btn-primary">{a.common.save}</button>
  </form>
  <div class="card mt-6 p-6 max-w-2xl border-rose-300/60"><h3 class="font-semibold text-rose-600">{s.danger}</h3><p class="help">{s.deleteHelp}</p><form method="post" class="mt-3 flex flex-col sm:flex-row gap-2" onsubmit="return confirm('?')"><input type="hidden" name="action" value="delete" /><input name="confirm" class="input" placeholder={user.email} required /><button class="btn-secondary !text-rose-600 whitespace-nowrap"><i class="fa-solid fa-trash"></i>{s.deleteAccount}</button></form></div>
</AppLayout>
