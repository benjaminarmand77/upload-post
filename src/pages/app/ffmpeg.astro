---
import AppLayout from '../../layouts/AppLayout.astro';
import { getAppDict } from '../../i18n/app';
import { all } from '../../server/db';
import { ffmpegAvailable, ffmpegConsumption } from '../../server/ffmpeg';
import { fmtDate } from '../../lib/i18n';
const user = Astro.locals.user; if (!user) return Astro.redirect('/app/login', 303);
const lang = Astro.locals.lang; const a = getAppDict(lang); const f = a.ffmpeg;
const owner = user.owner_user_id || user.id;
const jobs = all<any>('SELECT * FROM ffmpeg_jobs WHERE user_id = ? ORDER BY created_at DESC LIMIT 30', owner);
const cons = ffmpegConsumption({ ...user, id: owner } as any); const installed = !!ffmpegAvailable();
const defaultCommand = 'ffmpeg -y -i {input} -c:v libx264 -preset fast -crf 23 -c:a aac {output}';
---
<AppLayout title={f.title} subtitle={f.subtitle} active="ffmpeg" wide>
  {!installed && <div class="mb-5 rounded-xl border border-amber-300/60 bg-amber-50 dark:bg-amber-500/10 px-4 py-3 text-sm text-amber-800 dark:text-amber-300"><i class="fa-solid fa-triangle-exclamation mr-2"></i>{f.notInstalled}</div>}
  <div class="grid lg:grid-cols-[1fr_340px] gap-6">
    <form id="ff-form" class="card p-5 space-y-4" enctype="multipart/form-data">
      <div><label class="label">{f.presets}</label><div class="flex flex-wrap gap-1.5">{f.presetList.map(([n, cmd, ext]) => <button type="button" class="chip hover:bg-brand-50 hover:text-brand-700 cursor-pointer" data-cmd={cmd} data-ext={ext}>{n}</button>)}</div></div>
      <div><label class="label">{f.input}</label><input type="file" name="file" class="input" /><input name="files" class="input mt-2 text-sm" placeholder="https://…/video.mp4 (URL)" /></div>
      <div><label class="label">{f.command}</label><textarea name="full_command" rows="3" class="input font-mono text-xs" required set:text={defaultCommand}></textarea><p class="help">{f.commandHelp}</p></div>
      <div class="flex items-end gap-3"><div><label class="label">{f.ext}</label><input name="output_extension" class="input !w-28" value="mp4" required /></div><button class="btn-primary"><i class="fa-solid fa-play"></i>{f.run}</button></div>
    </form>
    <div class="card p-5"><h3 class="font-semibold text-slate-900 dark:text-white">{f.quota}</h3><div class="mt-3 text-3xl font-bold text-brand-600">{cons.consumption.used_minutes} <span class="text-sm text-slate-400 font-normal">{`/ ${cons.consumption.quota_minutes} min`}</span></div><div class="mt-2 h-2 rounded-full bg-slate-200 dark:bg-slate-800 overflow-hidden"><div class="h-full bg-brand-500" style={`width:${Math.min(100, cons.consumption.usage_percentage)}%`}></div></div><p class="help">{cons.consumption.total_requests} jobs · reset {fmtDate(cons.quota_info.next_reset, lang)}</p></div>
  </div>
  <div class="card mt-6 overflow-hidden"><div class="px-5 py-3 font-semibold text-slate-900 dark:text-white border-b border-slate-100 dark:border-slate-800">{f.jobs}</div>
    <table class="w-full text-sm"><tbody id="jobs" class="divide-y divide-slate-100 dark:divide-slate-800">{jobs.map((j) => <tr data-job={j.job_id} data-status={j.status}><td class="px-5 py-2.5 font-mono text-xs">{j.job_id}</td><td class="px-2 py-2.5 text-xs text-slate-500 truncate max-w-xs" title={j.full_command}>{j.full_command}</td><td class="px-2 py-2.5 text-xs">{j.output_extension}</td><td class="px-2 py-2.5"><span class={`badge-${j.status === 'FINISHED' ? 'ok' : j.status === 'ERROR' ? 'err' : 'warn'}`} data-st>{j.status}</span>{j.error && <div class="text-[11px] text-rose-500 max-w-xs truncate" title={j.error}>{j.error}</div>}</td><td class="px-2 py-2.5 text-xs text-slate-500">{fmtDate(j.created_at, lang, { dateStyle: 'short', timeStyle: 'short' })}</td><td class="px-5 py-2.5 text-right" data-dl>{j.status === 'FINISHED' && <a href={`/api/uploadposts/ffmpeg/jobs/${j.job_id}/download`} class="btn-secondary btn-sm"><i class="fa-solid fa-download"></i>{f.download}</a>}</td></tr>)}</tbody></table>
    {jobs.length === 0 && <p class="p-6 text-center text-sm text-slate-500">—</p>}
  </div>
  <script>
    const api = (window as any).api, toast = (window as any).toast; const form = document.getElementById('ff-form') as HTMLFormElement;
    document.querySelectorAll<HTMLElement>('[data-cmd]').forEach((b) => b.addEventListener('click', () => { (form.elements.namedItem('full_command') as HTMLTextAreaElement).value = b.dataset.cmd!; (form.elements.namedItem('output_extension') as HTMLInputElement).value = b.dataset.ext!; }));
    form.addEventListener('submit', async (e) => { e.preventDefault(); const fd = new FormData(form); if (!(fd.get('file') as File)?.size) fd.delete('file'); if (!fd.get('files')) fd.delete('files'); try { const d = await api('/api/uploadposts/ffmpeg/jobs/upload', { method: 'POST', body: fd }); toast(`Job ${d.job_id} ${d.status}`); setTimeout(() => location.reload(), 1500); } catch (err: any) { toast(err.message, 'err'); } });
    const pending = [...document.querySelectorAll<HTMLElement>('[data-job]')].filter((r) => ['PENDING', 'PROCESSING'].includes(r.dataset.status!));
    if (pending.length) { const t = setInterval(async () => { let left = 0; for (const r of pending) { if (!['PENDING', 'PROCESSING'].includes(r.dataset.status!)) continue; const d = await api(`/api/uploadposts/ffmpeg/jobs/${r.dataset.job}`); r.dataset.status = d.status; r.querySelector('[data-st]')!.textContent = d.status; if (d.status === 'FINISHED') r.querySelector('[data-dl]')!.innerHTML = `<a href="${d.download_url}" class="btn-secondary btn-sm"><i class="fa-solid fa-download"></i></a>`; else if (d.status === 'ERROR') r.querySelector('[data-st]')!.className = 'badge-err'; else left++; } if (!left) clearInterval(t); }, 3000); }
  </script>
</AppLayout>
