---
import AppLayout from '../../layouts/AppLayout.astro';
import { getAppDict } from '../../i18n/app';
import { limitsOf, usageOf } from '../../server/plans';
const user = Astro.locals.user; if (!user) return Astro.redirect('/app/login', 303);
const lang = Astro.locals.lang; const a = getAppDict(lang); const ai = a.ai;
const owner = user.owner_user_id || user.id; const limits = limitsOf(user); const usage = usageOf(owner);
const hasKey = !!process.env.ANTHROPIC_API_KEY;
---
<AppLayout title={ai.title} subtitle={ai.subtitle} active="ai-shorts" wide>
  {!hasKey && <div class="mb-5 rounded-xl border border-amber-300/60 bg-amber-50 dark:bg-amber-500/10 px-4 py-3 text-sm text-amber-800 dark:text-amber-300"><i class="fa-solid fa-circle-info mr-2"></i>{ai.noKey}</div>}
  <div class="grid lg:grid-cols-[1fr_1fr] gap-6">
    <form id="ai-form" class="card p-5 space-y-4" enctype="multipart/form-data">
      <div><label class="label">{ai.video}</label><input type="file" name="video" accept="video/*" class="input" /></div>
      <div><label class="label">{a.common.title}</label><input name="title" class="input" /></div>
      <div><label class="label">{ai.context}</label><textarea name="transcript" rows="5" class="input"></textarea></div>
      <div class="flex items-end gap-3"><div><label class="label">{ai.language}</label><select name="language" class="input input-select !w-40"><option value="en">English</option><option value="fr" selected={lang === 'fr'}>Français</option><option value="es">Español</option><option value="de">Deutsch</option><option value="pt">Português</option><option value="it">Italiano</option></select></div><button class="btn-primary"><i class="fa-solid fa-wand-magic-sparkles"></i>{ai.analyze}</button><span class="ml-auto text-xs text-slate-500">{ai.quota}: <b id="q">{usage.ai_shorts}</b> / {limits.aiShorts}</span></div>
    </form>
    <div class="card p-5"><h3 class="font-semibold text-slate-900 dark:text-white">{ai.result}</h3><div id="out" class="mt-3 space-y-3 text-sm text-slate-500">—</div><div id="out-actions" class="hidden mt-4 flex flex-wrap gap-2"><a id="use" class="btn-primary btn-sm" href="#"><i class="fa-solid fa-cloud-arrow-up"></i>{ai.useIn}</a><select id="rw-lang" class="input input-select !w-36 !py-2 text-sm"><option value="en">English</option><option value="fr">Français</option><option value="es">Español</option><option value="de">Deutsch</option><option value="ja">日本語</option></select><button type="button" id="rw" class="btn-secondary btn-sm">{ai.rewrite}</button></div></div>
  </div>
  <script>
    const api = (window as any).api, toast = (window as any).toast; const form = document.getElementById('ai-form') as HTMLFormElement; let last: any = null;
    const ic: Record<string, string> = { youtube: 'fa-brands fa-youtube', instagram: 'fa-brands fa-instagram', tiktok: 'fa-brands fa-tiktok' };
    const render = (p: any) => { last = p; document.getElementById('out')!.innerHTML = Object.entries(p).map(([k, v]: any) => `<div class="rounded-xl border border-slate-200 dark:border-slate-700 p-3"><div class="flex items-center gap-2 font-semibold text-slate-900 dark:text-white capitalize"><i class="${ic[k]}"></i>${k}<button type="button" class="ml-auto text-xs text-brand-600" data-copy="${(v.title + '\n\n' + v.description).replace(/"/g, '&quot;')}">Copy</button></div><div class="mt-1 text-slate-800 dark:text-slate-100">${v.title}</div><div class="mt-1 whitespace-pre-wrap text-slate-500">${v.description}</div><div class="mt-1 text-xs text-brand-600">${(v.hashtags || []).map((h: string) => '#' + h).join(' ')}</div></div>`).join(''); const u = new URL('/app/upload', location.origin); u.searchParams.set('title', p.youtube?.title || ''); u.searchParams.set('description', p.youtube?.description || ''); (document.getElementById('use') as HTMLAnchorElement).href = u.toString(); document.getElementById('out-actions')!.classList.remove('hidden'); };
    form.addEventListener('submit', async (e) => { e.preventDefault(); const fd = new FormData(form); if (!(fd.get('video') as File)?.size) fd.delete('video'); try { const d = await api('/api/uploadposts/analyze-shorts', { method: 'POST', body: fd }); render(d.analysis.platforms); document.getElementById('q')!.textContent = d.quota.used; } catch (err: any) { toast(err.message, 'err'); } });
    document.getElementById('rw')!.addEventListener('click', async () => { if (!last) return; try { const d = await api('/api/uploadposts/rewrite-captions', { method: 'POST', body: JSON.stringify({ captions: last, language: (document.getElementById('rw-lang') as HTMLSelectElement).value }) }); render(d.captions); } catch (err: any) { toast(err.message, 'err'); } });
  </script>
</AppLayout>
