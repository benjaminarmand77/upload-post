---
import AppLayout from '../../layouts/AppLayout.astro';
import { getAppDict } from '../../i18n/app';
import { PLATFORMS } from '../../lib/platforms';
import { listProfiles, accountsOf } from '../../server/uploads';
const user = Astro.locals.user; if (!user) return Astro.redirect('/app/login', 303);
const lang = Astro.locals.lang; const a = getAppDict(lang); const ib = a.inbox;
const owner = user.owner_user_id || user.id;
const OK = ['instagram', 'facebook', 'youtube', 'linkedin', 'tiktok'];
const profiles = listProfiles(owner).map((p) => ({ username: p.username, platforms: accountsOf(p.id).map((x) => x.platform).filter((k) => OK.includes(k)) }));
const plat = Object.fromEntries(PLATFORMS.map((p) => [p.key, { name: p.name, icon: p.icon, color: p.color }]));
---
<AppLayout title={ib.title} subtitle={ib.subtitle} active="inbox" wide>
  <div id="ib" data-profiles={JSON.stringify(profiles)} data-plat={JSON.stringify(plat)} data-lang={lang} data-s={JSON.stringify({ ...ib, confirm: a.common.confirmDelete })}>
    <div class="card p-3 mb-4 flex flex-wrap items-center gap-2"><select id="profile" class="input input-select !w-auto !py-2 text-sm">{profiles.map((p) => <option value={p.username}>{p.username}</option>)}</select><div id="plats" class="flex flex-wrap gap-1.5"></div></div>
    <div class="grid lg:grid-cols-[320px_1fr] gap-4">
      <div class="card p-3"><div class="text-xs font-semibold text-slate-500 mb-2">{ib.selectPost}</div><ul id="post-list" class="divide-y divide-slate-100 dark:divide-slate-800 text-sm max-h-[60vh] overflow-auto"></ul></div>
      <div class="space-y-4">
        <div class="card p-4"><div class="flex items-center justify-between mb-3"><h3 class="font-semibold text-slate-900 dark:text-white">{ib.comments}</h3><span id="post-link" class="text-xs"></span></div><ul id="comments" class="space-y-3 text-sm"></ul><form id="comment-form" class="hidden mt-4 flex gap-2"><input name="message" class="input !py-2" placeholder={ib.reply} required /><input type="hidden" name="comment_id" /><button class="btn-primary btn-sm whitespace-nowrap">{ib.send}</button></form></div>
        <div id="dm-card" class="card p-4 hidden"><h3 class="font-semibold text-slate-900 dark:text-white mb-3">{ib.dms}</h3><div id="dms" class="grid sm:grid-cols-2 gap-3 text-sm"></div></div>
        <div id="autodm-card" class="card p-4 hidden"><h3 class="font-semibold text-slate-900 dark:text-white">{ib.autodm}</h3><p class="help mb-3">{ib.autodmHelp}</p><form id="autodm-form" class="grid sm:grid-cols-[1fr_1fr_auto] gap-2"><input name="keywords" class="input !py-2 text-sm" placeholder={`${ib.keywords} (a, b)`} required /><input name="message" class="input !py-2 text-sm" placeholder={ib.message} required /><button class="btn-primary btn-sm">{ib.createMonitor}</button></form><ul id="monitors" class="mt-3 text-xs space-y-1"></ul></div>
      </div>
    </div>
  </div>
  <script>
    const root = document.getElementById('ib')!; const profiles = JSON.parse(root.dataset.profiles!); const PL = JSON.parse(root.dataset.plat!); const S = JSON.parse(root.dataset.s!); const lang = root.dataset.lang!; const api = (window as any).api, toast = (window as any).toast;
    const $ = (id: string) => document.getElementById(id)!; let platform = ''; let post: any = null;
    const u = () => ($('profile') as HTMLSelectElement).value;
    const renderPlats = () => { const p = profiles.find((x: any) => x.username === u()); if (!platform || !p?.platforms.includes(platform)) platform = p?.platforms[0] || ''; $('plats').innerHTML = (p?.platforms || []).map((k: string) => `<button type="button" data-k="${k}" class="inline-flex items-center gap-1.5 rounded-lg border px-2.5 py-1.5 text-xs font-medium ${platform === k ? 'border-brand-500 bg-brand-50 dark:bg-brand-500/15' : 'border-slate-200 dark:border-slate-700'}"><i class="${PL[k].icon}" style="color:${PL[k].color}"></i>${PL[k].name}</button>`).join(''); };
    const loadPosts = async () => { renderPlats(); $('comments').innerHTML = ''; $('comment-form').classList.add('hidden'); if (!platform) { $('post-list').innerHTML = ''; return; } const d = await api(`/api/uploadposts/media?platform=${platform}&user=${encodeURIComponent(u())}&limit=30`).catch(() => ({ media: [] })); $('post-list').innerHTML = d.media.length ? d.media.map((m: any) => `<li><button type="button" data-post="${m.id}" data-url="${m.permalink || ''}" class="w-full text-left py-2 px-1 hover:bg-slate-50 dark:hover:bg-slate-800 rounded-md"><div class="truncate text-slate-800 dark:text-slate-100">${m.caption || m.id}</div><div class="text-[11px] text-slate-400">${new Date(m.timestamp).toLocaleDateString(lang)} · ${m.media_type}</div></button></li>`).join('') : `<li class="py-6 text-center text-xs text-slate-400">—</li>`; $('dm-card').classList.toggle('hidden', platform !== 'instagram'); $('autodm-card').classList.toggle('hidden', platform !== 'instagram'); if (platform === 'instagram') { loadDms(); loadMonitors(); } };
    const loadComments = async () => { if (!post) return; const d = await api(`/api/uploadposts/comments?platform=${platform}&user=${encodeURIComponent(u())}&post_id=${encodeURIComponent(post.id)}`); $('post-link').innerHTML = post.url ? `<a href="${post.url}" target="_blank" class="text-brand-600">${post.url} <i class="fa-solid fa-arrow-up-right-from-square text-[9px]"></i></a>` : ''; $('comment-form').classList.remove('hidden'); $('comments').innerHTML = d.comments.length ? d.comments.map((c: any) => `<li class="flex gap-3 ${c.hidden ? 'opacity-50' : ''}"><span class="h-8 w-8 shrink-0 rounded-full bg-slate-200 dark:bg-slate-700 inline-flex items-center justify-center text-xs font-bold">${(c.user.username || '?')[0].toUpperCase()}</span><div class="flex-1"><div class="text-xs"><b class="text-slate-900 dark:text-white">${c.user.username}</b> <span class="text-slate-400">${new Date(c.timestamp).toLocaleString(lang, { dateStyle: 'short', timeStyle: 'short' })}</span>${c.pinned ? ' <i class="fa-solid fa-thumbtack text-brand-500"></i>' : ''}</div><div class="text-slate-700 dark:text-slate-200">${c.text}</div><div class="mt-1 flex flex-wrap gap-2 text-[11px] text-slate-500">${c.replies_count ? `<span>${c.replies_count} ↳</span>` : ''}<button data-reply="${c.id}" class="hover:text-brand-600">${S.reply}</button>${platform === 'instagram' ? `<button data-private="${c.id}" class="hover:text-brand-600">${S.privateReply}</button>` : ''}${platform === 'tiktok' ? `<button data-action="${c.hidden ? 'unhide' : 'hide'}" data-id="${c.id}" class="hover:text-brand-600">${c.hidden ? S.unhide : S.hide}</button><button data-action="${c.liked ? 'unlike' : 'like'}" data-id="${c.id}" class="hover:text-brand-600">${S.like}${c.liked ? ' ♥' : ''}</button><button data-action="${c.pinned ? 'unpin' : 'pin'}" data-id="${c.id}" class="hover:text-brand-600">${S.pin}</button>` : ''}<button data-del="${c.id}" class="hover:text-rose-500">${S.deleteC}</button></div></div></li>`).join('') : `<li class="text-xs text-slate-400">${S.noComments}</li>`; };
    const loadDms = async () => { const d = await api(`/api/uploadposts/dms/conversations?platform=instagram&user=${encodeURIComponent(u())}`).catch(() => ({ conversations: [] })); $('dms').innerHTML = d.conversations.map((c: any) => { const other = c.participants.data[0]; const last = c.messages.data[c.messages.data.length - 1]; return `<div class="rounded-xl border border-slate-200 dark:border-slate-700 p-3"><div class="flex items-center justify-between text-xs"><b class="text-slate-900 dark:text-white">@${other.username}</b><span class="text-slate-400">${new Date(c.updated_time).toLocaleDateString(lang)}</span></div><div class="mt-1 text-slate-600 dark:text-slate-300 line-clamp-2">${last?.message || ''}</div><form data-dm="${other.id}" class="mt-2 flex gap-1"><input class="input !py-1.5 text-xs" placeholder="${S.reply}" required /><button class="btn-primary btn-sm !px-2"><i class="fa-solid fa-paper-plane"></i></button></form></div>`; }).join(''); };
    const loadMonitors = async () => { const d = await api('/api/uploadposts/autodm?all=true').catch(() => ({ monitors: [] })); $('monitors').innerHTML = d.monitors.map((m: any) => `<li class="flex items-center gap-2"><span class="badge-${m.status === 'active' ? 'ok' : 'muted'}">${m.status}</span><span>${m.post_id}</span><span class="text-slate-400">${m.keywords.join(', ')}</span><span class="ml-auto">${m.sent_count} ✉</span>${m.status === 'active' ? `<button data-mon="pause" data-id="${m.monitor_id}" class="text-amber-500">⏸</button>` : m.status === 'paused' ? `<button data-mon="resume" data-id="${m.monitor_id}" class="text-emerald-500">▶</button>` : ''}<button data-mon="delete" data-id="${m.monitor_id}" class="text-rose-500">✕</button></li>`).join(''); };
    $('profile').addEventListener('change', () => { platform = ''; post = null; loadPosts(); }); $('plats').addEventListener('click', (e) => { const b = (e.target as HTMLElement).closest<HTMLElement>('[data-k]'); if (b) { platform = b.dataset.k!; post = null; loadPosts(); } });
    $('post-list').addEventListener('click', (e) => { const b = (e.target as HTMLElement).closest<HTMLElement>('[data-post]'); if (b) { post = { id: b.dataset.post, url: b.dataset.url }; loadComments(); } });
    const cf = $('comment-form') as HTMLFormElement; cf.addEventListener('submit', async (e) => { e.preventDefault(); const cid = (cf.elements.namedItem('comment_id') as HTMLInputElement).value; const msg = (cf.elements.namedItem('message') as HTMLInputElement).value; try { if (cid.startsWith('private:')) await api('/api/uploadposts/comments/reply', { method: 'POST', body: JSON.stringify({ platform: 'instagram', user: u(), comment_id: cid.slice(8), message: msg }) }); else await api('/api/uploadposts/comments/create', { method: 'POST', body: JSON.stringify({ platform, user: u(), message: msg, ...(cid ? { comment_id: cid } : { post_id: post.id }) }) }); cf.reset(); toast('✓'); loadComments(); } catch (err: any) { toast(err.message, 'err'); } });
    $('comments').addEventListener('click', async (e) => { const t = e.target as HTMLElement; const r = t.closest<HTMLElement>('[data-reply]'); const p = t.closest<HTMLElement>('[data-private]'); const d = t.closest<HTMLElement>('[data-del]'); const ac = t.closest<HTMLElement>('[data-action]'); try { if (r) { (cf.elements.namedItem('comment_id') as HTMLInputElement).value = r.dataset.reply!; (cf.elements.namedItem('message') as HTMLInputElement).focus(); } if (p) { (cf.elements.namedItem('comment_id') as HTMLInputElement).value = 'private:' + p.dataset.private; (cf.elements.namedItem('message') as HTMLInputElement).focus(); } if (d && confirm(S.confirm)) { await api('/api/uploadposts/comments/delete', { method: 'POST', body: JSON.stringify({ platform, user: u(), comment_id: d.dataset.del, post_id: post.id }) }); loadComments(); } if (ac) { await api('/api/uploadposts/comments/action', { method: 'POST', body: JSON.stringify({ platform, user: u(), comment_id: ac.dataset.id, action: ac.dataset.action, post_id: post.id }) }); loadComments(); } } catch (err: any) { toast(err.message, 'err'); } });
    $('dms').addEventListener('submit', async (e) => { e.preventDefault(); const f = e.target as HTMLFormElement; try { await api('/api/uploadposts/dms/send', { method: 'POST', body: JSON.stringify({ platform: 'instagram', user: u(), recipient_id: f.dataset.dm, message: (f.querySelector('input') as HTMLInputElement).value }) }); toast('✓'); loadDms(); } catch (err: any) { toast(err.message, 'err'); } });
    ($('autodm-form') as HTMLFormElement).addEventListener('submit', async (e) => { e.preventDefault(); const f = e.target as HTMLFormElement; if (!post) return toast(S.selectPost, 'err'); try { await api('/api/uploadposts/autodm', { method: 'POST', body: JSON.stringify({ platform: 'instagram', user: u(), post_id: post.id, keywords: (f.elements.namedItem('keywords') as HTMLInputElement).value, message: (f.elements.namedItem('message') as HTMLInputElement).value }) }); f.reset(); toast('✓'); loadMonitors(); } catch (err: any) { toast(err.message, 'err'); } });
    $('monitors').addEventListener('click', async (e) => { const b = (e.target as HTMLElement).closest<HTMLElement>('[data-mon]'); if (!b) return; await api('/api/uploadposts/autodm', { method: 'POST', body: JSON.stringify({ action: b.dataset.mon, monitor_id: b.dataset.id }) }); loadMonitors(); });
    loadPosts();
  </script>
</AppLayout>
