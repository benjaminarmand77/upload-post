---
import DocsLayout from '../../../layouts/DocsLayout.astro';
import CodeBlock from '../../../components/marketing/CodeBlock.astro';
const base = (process.env.SITE_URL || Astro.url.origin).replace(/\/$/, '');
const guide = Astro.params.guide!;
type Block = { h?: string; p?: string; code?: string; title?: string; ul?: string[] };
const GUIDES: Record<string, { title: string; blocks: Block[] }> = {
  authentication: { title: 'Authentication & profiles', blocks: [{ p: 'Every API request carries your workspace API key in the Authorization header. Keys are created in the dashboard (API keys) and shown once.' }, { code: `Authorization: Apikey YOUR_API_KEY` }, { h: 'Profiles', p: 'A profile represents one person, brand or client. It holds at most one connected account per platform. The profile name is the `user` field of every publishing request. Create profiles in the dashboard or with the API:' }, { code: `curl -X POST ${base}/api/uploadposts/users -H 'Authorization: Apikey YOUR_API_KEY' -H 'Content-Type: application/json' -d '{"username":"client-harbor"}'` }, { h: 'Connecting accounts', p: 'OAuth platforms (TikTok, Instagram, YouTube, LinkedIn, Facebook, X, Threads, Pinterest, Reddit, Google Business) connect from the dashboard or from a whitelabel connect link. Credential platforms (Discord, Telegram, Slack, Mastodon, Bluesky, WordPress, Dev.to, Hashnode, Lemmy, Whop, Listmonk, Nostr) take a key or token. When a platform has no OAuth app configured on the server (see Self-hosting), it runs in sandbox mode.' }, { h: 'Team members', p: 'Members invited from Team share the owner workspace: same profiles, same keys, same quota.' }] },
  scheduling: { title: 'Scheduling & queue', blocks: [{ p: 'Two ways to publish later: an exact date, or the profile publishing queue.' }, { h: 'Exact date', code: `-F "scheduled_date=2026-12-24T18:00:00" -F "timezone=Europe/Paris"`, p: 'scheduled_date is ISO-8601. Without a zone suffix it is interpreted in `timezone` (default UTC). It must be in the future and within 365 days. The response is HTTP 202 with a job_id.' }, { h: 'Queue', p: 'Configure slots (hour:minute) and active days per profile (dashboard → Profiles → Publishing queue, or POST /uploadposts/queue/settings). Then pass add_to_queue=true: the post takes the next free slot. Preview slots with GET /uploadposts/queue/preview.' }, { code: `curl -X POST ${base}/api/uploadposts/queue/settings -H 'Authorization: Apikey YOUR_API_KEY' -H 'Content-Type: application/json' \\\n  -d '{"profile_username":"default","timezone":"Europe/Paris","slots":[{"hour":9,"minute":0},{"hour":18,"minute":30}],"days_of_week":[0,1,2,3,4]}'` }, { h: 'Managing jobs', ul: ['GET /uploadposts/schedule — list pending jobs', 'PATCH /uploadposts/schedule/{job_id} — change date, title or caption', 'DELETE /uploadposts/schedule/{job_id} — cancel', 'GET /uploadposts/status?job_id=… — result once published'] }] },
  'async-uploads': { title: 'Async uploads & status', blocks: [{ p: 'By default /upload waits for every platform (up to 59 s) and returns per-platform results. Pass async_upload=true to get a request_id immediately; large videos switch to async automatically.' }, { code: `curl -X POST ${base}/api/upload -H 'Authorization: Apikey YOUR_API_KEY' -F user=default -F platform[]=youtube -F video=@big.mp4 -F title=Hello -F async_upload=true\n# → { "success": true, "request_id": "req_…", "total_platforms": 1 }\n\ncurl "${base}/api/uploadposts/status?request_id=req_…" -H 'Authorization: Apikey YOUR_API_KEY'\n# → { "status": "completed", "completed": 1, "total": 1, "results": [ { "platform": "youtube", "success": true, "url": "…" } ] }` }, { h: 'Statuses', ul: ['pending — not started', 'in_progress — some platforms done', 'completed — all platforms answered (check success per platform)'] }, { h: 'Retries', p: 'POST /uploadposts/posts/retry with the request_id re-runs only the failed platforms using the stored media.' }] },
  whitelabel: { title: 'Whitelabel connect page', blocks: [{ p: 'Let your clients connect their own social accounts on a page with your branding, without an Upload-Post account.' }, { code: `curl -X POST ${base}/api/uploadposts/users/generate-jwt -H 'Authorization: Apikey YOUR_API_KEY' -H 'Content-Type: application/json' \\\n  -d '{"username":"client-harbor","logo_image":"https://youragency.com/logo.png","connect_title":"Connect your accounts","redirect_url":"https://youragency.com/done","platforms":["instagram","tiktok","linkedin"],"language":"en"}'\n# → { "success": true, "access_url": "${base}/connect?token=…", "duration": "48h" }` }, { h: 'Options', ul: ['logo_image, connect_title, connect_description — branding', 'platforms — networks shown (default: all)', 'redirect_url, redirect_button_text — return button', 'show_calendar — show the client their scheduled posts', 'language — en, es, de, fr, pt, pl, tr', 'ui_labels — override any label'] }, { h: 'After connection', p: 'Publish with user=client-harbor. Subscribe to social_account.connected webhooks to react immediately. The link is bound to one profile and expires after 48 hours.' }] },
  webhooks: { title: 'Webhooks', blocks: [{ p: 'Receive a POST on your URL when a post is published or an account connection changes.' }, { code: `curl -X POST ${base}/api/uploadposts/users/notifications -H 'Authorization: Apikey YOUR_API_KEY' -H 'Content-Type: application/json' \\\n  -d '{"channels":{"webhook":true},"webhook_url":"https://example.com/hooks/upload-post","webhook_events":["upload_completed","social_account.connected"]}'` }, { h: 'Payload (upload_completed)', code: `{\n  "event": "upload_completed",\n  "user_email": "you@example.com",\n  "profile_username": "default",\n  "platform": "tiktok",\n  "media_type": "video",\n  "title": "My video",\n  "request_id": "req_…",\n  "job_id": null,\n  "result": { "success": true, "url": "https://www.tiktok.com/@you/video/7…", "post_id": "7…" },\n  "created_at": "2026-10-12T18:00:00.000Z"\n}` }, { h: 'Signature', p: 'Every delivery carries X-UploadPost-Signature: sha256=<hex HMAC-SHA256 of the raw body using your webhook_secret (returned by the notifications endpoint)>. Verify it before trusting the payload. Deliveries and responses are listed in the dashboard (Webhooks & notifications).' }, { h: 'Telegram', p: 'Set channels.telegram=true and telegram_chat_id to also receive a Telegram message (the server needs TELEGRAM_NOTIFY_BOT_TOKEN).' }] },
  errors: { title: 'Errors & limits', blocks: [{ p: 'Errors return HTTP 4xx/5xx with { success: false, message, error_code }. See the error code table in the API reference.' }, { h: 'Limits', ul: ['Video: 2 GB; documents: 100 MB / 300 pages', 'Photos per post: Instagram 10, Threads 20, X 4, Bluesky 4, Pinterest 5, TikTok 35', 'Text: X 280 (auto-thread), Threads 500 (auto-thread), Bluesky 300 (auto-thread), LinkedIn 3000, Instagram 2200, TikTok 2200, YouTube 5000, Facebook 63206, Pinterest 500, Mastodon 500, Discord 2000, Telegram 4096', 'Monthly uploads: Free 10, paid plans unlimited; FFmpeg minutes and AI analyses per plan', 'Scheduling horizon: 365 days'] }, { h: 'Rate limits', p: 'Publishing endpoints: 60 requests/minute per key. Analytics endpoints that call platforms: 100 requests / 5 minutes; use post-analytics/cached for bulk reads.' }] },
  mcp: { title: 'MCP server', blocks: [{ p: 'The MCP server is served by this installation at /mcp (Streamable HTTP, JSON-RPC 2.0). It exposes 50 tools mirroring the REST API, authenticated with your API key.' }, { code: JSON.stringify({ mcpServers: { 'upload-post': { url: `${base}/mcp`, headers: { Authorization: 'Apikey YOUR_API_KEY' } } } }, null, 2), title: 'claude_desktop_config.json' }, { code: `claude mcp add upload-post --transport http ${base}/mcp --header "Authorization: Apikey YOUR_API_KEY"`, title: 'Claude Code' }, { h: 'Test it', code: `curl -X POST ${base}/mcp -H 'Authorization: Apikey YOUR_API_KEY' -H 'Content-Type: application/json' -d '{"jsonrpc":"2.0","id":1,"method":"tools/list"}'` }] },
  'self-hosting': { title: 'Self-hosting & platform apps', blocks: [{ p: 'This installation runs everything locally: Node.js 24, SQLite, local media storage. Copy .env.example to .env and fill what you need.' }, { h: 'Real publishing', p: 'Each OAuth platform needs its own developer app. Set the keys in .env and the platform switches from sandbox to live automatically; existing sandbox connections must be reconnected.', ul: ['TIKTOK_CLIENT_KEY / TIKTOK_CLIENT_SECRET — TikTok for Developers (Content Posting API, Login Kit)', 'META_APP_ID / META_APP_SECRET — Meta app with Facebook Login, Instagram Graph API; THREADS_APP_ID / THREADS_APP_SECRET for Threads', 'YOUTUBE_CLIENT_ID / YOUTUBE_CLIENT_SECRET (or GOOGLE_*) — Google Cloud OAuth client with YouTube Data API v3', 'LINKEDIN_CLIENT_ID / LINKEDIN_CLIENT_SECRET — LinkedIn app with Share on LinkedIn + Community Management', 'X_CLIENT_ID / X_CLIENT_SECRET — X developer app (OAuth 2.0, media.write)', 'PINTEREST_APP_ID / PINTEREST_APP_SECRET, REDDIT_CLIENT_ID / REDDIT_CLIENT_SECRET, GOOGLE_BUSINESS_CLIENT_ID / SECRET', `Redirect URI for every app: ${base}/app/oauth/callback/<platform>`] }, { h: 'Email, AI, FFmpeg', ul: ['SMTP_* — magic-link emails (without SMTP the link is shown on screen)', 'ANTHROPIC_API_KEY — AI Shorts Uploader captions (heuristic fallback otherwise)', 'ffmpeg on PATH (or FFMPEG_PATH) — FFmpeg jobs', 'GOOGLE_CLIENT_ID / SECRET — Google sign-in'] }, { h: 'Production', code: `npm run build\nSITE_URL=https://your-domain.com APP_SECRET=… node ./dist/server/entry.mjs\n# behind a reverse proxy (Caddy, nginx) with HTTPS` }] },
};
const g = GUIDES[guide]; if (!g) return new Response(null, { status: 404 });
---
<DocsLayout title={g.title} active={`/docs/guides/${guide}`}>
  <div class="prose-up max-w-none"><h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">{g.title}</h1>{g.blocks.map((b) => <>{b.h && <h2>{b.h}</h2>}{b.p && <p>{b.p}</p>}{b.ul && <ul>{b.ul.map((x) => <li>{x}</li>)}</ul>}{b.code && <CodeBlock title={b.title || 'terminal'} code={b.code} />}</>)}</div>
</DocsLayout>
