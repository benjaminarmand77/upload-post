---
import DocsLayout from '../../layouts/DocsLayout.astro';
import CodeBlock from '../../components/marketing/CodeBlock.astro';
const base = (process.env.SITE_URL || Astro.url.origin).replace(/\/$/, '');
---
<DocsLayout title="SDK examples" active="/docs/sdk-examples">
  <div class="prose-up max-w-none"><h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">SDK examples</h1><p>Thin wrappers around the REST API. Every method takes the same parameters as the endpoint it calls.</p>
    <h2 id="python">Python</h2><CodeBlock title="pip install upload-post" code={`from upload_post import UploadPostClient\n\nclient = UploadPostClient(api_key="YOUR_API_KEY", base_url="${base}/api")\n\n# Video to three platforms\nres = client.upload_video("video.mp4", title="Hello", user="default", platforms=["tiktok", "instagram", "youtube"])\nprint(res["results"])\n\n# Photos carousel, scheduled\nclient.upload_photos(["1.jpg", "2.jpg"], title="Carousel", user="default", platforms=["instagram"], scheduled_date="2026-12-24T09:00:00", timezone="Europe/Paris")\n\n# Text post added to the queue\nclient.upload_text("Hello from Python", user="default", platforms=["x", "linkedin"], add_to_queue=True)\n\n# Analytics\nprint(client.get_analytics("default", platforms=["instagram", "tiktok"]))`} />
    <h2 id="javascript">JavaScript / TypeScript</h2><CodeBlock title="npm install upload-post" code={`import { UploadPost } from 'upload-post';\n\nconst api = new UploadPost('YOUR_API_KEY', { baseUrl: '${base}/api' });\n\nawait api.upload('./video.mp4', { user: 'default', title: 'Hello', platforms: ['tiktok', 'youtube'] });\nawait api.uploadPhotos(['./1.jpg', './2.jpg'], { user: 'default', title: 'Carousel', platforms: ['instagram'] });\nawait api.uploadText({ user: 'default', title: 'Hello world', platforms: ['x', 'threads'], addToQueue: true });\n\nconst status = await api.getStatus({ requestId: 'req_…' });\nconst profiles = await api.listUsers();\nconst link = await api.generateJwt('client-harbor', { redirectUrl: 'https://your-saas.com/done' });`} />
    <h2>Plain fetch (any language)</h2><CodeBlock title="fetch" code={`const form = new FormData();\nform.append('user', 'default');\nform.append('platform[]', 'tiktok');\nform.append('title', 'Hello');\nform.append('video', fileBlob, 'video.mp4');\nconst r = await fetch('${base}/api/upload', { method: 'POST', headers: { Authorization: 'Apikey YOUR_API_KEY' }, body: form });\nconsole.log(await r.json());`} />
    <h2>PHP</h2><CodeBlock title="php" code={`$ch = curl_init('${base}/api/upload');\ncurl_setopt_array($ch, [CURLOPT_POST => true, CURLOPT_RETURNTRANSFER => true,\n  CURLOPT_HTTPHEADER => ['Authorization: Apikey YOUR_API_KEY'],\n  CURLOPT_POSTFIELDS => ['user' => 'default', 'platform[0]' => 'tiktok', 'title' => 'Hello', 'video' => new CURLFile('video.mp4')]]);\necho curl_exec($ch);`} />
  </div>
</DocsLayout>
