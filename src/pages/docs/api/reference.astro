---
import DocsLayout from '../../../layouts/DocsLayout.astro';
import CodeBlock from '../../../components/marketing/CodeBlock.astro';
import { ENDPOINTS, TAGS, ERROR_CODES } from '../../../lib/content/api-registry';
const base = (process.env.SITE_URL || Astro.url.origin).replace(/\/$/, '');
const color: Record<string, string> = { GET: 'bg-emerald-500', POST: 'bg-brand-600', PATCH: 'bg-amber-500', DELETE: 'bg-rose-500' };
const anchor = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-');
---
<DocsLayout title="API reference" active="/docs/api/reference">
  <div class="prose-up max-w-none"><h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">API reference</h1><p>Base URL <code>{base}/api</code>. Authenticate with <code>Authorization: Apikey YOUR_API_KEY</code>. Upload endpoints accept <code>multipart/form-data</code>; the others accept JSON. Every response is JSON.</p>
    <div class="not-prose flex flex-wrap gap-2 my-4">{TAGS.map((t) => <a href={`#${anchor(t)}`} class="chip hover:text-brand-600">{t}</a>)}<a href="#errors" class="chip">Errors</a></div>
    {TAGS.map((tag) => <section id={anchor(tag)} class="mt-12"><h2 class="!mt-0">{tag}</h2>{ENDPOINTS.filter((e) => e.tag === tag).map((e) => <article class="not-prose card p-5 my-5" id={anchor(e.method + ' ' + e.path)}><div class="flex flex-wrap items-center gap-2"><span class={`rounded-md px-2 py-0.5 text-[11px] font-bold text-white ${color[e.method]}`}>{e.method}</span><code class="font-mono text-sm text-slate-900 dark:text-white">/api{e.path}</code><span class="ml-auto text-sm font-medium text-slate-500">{e.summary}</span></div><p class="mt-3 text-sm text-slate-600 dark:text-slate-300">{e.desc}</p>{e.params.length > 0 && <details class="mt-3 group"><summary class="cursor-pointer text-sm font-semibold text-brand-600">{e.params.length} parameters <i class="fa-solid fa-chevron-down text-[10px] group-open:rotate-180 transition"></i></summary><table class="mt-2 w-full text-xs"><thead class="text-left text-[10px] uppercase tracking-wider text-slate-400"><tr><th class="py-1 pr-2">Name</th><th class="py-1 pr-2">In</th><th class="py-1 pr-2">Type</th><th class="py-1">Description</th></tr></thead><tbody class="divide-y divide-slate-100 dark:divide-slate-800">{e.params.map((p) => <tr><td class="py-1.5 pr-2 font-mono whitespace-nowrap">{p.name}{p.required && <span class="text-rose-500">*</span>}</td><td class="py-1.5 pr-2 text-slate-500">{p.in}</td><td class="py-1.5 pr-2 text-slate-500">{p.type}</td><td class="py-1.5 text-slate-600 dark:text-slate-300">{p.platform && <span class="chip mr-1">{p.platform}</span>}{p.desc}{p.enum && <span class="block text-[11px] text-slate-400">one of: {p.enum.join(', ')}</span>}{p.default !== undefined && <span class="block text-[11px] text-slate-400">default: {String(p.default)}</span>}</td></tr>)}</tbody></table></details>}{e.example && <div class="mt-3"><CodeBlock title="request" code={e.example.replace(/\{BASE\}/g, base)} /></div>}<div class="mt-3"><CodeBlock title="response" code={e.response} /></div></article>)}</section>)}
    <section id="errors" class="mt-12"><h2>Error codes</h2><p>Errors return <code>{'{ "success": false, "message": "…", "error_code": "…" }'}</code> with the matching HTTP status.</p><table><thead><tr><th>error_code</th><th>Meaning</th></tr></thead><tbody>{ERROR_CODES.map(([c, d]) => <tr><td><code>{c}</code></td><td>{d}</td></tr>)}</tbody></table></section>
  </div>
</DocsLayout>
