---
import BaseLayout from '../layouts/BaseLayout.astro';
import { localePath } from '../lib/i18n';
const lang = Astro.locals.lang; const fr = lang === 'fr'; const L = (p: string) => localePath(lang, p);
---
<BaseLayout title="404" noindex>
  <section class="min-h-[60vh] flex items-center"><div class="container-x text-center"><div class="text-7xl font-extrabold gradient-text">404</div><h1 class="mt-4 text-2xl font-bold text-slate-900 dark:text-white">{fr ? 'Page introuvable' : 'Page not found'}</h1><p class="mt-2 text-slate-500">{fr ? 'Cette page n\'existe pas ou a été déplacée.' : 'This page does not exist or has moved.'}</p><div class="mt-6 flex justify-center gap-3"><a href={L('/')} class="btn-primary">{Astro.locals.t.common.home}</a><a href="/docs/" class="btn-secondary">{Astro.locals.t.common.apiDocs}</a></div></div></section>
</BaseLayout>
