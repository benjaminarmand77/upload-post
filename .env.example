# Open mode (default): no login wall, no quotas, all features. Set to 0 to enforce plans, magic-link login and limits like the SaaS.
OPEN_MODE=1
# Account used by open mode
OWNER_EMAIL=owner@local

# ---- Core ----
SITE_URL=http://127.0.0.1:4321
APP_SECRET=change-me-to-a-long-random-string
DATA_DIR=./data

# ---- Email (magic links). Leave empty to show the link on screen (dev mode) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Upload-Post <no-reply@example.com>"
# Address that receives the caption of each TikTok draft (TikTok drafts drop the text)
NOTIFY_EMAIL=
# Telegram bot (from @BotFather) + your chat id: receives the caption of each TikTok draft
TELEGRAM_NOTIFY_BOT_TOKEN=
TELEGRAM_NOTIFY_CHAT_ID=

# ---- Google sign-in (optional) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Platform OAuth apps (optional: without them the platform runs in sandbox mode) ----
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
THREADS_APP_ID=
THREADS_APP_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
GOOGLE_BUSINESS_CLIENT_ID=
GOOGLE_BUSINESS_CLIENT_SECRET=

# ---- AI features (optional) ----
ANTHROPIC_API_KEY=
